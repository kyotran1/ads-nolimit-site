---
import '@fontsource/be-vietnam-pro/400.css';
import '@fontsource/be-vietnam-pro/600.css';
import '@fontsource/be-vietnam-pro/700.css';
import '@fontsource/be-vietnam-pro/800.css';
import '../styles/global.css';
import '../styles/fx.css';

import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileContactBar from '../components/MobileContactBar.astro';
import Analytics from '../components/Analytics.astro';
import PwaHead from '../components/PwaHead.astro';
import TroLyAi from '../components/TroLyAi.astro';
import { langFromPath, t } from '../config/i18n';
import type { Lang } from '../config/i18n';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Mặc định suy ra từ đường dẫn: /en/… là tiếng Anh, còn lại tiếng Việt */
  lang?: Lang;
  publishedTime?: string;
}

const { lang = langFromPath(Astro.url.pathname), ...seo } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#070a1a" />
    <script is:inline>
      // Giao diện sáng/tối: chạy trong <head>, trước khi trang vẽ, để không bị nháy màu. Mặc định tối; lỗi → tối.
      try {
        if (localStorage.getItem('adsnl-theme') === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
          document.querySelector('meta[name="theme-color"]').setAttribute('content', '#f6f7fb');
        }
      } catch (e) {}
    </script>
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <PwaHead lang={lang} />
    <Seo lang={lang} {...seo} />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#noi-dung">{t(lang).skip}</a>
    <Header lang={lang} />
    <main id="noi-dung">
      <slot />
    </main>
    <Footer lang={lang} />
    <MobileContactBar lang={lang} />
    <TroLyAi lang={lang} />

    <script is:inline>
      // Hiện dần các khối khi cuộn tới. Không JS hoặc giảm chuyển động: mọi thứ hiện ngay.
      (function () {
        if (!('IntersectionObserver' in window)) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var els = document.querySelectorAll('main .section > .container > *, main [data-reveal]');
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (!e.isIntersecting) return;
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        var vh = window.innerHeight;
        els.forEach(function (el) {
          if (el.getBoundingClientRect().top < vh) return; // đã trong màn hình: không ẩn
          el.setAttribute('data-r', '');
          io.observe(el);
        });
      })();
    </script>
    <script>
      // Ánh sáng theo chuột cho [data-glow] (xem src/styles/fx.css)
      import '../scripts/glow';
    </script>
  </body>
</html>
