---
/** Trang Liên hệ (/lien-he/ và /en/contact/). */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/Icon.astro';
import { channels, contact, links } from '../config/site';
import { localize, t } from '../config/i18n';
import type { Lang } from '../config/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const labels = t(lang).contactLabels;
const privacy = localize('/chinh-sach-bao-mat/', lang);

const iconFor: Record<string, IconName> = {
  zalo: 'zalo',
  hotline: 'phone',
  phone: 'phone',
  assistant: 'phone',
  messenger: 'messenger',
  telegram: 'telegram',
  email: 'mail',
  fanpage: 'facebook',
};

// Thứ tự kênh: tiếng Việt ưu tiên Zalo; tiếng Anh ưu tiên Telegram và email.
const order: Record<Lang, string[]> = {
  vi: ['zalo', 'hotline', 'phone', 'assistant', 'messenger', 'telegram', 'email', 'fanpage'],
  en: ['telegram', 'email', 'zalo', 'messenger', 'hotline', 'phone', 'assistant', 'fanpage'],
};
const main: Record<Lang, string[]> = { vi: ['zalo'], en: ['telegram', 'email'] };
const list = order[lang].map((id) => channels.find((c) => c.id === id)!).filter(Boolean);

const copy = {
  vi: {
    title: 'Liên hệ tư vấn miễn phí | ADS-Nolimit',
    description: `Liên hệ ADS-Nolimit: Zalo ${contact.zaloPhone}, hotline ${contact.hotline}, Messenger, Telegram @${contact.telegramUser}, email ${contact.email}. Tư vấn miễn phí.`,
    h1: 'Liên hệ ADS-Nolimit',
    lead: 'Tư vấn miễn phí. Nhắn Zalo là nhanh nhất, hoặc chọn kênh bạn quen dùng.',
    channelsTitle: 'Các kênh liên hệ',
    formTitle: 'Hoặc để lại lời nhắn',
    formLead: 'Điền vài dòng, rồi chọn gửi qua email hoặc Zalo. ADS-Nolimit sẽ liên hệ lại để tư vấn.',
    formNote: `Website không lưu thông tin trong form. Nội dung được chuyển sang ứng dụng email hoặc Zalo của bạn, và chỉ đến ADS-Nolimit khi bạn bấm gửi trong ứng dụng đó. Thông tin chỉ dùng để liên hệ tư vấn. Xem <a href="${privacy}">chính sách bảo mật</a>.`,
    name: 'Họ tên',
    phone: 'Số điện thoại / Zalo',
    email: 'Email',
    optional: '(không bắt buộc)',
    need: 'Bạn quan tâm',
    message: 'Lời nhắn',
    placeholder: 'Ví dụ: shop mỹ phẩm, khách nhắn nhiều qua fanpage buổi tối…',
    sendEmail: 'Gửi qua email',
    sendChat: { label: 'Gửi qua Zalo', href: links.zalo, icon: 'zalo' as IconName },
    needs: [
      'AI Agent bán hàng & chăm sóc khách',
      'Tự động hóa quy trình',
      'Quảng cáo hiệu suất',
      'Tài khoản quảng cáo Agency doanh nghiệp',
      'Website & phần mềm bán hàng',
      'Đào tạo AI cho chủ shop',
      'ADS-NOLIMIT AI Office',
      'Khác',
    ],
    strings: {
      greeting: 'Chào ADS-Nolimit, tôi cần tư vấn.',
      name: 'Họ tên',
      phone: 'Số điện thoại / Zalo',
      email: 'Email',
      need: 'Quan tâm',
      subject: 'Tư vấn',
      opening: 'Đang mở ứng dụng email của bạn. Bấm Gửi trong ứng dụng email để hoàn tất.',
      copied: 'Đã sao chép lời nhắn. Dán vào khung chat Zalo vừa mở rồi bấm gửi.',
      notCopied: 'Zalo đã mở trong tab mới. Bạn nhắn trực tiếp nội dung cần tư vấn nhé.',
    },
  },
  en: {
    title: 'Contact ADS-Nolimit | Free consultation',
    description: `Contact ADS-Nolimit: Telegram @${contact.telegramUser}, email ${contact.email}, Zalo ${contact.zaloPhone}, hotline ${contact.hotline}, Messenger. Free consultation.`,
    h1: 'Contact ADS-Nolimit',
    lead: 'Free consultation. Telegram and email work well from anywhere; in Vietnam, Zalo is the fastest way to reach us.',
    channelsTitle: 'Ways to reach us',
    formTitle: 'Or leave a message',
    formLead: 'Fill in a few lines, then choose to send it by email or Telegram. ADS-Nolimit will get back to you.',
    formNote: `This website does not store anything you type into the form. Your message is passed to your own email or chat app and only reaches ADS-Nolimit when you press send there. We use it only to get back to you. See our <a href="${privacy}">privacy policy</a>.`,
    name: 'Name',
    phone: 'Phone, Zalo or Telegram',
    email: 'Email',
    optional: '(optional)',
    need: 'What are you interested in?',
    message: 'Message',
    placeholder: 'For example: cosmetics shop, lots of evening messages on our Facebook page…',
    sendEmail: 'Send by email',
    sendChat: { label: 'Send via Telegram', href: links.telegram, icon: 'telegram' as IconName },
    needs: [
      'AI agents for sales & customer care',
      'Workflow automation',
      'Performance advertising',
      'Agency business ad account',
      'Websites & sales software',
      'AI training for shop owners',
      'ADS-NOLIMIT AI Office',
      'Other',
    ],
    strings: {
      greeting: 'Hello ADS-Nolimit, I would like a consultation.',
      name: 'Name',
      phone: 'Phone / Zalo / Telegram',
      email: 'Email',
      need: 'Interested in',
      subject: 'Consultation',
      opening: 'Opening your email app. Press Send there to finish.',
      copied: 'Message copied. Paste it into the Telegram chat that just opened and press send.',
      notCopied: 'Telegram opened in a new tab. Please type your request there.',
    },
  },
}[lang];
---

<BaseLayout title={copy.title} description={copy.description} lang={lang}>
  <PageHero title={copy.h1} lead={copy.lead} />

  <section class="section" aria-labelledby="channels-title">
    <div class="container">
      <h2 id="channels-title" class="visually-hidden">{copy.channelsTitle}</h2>
      <ul class="channels">
        {
          list.map((c) => (
            <li>
              <a
                class:list={['channel', { 'channel--main': main[lang].includes(c.id) }]}
                href={c.href}
                rel={c.external ? 'noopener' : undefined}
                data-glow
              >
                <span class="icon-tile tone-green">
                  <Icon name={iconFor[c.id] ?? 'chat'} />
                </span>
                <span class="channel-body">
                  <span class="channel-label">{labels[c.id as keyof typeof labels]}</span>
                  <strong class="channel-value">{c.value}</strong>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--raise" aria-labelledby="form-title">
    <div class="container split">
      <div>
        <h2 id="form-title">{copy.formTitle}</h2>
        <p class="lead form-lead">{copy.formLead}</p>
        <p class="note" set:html={copy.formNote} />
      </div>

      <!--
        TODO: Site tĩnh chưa có backend. Form hiện chỉ soạn nội dung rồi mở mailto: hoặc Zalo/Telegram.
        Khi có dịch vụ nhận form (ví dụ Formspree, Google Forms, backend riêng), thay `action`
        và phần script bên dưới, đồng thời cập nhật trang chính sách bảo mật (cả hai ngôn ngữ).
      -->
      <form
        class="contact-form panel"
        id="contact-form"
        action={links.email}
        method="post"
        enctype="text/plain"
        data-email={contact.email}
        data-chat={copy.sendChat.href}
        data-strings={JSON.stringify(copy.strings)}
      >
        <div class="field">
          <label for="f-name">{copy.name}</label>
          <input id="f-name" name="ho_ten" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="f-phone">{copy.phone}</label>
          <input id="f-phone" name="dien_thoai" type="tel" autocomplete="tel" inputmode="tel" required />
        </div>
        <div class="field">
          <label for="f-email">{copy.email} <span class="optional">{copy.optional}</span></label>
          <input id="f-email" name="email" type="email" autocomplete="email" />
        </div>
        <div class="field">
          <label for="f-need">{copy.need}</label>
          <select id="f-need" name="nhu_cau">
            {copy.needs.map((n) => <option>{n}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="f-msg">{copy.message}</label>
          <textarea id="f-msg" name="loi_nhan" rows="4" placeholder={copy.placeholder}></textarea>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary" data-send="email"><Icon name="mail" /> {copy.sendEmail}</button>
          <button type="button" class="btn btn-secondary" data-send="chat"
            ><Icon name={copy.sendChat.icon} /> {copy.sendChat.label}</button
          >
        </div>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  // Soạn nội dung từ form rồi mở email (mailto:) hoặc Zalo/Telegram. Không gửi dữ liệu đến máy chủ nào.
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  if (form) {
    const s = JSON.parse(form.dataset.strings ?? '{}') as Record<string, string>;
    const status = form.querySelector<HTMLParagraphElement>('.form-status');
    const say = (text: string) => {
      if (status) status.textContent = text;
    };
    const compose = () => {
      const data = new FormData(form);
      const get = (key: string) => String(data.get(key) ?? '').trim();
      const lines = [s.greeting, '', `${s.name}: ${get('ho_ten')}`, `${s.phone}: ${get('dien_thoai')}`];
      if (get('email')) lines.push(`${s.email}: ${get('email')}`);
      lines.push(`${s.need}: ${get('nhu_cau')}`);
      if (get('loi_nhan')) lines.push('', get('loi_nhan'));
      return { subject: `${s.subject}: ${get('nhu_cau')} - ${get('ho_ten')}`, body: lines.join('\r\n') };
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const { subject, body } = compose();
      const email = form.dataset.email ?? '';
      window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      say(s.opening);
    });

    form.querySelector('[data-send="chat"]')?.addEventListener('click', async () => {
      if (!form.reportValidity()) return;
      const { body } = compose();
      let copied = false;
      try {
        await navigator.clipboard.writeText(body);
        copied = true;
      } catch {
        copied = false;
      }
      window.open(form.dataset.chat, '_blank', 'noopener');
      say(copied ? s.copied : s.notCopied);
    });
  }
</script>

<style>
  .channels {
    list-style: none;
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .channels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .channels {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  .channel {
    display: flex;
    gap: 0.9rem;
    align-items: center;
    height: 100%;
    padding: 1rem 1.1rem;
    border-radius: var(--r-md);
    border: 1px solid var(--line);
    background: var(--card-bg);
    color: var(--text);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }
  .channel:hover {
    border-color: var(--line-strong);
    transform: translateY(-2px);
  }
  .channel:hover .channel-value {
    text-decoration: underline;
    text-decoration-color: var(--green);
  }

  .channel--main {
    border-color: rgb(0 216 120 / 0.55);
    background:
      linear-gradient(100deg, rgb(0 216 120 / 0.1), transparent 75%),
      var(--surface);
  }
  .channel--main:hover {
    border-color: var(--green);
  }

  .channel-body {
    display: grid;
    min-width: 0;
  }
  .channel-label {
    font-size: 0.8125rem;
    color: var(--text-3);
  }
  .channel-value {
    overflow-wrap: anywhere;
    font-size: 0.96875rem;
  }

  .form-lead {
    margin: 1.25rem 0 1rem;
  }

  .contact-form {
    display: grid;
    gap: 1.1rem;
  }

  .field {
    display: grid;
    gap: 0.4rem;
  }

  .field label {
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .optional {
    font-weight: 400;
    color: var(--text-3);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 48px;
    padding: 0.7rem 0.9rem;
    border-radius: var(--r-sm);
    border: 1px solid var(--line-strong);
    background: rgb(7 10 26 / 0.8);
    color: var(--text);
    font: inherit;
    font-size: 1rem;
    transition: border-color 0.15s ease;
  }
  .field input:hover,
  .field select:hover,
  .field textarea:hover {
    border-color: var(--text-3);
  }
  .field textarea {
    resize: vertical;
  }
  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    outline: 3px solid var(--sun);
    outline-offset: 1px;
    border-color: var(--sun);
  }
  .field ::placeholder {
    color: var(--text-3);
  }

  .form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }
  @media (max-width: 479.98px) {
    .form-actions .btn {
      flex: 1 1 100%;
    }
  }

  .form-status {
    min-height: 1.5em;
    font-size: 0.9375rem;
    color: var(--green-ink);
  }
</style>
