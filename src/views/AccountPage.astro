---
/**
 * Trang Tài khoản V4 (/tai-khoan/ và /en/account/): bảng điều khiển của khách, một trang,
 * chuyển mục bằng #neo (xem src/lib/account/routes.ts):
 *   Tổng quan · Nạp tiền & Số dư · Đơn hàng · Dịch vụ · Khóa học · Hướng dẫn sử dụng · Key & máy · Hồ sơ · Bảo mật
 *
 * Chỉ xem được khi đã đăng nhập (chưa đăng nhập → trang Đăng nhập, ?next= quay lại đây). noindex, không có trong sitemap.
 * Xử lý trên trình duyệt: src/lib/account/main.ts. Dữ liệu & luật bảo mật: firestore.rules ở thư mục gốc.
 * Link chọn sẵn dịch vụ: /tai-khoan/?plan=<id gói trong src/data/pricing.ts>#dich-vu
 */
import '../styles/auth.css';
import '../styles/dashboard.css';
import '../styles/reports.css';
import { Image } from 'astro:assets';
import logoMark from '../assets/brand/logo-mark.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthConfig from '../components/auth/AuthConfig.astro';
import Icon from '../components/Icon.astro';
import Field from '../components/auth/Field.astro';
import Overview from '../components/account/Overview.astro';
import TopUp from '../components/account/TopUp.astro';
import Orders from '../components/account/Orders.astro';
import AdReports from '../components/account/AdReports.astro';
import Notify from '../components/account/Notify.astro';
import Services from '../components/account/Services.astro';
import Courses from '../components/account/Courses.astro';
import Guides from '../components/account/Guides.astro';
import Keys from '../components/account/Keys.astro';
import Profile from '../components/account/Profile.astro';
import Security from '../components/account/Security.astro';
import { contact, links, primaryChannel } from '../config/site';
import { homeOf, localize } from '../config/i18n';
import type { Lang } from '../config/i18n';
import { navGroups, sections } from '../lib/account/routes';
import { pickerGroups } from '../data/catalog';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const copy = {
  vi: {
    title: 'Tài khoản của bạn | ADS-Nolimit',
    description: 'Số dư, đơn hàng, dịch vụ, khóa học và key phần mềm của bạn tại ADS-Nolimit.',
    loading: 'Đang tải tài khoản…',
    noscript: 'Trang tài khoản cần bật JavaScript.',
    nav: 'Mục tài khoản',
    crumb: 'Tài khoản ADS-Nolimit',
    home: 'Trang chủ',
    refresh: 'Làm mới',
    getApp: 'Tải app',
    getAppHint: 'Tải app ADS-Nolimit về điện thoại',
    refreshHint: 'Tải lại số dư, lệnh nạp và báo cáo',
    balance: 'Số dư',
    support: 'Hỗ trợ qua Zalo',
    supportValue: contact.zaloPhone,
    signOut: 'Đăng xuất',
    soon: 'Sắp ra mắt',
    locked: 'Chưa mở khóa',
    deletedTitle: 'Đã xóa tài khoản',
    deletedText:
      'Tài khoản và hồ sơ của bạn đã được xóa. Cảm ơn bạn đã dùng thử. Nếu cần ADS-Nolimit hỗ trợ, bạn vẫn có thể liên hệ qua Zalo, hotline hoặc email.',
    deletedHome: 'Về trang chủ',
    gapAddTitle: 'Thêm email để nhận thông báo và được cấp quyền xem báo cáo',
    gapAddText: 'Facebook của bạn không chia sẻ email. Bạn nhập email, chúng tôi gửi thư xác minh; bấm link trong thư là email được thêm vào tài khoản. Bạn vẫn xem các mục khác bình thường.',
    gapVerifyTitle: 'Xác minh email để được cấp quyền xem báo cáo',
    gapVerifyText: 'Email Facebook của bạn chưa được xác minh. Bạn bấm “Gửi email xác minh”, mở thư và bấm link; xong bạn bấm “Tôi đã xác minh”.',
    gapEmail: 'Email của bạn',
    gapSendAdd: 'Gửi email xác minh',
    gapSendVerify: 'Gửi email xác minh',
    gapDone: 'Tôi đã xác minh',
  },
  en: {
    title: 'Your account | ADS-Nolimit',
    description: 'Your ADS-Nolimit balance, orders, services, courses and software keys.',
    loading: 'Loading your account…',
    noscript: 'The account page needs JavaScript.',
    nav: 'Account sections',
    crumb: 'ADS-Nolimit account',
    home: 'Home',
    refresh: 'Refresh',
    getApp: 'Get app',
    getAppHint: 'Get the ADS-Nolimit app on your phone',
    refreshHint: 'Reload balance, top-ups and reports',
    balance: 'Balance',
    support: 'Support on Telegram',
    supportValue: `@${contact.telegramUser}`,
    signOut: 'Sign out',
    soon: 'Soon',
    locked: 'Locked',
    deletedTitle: 'Account deleted',
    deletedText:
      'Your account and profile have been deleted. Thank you for trying ADS-Nolimit. If you need us, you can still reach us by Telegram, Zalo or email.',
    deletedHome: 'Back to the homepage',
    gapAddTitle: 'Add an email to get notifications and report access',
    gapAddText: 'Your Facebook account did not share an email. Enter one and we send a verification email; click the link in it and the email is added to your account. You can keep using the other sections meanwhile.',
    gapVerifyTitle: 'Verify your email to get report access',
    gapVerifyText: 'Your Facebook email is not verified yet. Press “Send verification email”, open it and click the link, then press “I have verified”.',
    gapEmail: 'Your email',
    gapSendAdd: 'Send verification email',
    gapSendVerify: 'Send verification email',
    gapDone: 'I have verified',
  },
}[lang];

const byId = (id: string) => sections.find((s) => s.id === id)!;
const supportHref = lang === 'en' ? links.telegram : links.zalo;

// Cấu hình cho script: ô chọn dịch vụ (đã chuyển ngữ, giá từ src/data/pricing.ts), liên hệ, đường dẫn.
const config = {
  lang,
  picker: pickerGroups(lang),
  contact: { zalo: contact.zaloPhone, telegram: `@${contact.telegramUser}`, email: contact.email },
  links: { zalo: links.zalo, telegram: links.telegram, primary: primaryChannel[lang].href },
  paths: {
    terms: localize('/dieu-khoan/', lang),
    pricing: localize('/bang-gia/', lang),
    software: localize('/phan-mem/', lang),
  },
};
const configJson = JSON.stringify(config).replace(/</g, '\\u003c');
---

<BaseLayout title={copy.title} description={copy.description} lang={lang} noindex>
  <section class="dash" id="dash">
    <div class="acc-loading" id="acc-loading" role="status">
      <span class="spinner" aria-hidden="true"></span>
      <span>{copy.loading}</span>
    </div>
    <noscript><p class="auth-noscript">{copy.noscript}</p></noscript>

    <div class="dash-shell" id="acc-app" hidden>
      <!-- Menu bên trái (màn hình rộng) / thanh mục cuộn ngang (điện thoại) -->
      <aside class="dash-side">
        <div class="side-user">
          <div class="avatar" id="acc-avatar" aria-hidden="true"></div>
          <div class="side-user-text">
            <p class="side-name" id="side-name"></p>
            <p class="side-email" id="side-email"></p>
          </div>
        </div>
        <a class="side-balance" href={`#${byId('topup')[lang]}`} data-glow>
          <span class="side-balance-label"><Icon name="wallet" />{copy.balance}</span>
          <strong data-bind="balance">—</strong>
        </a>
        <nav class="side-nav" aria-label={copy.nav}>
          {
            navGroups.map((group) => (
              <div class="side-group">
                <p class="side-group-label">{group.label[lang]}</p>
                <ul>
                  {group.ids.map((id) => {
                    const s = byId(id);
                    return (
                      <li>
                        <a class="side-link" href={`#${s[lang]}`} data-route={s.id}>
                          <Icon name={s.icon} />
                          <span class="side-link-text">{s.label[lang]}</span>
                          {s.id === 'keys' && <span class="side-soon">{copy.soon}</span>}
                          {(s.id === 'ads' || s.id === 'courses' || s.id === 'keys' || s.id === 'guides') && (
                            <span class="side-lock" data-lock={s.id} title={copy.locked} hidden>
                              <Icon name="lock" />
                            </span>
                          )}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))
          }
        </nav>
        <div class="side-foot">
          <a class="side-support" href={supportHref} rel="noopener" target="_blank">
            <Icon name="support" />
            <span><small>{copy.support}</small>{copy.supportValue}</span>
          </a>
          <button type="button" class="side-signout" data-signout>
            <Icon name="logout" />
            <span>{copy.signOut}</span>
          </button>
        </div>
      </aside>

      <div class="dash-main">
        <header class="dash-top">
          <div class="dash-top-text">
            <p class="dash-crumb">
              <Image src={logoMark} alt="" width={22} densities={[1, 2]} loading="eager" />
              <span>{copy.crumb}</span>
            </p>
            <h1 id="dash-title" tabindex="-1">{byId('overview').label[lang]}</h1>
          </div>
          <div class="dash-top-actions">
            <button type="button" class="btn btn-sm btn-primary dash-app install-entry" data-install-app title={copy.getAppHint} aria-label={copy.getAppHint}>
              <Icon name="download" /><span>{copy.getApp}</span>
            </button>
            <button type="button" class="btn btn-sm dash-refresh" id="acc-refresh" title={copy.refreshHint}><span>{copy.refresh}</span></button>
            <a class="btn btn-sm dash-home" href={homeOf[lang]} title={copy.home}><Icon name="home" /><span>{copy.home}</span></a>
          </div>
        </header>

        <div id="acc-notice" class="auth-alert acc-notice" role="status"></div>

        <!-- Khách Facebook: chưa có email → thêm email; có email chưa xác minh → nhắc xác minh. Không chặn xem các mục. -->
        <section class="panel mailgap" id="mailgap" aria-labelledby="mailgap-title-add" hidden>
          <h2 id="mailgap-title-add" data-mode-add hidden>{copy.gapAddTitle}</h2>
          <h2 id="mailgap-title-verify" data-mode-verify hidden>{copy.gapVerifyTitle}</h2>
          <p class="mailgap-text" data-mode-add hidden>{copy.gapAddText}</p>
          <p class="mailgap-text" data-mode-verify hidden>{copy.gapVerifyText}</p>
          <form id="mailgap-form" class="mailgap-form" novalidate data-mode-add hidden>
            <Field id="mailgap-email" name="email" type="email" label={copy.gapEmail} autocomplete="email" inputmode="email" />
            <button type="submit" class="btn btn-primary">{copy.gapSendAdd}</button>
          </form>
          <div class="mailgap-verify" data-mode-verify hidden>
            <button type="button" class="btn btn-primary" id="mailgap-send">{copy.gapSendVerify}</button>
          </div>
          <div class="mailgap-verify" id="mailgap-done-row" hidden>
            <button type="button" class="btn" id="mailgap-done">{copy.gapDone}</button>
          </div>
          <div id="mailgap-alert" class="auth-alert" role="alert"></div>
          <div id="mailgap-status" class="auth-alert" role="status"></div>
        </section>

        <Overview lang={lang} />
        <TopUp lang={lang} />
        <Orders lang={lang} />
        <AdReports lang={lang} />
        <Notify lang={lang} />
        <Services lang={lang} />
        <Courses lang={lang} />
        <Guides lang={lang} />
        <Keys lang={lang} />
        <Profile lang={lang} />
        <Security lang={lang} />
      </div>
    </div>

    <div class="acc-deleted" id="acc-deleted" hidden tabindex="-1">
      <h1>{copy.deletedTitle}</h1>
      <p>{copy.deletedText}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={homeOf[lang]}>{copy.deletedHome}</a>
      </div>
    </div>
  </section>
  <script is:inline type="application/json" id="dash-config" set:html={configJson} />
  <AuthConfig lang={lang} />
</BaseLayout>

<script>
  import '../lib/account/main';
</script>
