---
/** Trang Dự án & case study (/du-an/ và /en/projects/). */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ReportBotCase from '../components/ReportBotCase.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { primaryChannel } from '../config/site';
import { localize } from '../config/i18n';
import type { Lang } from '../config/i18n';
import { getPilotOffer } from '../data/pricing';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const pilot = getPilotOffer(lang);
const primary = primaryChannel[lang];
const slots = [1, 2, 3];

const copy = {
  vi: {
    title: 'Dự án & case study | ADS-Nolimit',
    description:
      'Case study nội bộ của ADS-Nolimit: bot Telegram tự nhập báo cáo quảng cáo Meta vào bảng tính mỗi ngày. Đang nhận 3 khách thí điểm AI Agent.',
    h1: 'Dự án & case study',
    lead: 'ADS-Nolimit đã phục vụ hơn 800 khách hàng quảng cáo từ 2016. Với mảng AI, chúng tôi bắt đầu từ chính mình: dưới đây là case study nội bộ, và chỗ dành cho những khách thí điểm đầu tiên.',
    caseLabel: 'Case study nội bộ',
    pilotTitle: 'Case study AI Agent thí điểm',
    pilotLead:
      'Case study với khách hàng thật sẽ được đăng ở đây khi dự án chạy đủ lâu và khách đồng ý công bố. Chúng tôi không đăng số liệu hay lời nhận xét chưa được khách cho phép.',
    slot: 'Vị trí thí điểm',
    open: 'Đang mở',
    apply: 'Đăng ký thí điểm qua Zalo',
    plans: 'Xem gói AI Agent',
  },
  en: {
    title: 'Projects & case studies | ADS-Nolimit',
    description:
      'ADS-Nolimit’s internal case study: a Telegram bot that enters our Meta ad report into a spreadsheet every day. Now taking 3 pilot AI agent clients.',
    h1: 'Projects & case studies',
    lead: 'ADS-Nolimit has served more than 800 advertising clients since 2016. With AI, we started with our own work: below is our internal case study, and room for our first pilot clients.',
    caseLabel: 'Internal case study',
    pilotTitle: 'Pilot AI agent case studies',
    pilotLead:
      'Case studies with real clients will appear here once projects have run long enough and the clients agree to publish them. We never publish numbers or testimonials without a client’s permission.',
    slot: 'Pilot slot',
    open: 'Open',
    apply: 'Apply for the pilot on Telegram',
    plans: 'See AI agent plans',
  },
}[lang];
---

<BaseLayout title={copy.title} description={copy.description} lang={lang}>
  <PageHero title={copy.h1} lead={copy.lead} />

  <section class="section" aria-label={copy.caseLabel}>
    <div class="container">
      <ReportBotCase lang={lang} detailed />
    </div>
  </section>

  <section class="section section--raise" aria-labelledby="pilot-title">
    <div class="container">
      <div class="section-head">
        <h2 id="pilot-title">{copy.pilotTitle}</h2>
        <p>{copy.pilotLead}</p>
      </div>
      <ol class="slots">
        {
          slots.map((n) => (
            <li class="slot">
              <span class="slot-num">
                {copy.slot} {n}
              </span>
              <span class="slot-state">{copy.open}</span>
            </li>
          ))
        }
      </ol>
      {
        pilot.active && (
          <p class="pilot">
            <span>
              <strong>{pilot.title}:</strong> {pilot.text}
            </span>
          </p>
        )
      }
      <div class="btn-row btn-row--stack-mobile slot-actions">
        <a class="btn btn-primary" href={primary.href} rel="noopener"><Icon name={primary.icon} /> {copy.apply}</a>
        <a class="btn btn-secondary" href={localize('/giai-phap-ai-agent/', lang)}>{copy.plans}</a>
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>

<style>
  .slots {
    list-style: none;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .slots {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  .slot {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5rem;
    min-height: 9rem;
    padding: 1.35rem 1.5rem;
    border-radius: var(--r-lg);
    border: 1px dashed var(--line-strong);
    background:
      repeating-linear-gradient(135deg, rgb(255 255 255 / 0.018) 0 12px, transparent 12px 24px),
      rgb(var(--scrim) / 0.5);
  }

  .slot-num {
    font-weight: 700;
    font-size: var(--step-1);
  }

  .slot-state {
    align-self: flex-start;
    padding: 0.1rem 0.7rem;
    border-radius: 999px;
    border: 1px solid rgb(0 216 120 / 0.45);
    background: rgb(0 216 120 / 0.07);
    color: var(--green-ink);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .slot-actions {
    margin-top: 1.75rem;
  }
</style>
