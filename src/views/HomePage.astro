        text: `Website, landing page, phần mềm hỗ trợ bán hàng trên mạng xã hội. ${web.prices[0].value}.`,
        href: L('/thiet-ke-website/'),
      },
      {
        icon: 'school' as IconName,
        title: training.name,
        text: `Workshop 1 buổi kèm bộ mẫu câu lệnh. ${priceInline(training, lang)}.`,
        href: L('/bang-gia/#training'),
      },
    ],
    details: 'Xem chi tiết',
    demoTitle: 'Một tin nhắn lúc 22:41 được xử lý thế nào',
    demoLead:
      'Cuộc trò chuyện mẫu cho một spa. AI Agent trả lời theo bảng giá spa cung cấp, xin số điện thoại, lưu khách và báo lễ tân. Việc cần người thật, như xác nhận lịch, vẫn do người thật làm.',
    demoPoints: [
      'Trả lời đúng giá, đúng giọng của cửa hàng',
      'Khách được lưu vào Google Sheet, không thất lạc trong hộp thư',
      'Lễ tân nhận thông báo qua Zalo, sáng mai gọi lại',
    ],
    demoCta: 'Xem AI Agent làm được gì',
    agentName: 'Trợ lý AI của Spa Mẫu',
