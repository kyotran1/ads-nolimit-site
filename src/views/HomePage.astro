---
/**
 * Trang chủ (dùng chung cho / và /en/). Chữ của từng ngôn ngữ nằm trong `copy` bên dưới;
 * giá lấy từ src/data/pricing.ts, liên hệ từ src/config/site.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroLoop from '../components/HeroLoop.astro';
import ChatDemo from '../components/ChatDemo.astro';
import System3D from '../components/System3D.astro';
import type { ChatMessage } from '../components/ChatDemo.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ReportBotCase from '../components/ReportBotCase.astro';
import AiOfficeTeaser from '../components/AiOfficeTeaser.astro';
import PricingSummary from '../components/PricingSummary.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import PartnerStrip from '../components/PartnerStrip.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/Icon.astro';
import { site, links } from '../config/site';
import { localize } from '../config/i18n';
import type { Lang } from '../config/i18n';
import { getPlan, priceInline } from '../data/pricing';
import { getFaq } from '../data/faq';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const L = (href: string) => localize(href, lang);

const ads = getPlan('ads', lang);
const starter = getPlan('ai-starter', lang);
const automation = getPlan('automation', lang);
const training = getPlan('training', lang);
const web = getPlan('web', lang);

interface Solution {
  tone: string;
  icon: IconName;
  title: string;
  text: string;
  points: string[];
  price: string;
  href: string;
}

const copy = {
  vi: {
    title: 'ADS-Nolimit | Quảng cáo & AI Agent cho doanh nghiệp',
    description: site.defaultDescription,
    h1: 'Nhân viên AI làm việc 24/7. Quảng cáo được tối ưu mỗi ngày.',
    lead: 'ADS-Nolimit dựng AI Agent trả lời khách, tự động hóa việc lặp lại và chạy quảng cáo Facebook, Google, TikTok, để shop và doanh nghiệp nhỏ làm được nhiều việc hơn với ít người hơn.',
    primary: { label: 'Tư vấn miễn phí qua Zalo', href: links.zalo, icon: 'zalo' as IconName },
    secondary: 'Xem giải pháp AI Agent',
    stats: [
      { value: 'Từ 2016', label: '10 năm làm quảng cáo' },
      { value: '800+', label: 'khách hàng đã phục vụ' },
      { value: 'Facebook · Google · TikTok', label: 'quảng cáo đa kênh', wide: true },
    ],
    trustLabel: 'Kinh nghiệm và đối tác',
    painsTitle: 'Ba chỗ đang làm shop mất khách và mất thời gian',
    pains: [
      {
        cue: '22:30',
        tone: 'violet',
        title: 'Khách nhắn hỏi giá, sáng hôm sau mới có người trả lời',
        text: 'Ban đêm, cuối tuần, giờ cao điểm: tin nhắn chờ lâu thì khách đi hỏi shop khác.',
      },
      {
        cue: 'Mỗi sáng',
        tone: 'teal',
        title: 'Một người ngồi chép số liệu sang bảng tính',
        text: 'Báo cáo quảng cáo, đơn hàng, lịch hẹn làm bằng tay: mất thời gian, dễ sai, và chẳng còn sức để đọc số.',
      },
      {
        cue: 'Cuối tháng',
        tone: 'green',
        title: 'Chi phí quảng cáo tăng mà không biết cắt ở đâu',
        text: 'Ngân sách rải cho nhiều chiến dịch, không rõ nhóm nào mang khách về, nhóm nào chỉ tốn tiền.',
      },
    ],
    solutionsTitle: 'ADS-Nolimit làm gì cho bạn',
    solutionsLead: 'Ba mảng chính, có thể làm riêng hoặc ghép lại. Thêm hai dịch vụ hỗ trợ cho shop muốn tự chủ hơn.',
    solutions: [
      {
        tone: 'violet',
        icon: 'chat',
        title: 'AI Agent bán hàng & chăm sóc khách',
        text: 'Trả lời tin nhắn trên Messenger, Zalo OA hoặc website theo tài liệu của chính bạn, kể cả lúc nửa đêm.',
        points: ['Trả lời câu hỏi thường gặp', 'Xin số điện thoại, lưu khách vào Google Sheet', 'Báo khách mới qua Telegram/Zalo'],
        price: `${starter.name}: ${priceInline(starter, lang)}`,
        href: L('/giai-phap-ai-agent/'),
      },
      {
        tone: 'blue',
        icon: 'chart',
        title: 'Quảng cáo hiệu suất',
        text: 'Chạy và tối ưu Facebook Ads, Google Ads, TikTok Ads mỗi ngày, báo cáo rõ tiền đã chi vào đâu.',
        points: ['Tối ưu hằng ngày', 'Báo cáo minh bạch', 'Tài khoản quảng cáo Agency doanh nghiệp (BM2500)'],
        price: priceInline(ads, lang),
        href: L('/quang-cao/'),
      },
      {
        tone: 'green',
        icon: 'bolt',
        title: 'Tự động hóa quy trình',
        text: 'Biến việc lặp lại hằng ngày thành quy trình tự chạy, kết nối các phần mềm bạn đang dùng.',
        points: ['Báo cáo quảng cáo tự động mỗi sáng', 'Đồng bộ đơn hàng', 'Soạn nội dung hàng loạt, nhắc lịch khách'],
        price: priceInline(automation, lang),
        href: L('/tu-dong-hoa/'),
      },
