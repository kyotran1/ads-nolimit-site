      { from: 'customer', text: 'Gói chăm sóc da cơ bản bên mình giá bao nhiêu vậy shop?', time: '22:41' },
      {
        from: 'ai',
        text: 'Dạ chào chị! Gói chăm sóc da cơ bản bên em là 350.000đ/buổi, khoảng 60 phút ạ. Chị muốn đặt lịch hôm nào để em báo lễ tân giữ chỗ ạ?',
      },
      { from: 'customer', text: 'Tối thứ 7 được không em?' },
      {
        from: 'ai',
        text: 'Dạ, để lễ tân kiểm tra lịch tối thứ 7 rồi gọi xác nhận cho chị. Chị cho em xin tên và số điện thoại nhé?',
      },
      { from: 'customer', text: 'Chị Lan, 09xx xxx 123' },
      { from: 'event', text: 'Đã lưu khách vào Google Sheet', icon: 'sheet' },
      { from: 'event', text: 'Đã báo lễ tân qua Zalo', icon: 'bell' },
      {
        from: 'ai',
        text: 'Em ghi nhận rồi ạ. Sáng mai lễ tân sẽ gọi chị trong giờ làm việc. Chị cần em gửi thêm bảng giá các gói khác không ạ?',
      },
    ] as ChatMessage[],
    processTitle: 'Cách ADS-Nolimit làm việc',
    processLead: 'Bốn bước, bạn duyệt ở từng bước trước khi đi tiếp.',
    caseLabel: 'Case study nội bộ',
    caseMore: 'Xem dự án và case study',
    pricingTitle: 'Bảng giá rút gọn',
    pricingLead: 'Giá công khai để bạn ước lượng trước khi trao đổi.',
    faqTitle: 'Câu hỏi thường gặp',
  },
  en: {
    title: 'ADS-Nolimit | Advertising & AI agents for businesses in Vietnam',
    description: site.defaultDescriptionEn,
    h1: 'AI staff that work 24/7. Ads optimised every day.',
    lead: 'ADS-Nolimit builds AI agents that answer your customers, automates repetitive work and runs your Facebook, Google and TikTok ads, so shops and small businesses can do more with fewer people.',
    primary: { label: 'Message us on Telegram', href: links.telegram, icon: 'telegram' as IconName },
    secondary: 'See AI agent solutions',
    stats: [
      { value: 'Since 2016', label: '10 years in advertising' },
      { value: '800+', label: 'clients served' },
      { value: 'Facebook · Google · TikTok', label: 'multi-channel advertising', wide: true },
    ],
    trustLabel: 'Experience and partners',
    painsTitle: 'Three things that cost shops customers and time',
    pains: [
      {
        cue: '22:30',
        tone: 'violet',
        title: 'A customer asks for a price at night and hears back the next morning',
        text: 'Nights, weekends, rush hours: when messages wait, customers ask another shop.',
      },
      {
        cue: 'Every morning',
        tone: 'teal',
        title: 'Someone spends the morning copying numbers into a spreadsheet',
        text: 'Ad reports, orders and bookings done by hand: slow, easy to get wrong, and no energy left to read the numbers.',
      },
      {
        cue: 'Month end',
        tone: 'green',
        title: 'Ad costs keep rising and nobody knows where to cut',
        text: 'Budget spread over many campaigns, with no clear view of which ones bring customers and which just burn money.',
      },
    ],
    solutionsTitle: 'What ADS-Nolimit does for you',
    solutionsLead:
      'Three core services you can use on their own or together, plus two supporting services for shops that want to do more themselves.',
    solutions: [
      {
        tone: 'violet',
        icon: 'chat',
        title: 'AI agents for sales & customer care',
        text: 'Answers messages on Messenger, Zalo OA or your website using your own documents, even at midnight.',
        points: ['Answers common questions', 'Collects phone numbers into Google Sheets', 'New-lead alerts via Telegram or Zalo'],
        price: `${starter.name}: ${priceInline(starter, lang)}`,
        href: L('/giai-phap-ai-agent/'),
      },
      {
        tone: 'blue',
        icon: 'chart',
        title: 'Performance advertising',
        text: 'Facebook, Google and TikTok ads, run and optimised every day, with clear reports on where the money went.',
        points: ['Daily optimisation', 'Transparent reporting', 'Agency business ad accounts (BM2500)'],
        price: priceInline(ads, lang),
        href: L('/quang-cao/'),
      },
      {
        tone: 'green',
        icon: 'bolt',
        title: 'Workflow automation',
        text: 'Turns repetitive daily work into workflows that run on their own, connecting the software you already use.',
        points: ['Automatic ad report every morning', 'Order syncing', 'Bulk content drafts and appointment reminders'],
        price: priceInline(automation, lang),
        href: L('/tu-dong-hoa/'),
      },
    ] as Solution[],
    small: [
      {
        icon: 'code' as IconName,
        title: 'Websites & sales software',
        text: `Websites, landing pages and software that helps you sell on social media. ${web.prices[0].value}.`,
        href: L('/thiet-ke-website/'),
      },
      {
        icon: 'school' as IconName,
        title: training.name,
        text: `A one-session workshop with a set of prompt templates. ${priceInline(training, lang)}.`,
        href: L('/bang-gia/#training'),
      },
    ],
    details: 'Learn more',
    demoTitle: 'What happens to a message sent at 22:41',
    demoLead:
      'A sample conversation for a spa. The AI agent answers from the spa’s own price list, asks for a phone number, saves the lead and alerts reception. Anything that needs a person, like confirming the booking, is still done by a person.',
    demoPoints: [
      'Correct prices, in the shop’s own tone of voice',
      'Leads saved to Google Sheets instead of getting lost in the inbox',
      'Reception gets a Zalo alert and calls back in the morning',
    ],
    demoCta: 'See what an AI agent can do',
    agentName: 'Sample Spa AI assistant',
    chat: [
      { from: 'customer', text: 'Hi, how much is your basic facial package?', time: '22:41' },
      {
        from: 'ai',
        text: 'Hello! Our basic facial is $14 per session and takes about 60 minutes. Which day would you like? I’ll ask reception to hold a slot for you.',
      },
      { from: 'customer', text: 'Would Saturday evening work?' },
      {
        from: 'ai',
        text: 'Reception will check Saturday evening and call you to confirm. Could I have your name and phone number, please?',
      },
      { from: 'customer', text: 'Lan, 09xx xxx 123' },
      { from: 'event', text: 'Lead saved to Google Sheets', icon: 'sheet' },
      { from: 'event', text: 'Reception notified on Zalo', icon: 'bell' },
      {
        from: 'ai',
        text: 'Thank you, that’s noted. Reception will call you tomorrow morning during opening hours. Would you like our prices for the other packages too?',
      },
    ] as ChatMessage[],
    processTitle: 'How ADS-Nolimit works',
    processLead: 'Four steps. You sign off on each one before we move on.',
    caseLabel: 'Internal case study',
    caseMore: 'See projects and case studies',
    pricingTitle: 'Pricing at a glance',
    pricingLead: 'Public prices, so you can estimate the cost before we talk.',
    faqTitle: 'Frequently asked questions',
  },
}[lang];

const faq = getFaq(lang);
---

<BaseLayout title={copy.title} description={copy.description} lang={lang}>
  <!-- 1. Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1>{copy.h1}</h1>
        <p class="lead hero-lead">{copy.lead}</p>
        <div class="btn-row btn-row--stack-mobile">
          <a class="btn btn-primary" href={copy.primary.href} rel="noopener">
            <Icon name={copy.primary.icon} />
            {copy.primary.label}
          </a>
          <a class="btn btn-secondary" href={L('/giai-phap-ai-agent/')}>{copy.secondary}</a>
        </div>
      </div>

      <div class="hero-art">
        <HeroLoop lang={lang} />
      </div>

      <div class="trust" role="group" aria-label={copy.trustLabel}>
        <dl class="stats">
          {
            copy.stats.map((st) => (
              <div class:list={['stat', { 'stat--wide': st.wide }]}>
                <dt>{st.label}</dt>
                <dd>{st.value}</dd>
              </div>
            ))
          }
        </dl>
        <PartnerStrip lang={lang} />
      </div>
    </div>
  </section>

  <!-- 2. Ba nỗi đau -->
  <section class="section" aria-labelledby="pains-title">
    <div class="container">
      <div class="section-head">
        <h2 id="pains-title">{copy.painsTitle}</h2>
      </div>
      <ul class="pains">
        {
          copy.pains.map((p) => (
            <li class={`pain tone-${p.tone}`} data-glow="soft">
              <span class="pain-cue">{p.cue}</span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 3. Giải pháp -->
  <section class="section section--raise" aria-labelledby="solutions-title">
    <div class="container">
      <div class="section-head">
        <h2 id="solutions-title">{copy.solutionsTitle}</h2>
        <p>{copy.solutionsLead}</p>
      </div>

      <div class="solutions-big">
        {
          copy.solutions.map((s) => (
            <article class={`sol card tone-${s.tone}`} data-glow data-tilt>
              <span class="icon-tile icon-tile--lg">
                <Icon name={s.icon} />
              </span>
              <h3>{s.title}</h3>
              <p class="sol-text">{s.text}</p>
              <ul class="checklist sol-points">
                {s.points.map((pt) => (
                  <li>{pt}</li>
                ))}
              </ul>
              <p class="sol-price">{s.price}</p>
              <a class="text-link sol-link" href={s.href}>
                {copy.details}
                <span class="visually-hidden"> {s.title}</span>
                <Icon name="arrow" />
              </a>
            </article>
          ))
        }
      </div>

      <div class="solutions-small">
        {
          copy.small.map((s) => (
            <a class="sol-small card tone-sun" href={s.href} data-glow>
              <span class="icon-tile">
                <Icon name={s.icon} />
              </span>
              <span class="sol-small-body">
                <strong>{s.title}</strong>
                <span>{s.text}</span>
              </span>
              <Icon name="arrow" class="sol-small-arrow" />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 3b. Mô hình 3D: hệ thống làm việc thế nào -->
  <section class="section" aria-labelledby="system3d-title">
    <div class="container">
      <div class="section-head">
        <h2 id="system3d-title">{lang === 'en' ? 'How the ADS-Nolimit system works' : 'Hệ thống ADS-Nolimit làm việc thế nào'}</h2>
        <p class="lead">
          {
            lang === 'en'
              ? 'From the ad that brings a customer in to the report on your phone the next morning: six stations working in a chain, most of it automatic. Drag to rotate the model, or press “Run one customer”.'
              : 'Từ lúc quảng cáo đưa khách tới đến khi báo cáo về điện thoại của bạn sáng hôm sau: sáu trạm chạy nối nhau, phần lớn tự động. Kéo để xoay mô hình, hoặc bấm “Chạy thử 1 khách”.'
          }
        </p>
      </div>
      <System3D lang={lang} />
    </div>
  </section>

  <!-- 4. Hội thoại minh họa -->
  <section class="section" aria-labelledby="demo-title">
    <div class="container split demo">
      <div class="demo-copy">
        <h2 id="demo-title">{copy.demoTitle}</h2>
        <p class="lead demo-lead">{copy.demoLead}</p>
        <ul class="checklist demo-points">
          {copy.demoPoints.map((pt) => <li>{pt}</li>)}
        </ul>
        <a class="btn btn-secondary" href={L('/giai-phap-ai-agent/')}>{copy.demoCta}</a>
      </div>
      <div class="demo-chat">
        <ChatDemo lang={lang} agentName={copy.agentName} channel="Messenger" messages={copy.chat} clock="22:41" />
      </div>
    </div>
  </section>

  <!-- 5. Cách làm việc -->
  <section class="section section--raise" aria-labelledby="process-title">
    <div class="container">
      <div class="section-head">
        <h2 id="process-title">{copy.processTitle}</h2>
        <p>{copy.processLead}</p>
      </div>
      <ProcessSteps lang={lang} />
    </div>
  </section>

  <!-- 6. Case study nội bộ -->
  <section class="section" aria-label={copy.caseLabel}>
    <div class="container">
      <ReportBotCase lang={lang} moreLink={{ href: L('/du-an/'), label: copy.caseMore }} />
    </div>
  </section>

  <!-- 7. AI Office -->
  <section class="section section--tight" aria-label="ADS-NOLIMIT AI Office">
    <div class="container">
      <AiOfficeTeaser lang={lang} />
    </div>
  </section>

  <!-- 8. Bảng giá rút gọn -->
  <section class="section" aria-labelledby="pricing-title">
    <div class="container">
      <div class="section-head">
        <h2 id="pricing-title">{copy.pricingTitle}</h2>
        <p>{copy.pricingLead}</p>
      </div>
      <PricingSummary lang={lang} />
    </div>
  </section>

  <!-- 9. FAQ -->
  <section class="section section--raise" aria-labelledby="faq-title">
    <div class="container faq-layout">
      <div class="section-head">
        <h2 id="faq-title">{copy.faqTitle}</h2>
      </div>
      <Faq items={faq.home} />
    </div>
  </section>

  <!-- 10. CTA cuối -->
  <CtaBand lang={lang} />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    padding-block: clamp(2.5rem, 1.5rem + 4.5vw, 6rem) clamp(2.75rem, 2rem + 3vw, 4.5rem);
    background:
      radial-gradient(55% 65% at 92% 8%, rgb(72 0 168 / 0.45), transparent 65%),
      radial-gradient(35% 45% at 70% 0%, rgb(24 0 240 / 0.18), transparent 70%),
      radial-gradient(45% 55% at 0% 100%, rgb(24 144 144 / 0.14), transparent 70%);
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .hero-grid {
    display: grid;
    grid-template-areas: 'copy' 'trust' 'art';
    gap: 2.5rem;
    align-items: center;
  }
  .hero-copy {
    grid-area: copy;
  }
  .hero-art {
    grid-area: art;
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.22fr) minmax(0, 0.78fr);
      grid-template-areas: 'copy art' 'trust trust';
      column-gap: clamp(3rem, 1rem + 4vw, 5rem);
      row-gap: clamp(3rem, 2rem + 3vw, 4.5rem);
    }
  }

  .hero h1 {
    max-width: 13em;
  }

  .hero-lead {
    margin: 1.5rem 0 2rem;
    max-width: 36rem;
  }

  /* ---------- Trust row: số liệu + đối tác ---------- */
  .trust {
    grid-area: trust;
    display: grid;
    gap: 1.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 1180px) {
    .trust {
      grid-template-columns: auto minmax(0, 1fr);
      gap: clamp(2.5rem, 1rem + 3vw, 4rem);
      align-items: end;
      padding-top: 2rem;
    }
  }

  .stats {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1.5rem;
  }

  @media (min-width: 640px) {
    .stats {
      grid-template-columns: auto auto minmax(0, 1fr);
      gap: 0;
    }
    .stat + .stat {
      padding-left: clamp(1.25rem, 0.5rem + 1.5vw, 1.75rem);
      margin-left: clamp(1.25rem, 0.5rem + 1.5vw, 1.75rem);
      border-left: 1px solid var(--line);
    }
  }

  .stat {
    display: flex;
