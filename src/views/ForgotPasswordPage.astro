---
/** Trang Quên mật khẩu (/quen-mat-khau/ và /en/forgot-password/). Xử lý: src/lib/auth/forgot.ts. */
import '../styles/auth.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthShell from '../components/auth/AuthShell.astro';
import Field from '../components/auth/Field.astro';
import { localize } from '../config/i18n';
import type { Lang } from '../config/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const signIn = localize('/dang-nhap/', lang);

const copy = {
  vi: {
    title: 'Quên mật khẩu | ADS-Nolimit',
    description: 'Đặt lại mật khẩu tài khoản ADS-Nolimit qua email.',
    h1: 'Quên mật khẩu?',
    lead: 'Nhập email bạn dùng để đăng ký. ADS-Nolimit sẽ gửi link để bạn đặt mật khẩu mới.',
    email: 'Email',
    submit: 'Gửi link đặt lại mật khẩu',
    back: 'Quay lại đăng nhập',
    remember: 'Nhớ ra mật khẩu rồi?',
    below:
      'Bạn đăng ký bằng Google? Hãy quay lại và bấm “Đăng nhập với Google”, không cần đặt lại mật khẩu.',
  },
  en: {
    title: 'Forgot password | ADS-Nolimit',
    description: 'Reset the password of your ADS-Nolimit account by email.',
    h1: 'Forgot your password?',
    lead: 'Enter the email you signed up with and we will send you a link to set a new password.',
    email: 'Email',
    submit: 'Send reset link',
    back: 'Back to sign in',
    remember: 'Remembered it?',
    below: 'Signed up with Google? Go back and use “Sign in with Google” instead; no reset needed.',
  },
}[lang];
---

<BaseLayout title={copy.title} description={copy.description} lang={lang} noindex>
  <AuthShell lang={lang} title={copy.h1} lead={copy.lead}>
    <form id="forgot-form" class="auth-form" novalidate>
      <div id="forgot-alert" class="auth-alert" role="alert"></div>
      <div id="forgot-status" class="auth-alert" role="status"></div>
      <Field id="forgot-email" name="email" type="email" label={copy.email} autocomplete="email" inputmode="email" required />
      <button type="submit" class="btn btn-primary btn-block">{copy.submit}</button>
    </form>

    <p class="auth-switch">
      {copy.remember} <a href={signIn} data-keep-next>{copy.back}</a>
    </p>

    <p slot="below">{copy.below}</p>
  </AuthShell>
</BaseLayout>

<script>
  import '../lib/auth/forgot';
</script>
