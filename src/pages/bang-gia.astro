---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PlanCard from '../components/PlanCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { links } from '../config/site';
import { plans, pilotOffer, priceNote } from '../data/pricing';

// Gom các gói theo nhóm, giữ thứ tự nhóm như trong src/data/pricing.ts
const groups: { name: string; plans: typeof plans }[] = [];
for (const plan of plans) {
  const group = groups.find((g) => g.name === plan.group);
  if (group) group.plans.push(plan);
  else groups.push({ name: plan.group, plans: [plan] });
}
---

<BaseLayout
  title="Bảng giá dịch vụ quảng cáo, AI Agent, tự động hóa | ADS-Nolimit"
  description="Bảng giá ADS-Nolimit: AI Agent Khởi đầu, AI Agent Bán hàng, quảng cáo hiệu suất 10–15% ngân sách, tự động hóa quy trình, website, đào tạo AI cho chủ shop."
>
  <PageHero
    title="Bảng giá"
    lead="Giá công khai cho từng dịch vụ để anh/chị ước lượng trước. Với việc làm theo yêu cầu, ADS-Nolimit báo giá cụ thể sau buổi khảo sát miễn phí."
  >
    <a class="btn btn-primary" href={links.zalo} rel="noopener"><Icon name="zalo" /> Hỏi giá qua Zalo</a>
  </PageHero>

  {
    pilotOffer.active && (
      <div class="container">
        <p class="pilot pilot-top">
          <strong>{pilotOffer.title}:</strong> {pilotOffer.text}
        </p>
      </div>
    )
  }

  {
    groups.map((group, i) => (
      <section class:list={['section', 'section--tight', { 'section--raise': i % 2 === 1 }]} aria-label={group.name}>
        <div class="container">
          <h2 class="group-title">{group.name}</h2>
          <div class:list={['plans', { 'plans--single': group.plans.length === 1 }]}>
            {group.plans.map((plan) => (
              <PlanCard plan={plan} />
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="section section--tight">
    <div class="container">
      <p class="price-note">{priceNote}</p>
    </div>
  </section>

  <CtaBand
    title="Chưa chắc gói nào hợp?"
    text="Nhắn Zalo cho ADS-Nolimit: anh/chị bán gì, khách nhắn qua kênh nào, mỗi ngày khoảng bao nhiêu tin. Chúng tôi gợi ý gói vừa đủ dùng."
  />
</BaseLayout>

<style>
  .pilot-top {
    margin-top: 2rem;
    margin-bottom: 0;
  }

  .group-title {
    font-size: var(--step-2);
    margin-bottom: 1.25rem;
  }

  .plans {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .plans {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
    .plans--single {
      grid-template-columns: minmax(0, 36rem);
    }
  }

  .price-note {
    padding: 1rem 1.25rem;
    border-radius: var(--r-md);
    border: 1px solid var(--line-strong);
    font-weight: 600;
    max-width: 60rem;
  }
</style>
