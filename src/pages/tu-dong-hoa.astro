---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ReportBotCase from '../components/ReportBotCase.astro';
import PlanCard from '../components/PlanCard.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { links } from '../config/site';
import { getPlan, priceNote } from '../data/pricing';
import { faqAutomation, faqTech, faqData } from '../data/faq';

const automation = getPlan('automation');

const examples = [
  {
    title: 'Báo cáo quảng cáo tự động mỗi sáng',
    before: 'Mở trình quản lý quảng cáo, chép số liệu từng chiến dịch sang bảng tính, rồi nhắn cho người phụ trách.',
    after: 'Số liệu tự vào bảng tính theo mẫu cố định; bản tóm tắt gửi vào nhóm Zalo hoặc Telegram trước giờ làm.',
  },
  {
    title: 'Đồng bộ đơn hàng',
    before: 'Đơn từ fanpage, Zalo, website nằm rải rác; nhân viên gõ lại từng đơn vào một file chung.',
    after: 'Đơn mới tự gom về một bảng: tên khách, số điện thoại, sản phẩm, trạng thái. Không gõ lại, không sót đơn.',
  },
  {
    title: 'Soạn nội dung hàng loạt',
    before: 'Mỗi sản phẩm mới phải tự viết mô tả, caption cho từng kênh, mất cả buổi cho vài chục sản phẩm.',
    after: 'Từ bảng thông tin sản phẩm, AI soạn bản nháp mô tả và caption theo giọng của shop. Người duyệt trước khi đăng.',
  },
  {
    title: 'Nhắc lịch khách',
    before: 'Lễ tân lật sổ hẹn, nhắn từng khách trước ngày hẹn, dễ quên khi đông khách.',
    after: 'Khách có lịch ngày mai tự nhận tin nhắc qua kênh đã đồng ý nhận; khách muốn đổi lịch được báo cho lễ tân.',
  },
];

const fits = [
  'Việc làm theo cùng một cách, lặp lại mỗi ngày hoặc mỗi tuần',
  'Dữ liệu đã nằm trong phần mềm: trình quản lý quảng cáo, Google Sheet, fanpage, phần mềm bán hàng',
  'Kết quả kiểm tra được: đúng hay sai nhìn là biết',
];
---

<BaseLayout
  title="Tự động hóa quy trình cho shop & doanh nghiệp nhỏ | ADS-Nolimit"
  description="Tự động hóa báo cáo quảng cáo, đồng bộ đơn hàng, soạn nội dung hàng loạt, nhắc lịch khách. Khảo sát miễn phí, triển khai từ 15.000.000đ/quy trình."
>
  <PageHero
    title="Tự động hóa những việc lặp lại mỗi ngày"
    lead="Việc nào làm theo cùng một cách mỗi ngày, việc đó có thể tự chạy. ADS-Nolimit khảo sát miễn phí, dựng quy trình kết nối các phần mềm anh/chị đang dùng, rồi bảo trì để nó chạy ổn định."
  >
    <a class="btn btn-primary" href={links.zalo} rel="noopener"><Icon name="zalo" /> Đặt lịch khảo sát miễn phí</a>
    <a class="btn" href="#gia">Xem giá</a>
  </PageHero>

  <section class="section" aria-labelledby="examples-title">
    <div class="container">
      <div class="section-head">
        <h2 id="examples-title">Trước và sau khi tự động hóa</h2>
        <p>Bốn quy trình shop và doanh nghiệp nhỏ hay nhờ ADS-Nolimit làm nhất.</p>
      </div>
      <div class="examples">
        {
          examples.map((ex) => (
            <article class="example">
              <h3>{ex.title}</h3>
              <div class="ba">
                <div class="ba-col ba-before">
                  <p class="ba-label">Trước</p>
                  <p>{ex.before}</p>
                </div>
                <div class="ba-col ba-after">
                  <p class="ba-label">Sau</p>
                  <p>{ex.after}</p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
      <p class="note">
        Nội dung do AI soạn luôn có người duyệt trước khi đăng. Hình ảnh do AI tạo cần gắn nhãn theo Luật Trí tuệ nhân tạo
        (134/2025/QH15).
      </p>
    </div>
  </section>

  <section class="section section--raise" aria-labelledby="fit-title">
    <div class="container split">
      <div>
        <h2 id="fit-title">Việc nào nên tự động hóa?</h2>
        <p class="lead fit-lead">Một quy trình đáng tự động hóa thường có đủ ba dấu hiệu dưới đây. Nếu chưa chắc, buổi khảo sát miễn phí sẽ trả lời giúp anh/chị.</p>
      </div>
      <ul class="checklist fit-list">{fits.map((f) => <li>{f}</li>)}</ul>
    </div>
  </section>

  <section class="section" aria-label="Case study nội bộ">
    <div class="container">
      <ReportBotCase detailed />
    </div>
  </section>

  <section class="section section--raise" id="gia" aria-labelledby="price-title">
    <div class="container split">
      <div>
        <h2 id="price-title">Giá tự động hóa</h2>
        <p class="lead fit-lead">
          Giá phụ thuộc số bước và số phần mềm cần kết nối. ADS-Nolimit báo giá cụ thể sau buổi khảo sát miễn phí.
        </p>
        <p class="note">{priceNote}</p>
      </div>
      <PlanCard plan={automation} showLink={false} />
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="container">
      <div class="section-head">
        <h2 id="faq-title">Câu hỏi thường gặp</h2>
      </div>
      <Faq items={[faqAutomation, faqTech, faqData]} />
    </div>
  </section>

  <CtaBand
    title="Việc nào đang lặp lại mỗi ngày ở cửa hàng của anh/chị?"
    text="Kể cho ADS-Nolimit nghe. Buổi khảo sát miễn phí sẽ cho biết việc đó có nên tự động hóa không, và tốn bao nhiêu."
  />
</BaseLayout>

<style>
  .examples {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 960px) {
    .examples {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .example {
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    background: var(--bg-raise);
  }

  .example h3 {
    font-size: var(--step-1);
    margin-bottom: 1rem;
  }

  .ba {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 560px) {
    .ba {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .ba-col {
    padding: 0.9rem 1rem;
    border-radius: var(--r-md);
    font-size: 0.9688rem;
  }

  .ba-before {
    background: var(--bg);
    border: 1px dashed var(--line-strong);
    color: var(--text-2);
  }

  .ba-after {
    background: rgb(0 216 120 / 0.07);
    border: 1px solid rgb(0 216 120 / 0.4);
  }

  .ba-label {
    margin-bottom: 0.35rem;
    font-weight: 700;
    font-size: 0.875rem;
  }
  .ba-before .ba-label {
    color: var(--text-3);
  }
  .ba-after .ba-label {
    color: var(--green-ink);
  }
  .ba-col p + p {
    margin-top: 0;
  }

  .fit-lead {
    margin-top: 1rem;
  }

  .fit-list {
    font-size: var(--step-1);
    gap: 1rem;
  }
</style>
