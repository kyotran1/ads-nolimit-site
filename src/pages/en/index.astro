---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import PartnerStrip from '../../components/PartnerStrip.astro';
import { contact, links } from '../../config/site';

const services = [
  {
    title: 'AI agents for sales & customer care',
    text: 'An AI assistant answers customers on Facebook Messenger, Zalo OA or your website, based on your own price list and FAQs. It collects phone numbers into Google Sheets and alerts your team about new leads via Telegram or Zalo.',
  },
  {
    title: 'Performance advertising',
    text: 'Planning, running and daily optimisation of Facebook, Google and TikTok ads, with clear reporting. Management fee of 10–15% of ad spend, with a 7-day trial. Agency business ad accounts (BM2500) that run in line with each platform’s advertising policies.',
  },
  {
    title: 'Workflow automation',
    text: 'Repetitive daily tasks turned into workflows that run on their own: morning ad reports, order syncing, bulk content drafts, appointment reminders. Free assessment first.',
  },
  {
    title: 'Websites & online sales software',
    text: 'Websites, landing pages for ad campaigns and software that helps businesses sell on social media.',
  },
  {
    title: 'AI training for shop owners',
    text: 'A one-session workshop with a ready-to-use set of prompt templates.',
  },
];
---

<BaseLayout
  lang="en"
  title="ADS-Nolimit | Advertising & AI agents for businesses in Vietnam"
  description="ADS-Nolimit has run ads since 2016 for 800+ clients. We now build AI agents and workflow automation that help Vietnamese small businesses do more with fewer people."
  alternate={{ vi: '/', en: '/en/' }}
>
  <section class="en-hero">
    <div class="container">
      <h1>AI agents that work 24/7. Ads optimised every day.</h1>
      <p class="lead en-lead">
        ADS-Nolimit is a Vietnamese agency that has been running ads since 2016 and has served more than 800 clients. We now
        also build AI agents and automated workflows, so individuals and small businesses can do more with fewer people.
      </p>
      <div class="btn-row btn-row--stack-mobile">
        <a class="btn btn-primary" href={links.zalo} rel="noopener"><Icon name="zalo" /> Message us on Zalo</a>
        <a class="btn" href="#contact">All contact options</a>
      </div>
      <p class="note">The full website, including prices, is in Vietnamese: <a href="/" lang="vi" hreflang="vi">tiếng Việt</a>.</p>
    </div>
  </section>

  <PartnerStrip band lang="en" />

  <section class="section section--raise" aria-labelledby="services-title">
    <div class="container">
      <div class="section-head">
        <h2 id="services-title">What we do</h2>
      </div>
      <ul class="en-services">
        {
          services.map((s) => (
            <li>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ul>
      <p class="coming">
        <span class="tag tag--sun">Coming soon</span>
        <span><strong>ADS-NOLIMIT AI Office</strong>, an AI office software built by ADS-Nolimit.</span>
      </p>
    </div>
  </section>

  <section class="section" id="contact" aria-labelledby="contact-title">
    <div class="container">
      <div class="section-head">
        <h2 id="contact-title">Contact</h2>
        <p>Free consultation. Zalo is the fastest way to reach us.</p>
      </div>
      <ul class="en-contacts">
        <li><span>Zalo</span><a href={links.zalo} rel="noopener">{contact.zaloPhone}</a></li>
        <li><span>Hotline</span><a href={links.hotline}>{contact.hotline}</a></li>
        <li><span>Phone & Zalo</span><a href={links.phone}>{contact.zaloPhone}</a></li>
        <li><span>Assistant</span><a href={links.assistant}>{contact.assistantPhone}</a></li>
        <li><span>Telegram</span><a href={links.telegram} rel="noopener">@{contact.telegramUser}</a></li>
        <li><span>Email</span><a href={links.email}>{contact.email}</a></li>
        <li><span>Facebook</span><a href={links.facebook} rel="noopener">{contact.facebookName}</a></li>
        <li><span>Messenger</span><a href={links.messenger} rel="noopener">m.me/{contact.facebookPage}</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .en-hero {
    padding-block: clamp(2.75rem, 2rem + 4vw, 5.5rem);
    background: radial-gradient(60% 90% at 90% 0%, rgb(72 0 168 / 0.4), transparent 65%);
  }
  .en-hero h1 {
    max-width: 16em;
  }
  .en-lead {
    margin: 1.25rem 0 1.75rem;
  }

  .en-services {
    list-style: none;
    display: grid;
    gap: 1.75rem;
  }
  @media (min-width: 768px) {
    .en-services {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 3rem;
    }
  }
  .en-services li {
    padding-top: 1rem;
    border-top: 1px solid var(--line-strong);
  }
  .en-services h3 {
    font-size: var(--step-1);
  }
  .en-services p {
    margin-top: 0.4rem;
    color: var(--text-2);
  }

  .coming {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  .en-contacts {
    list-style: none;
    display: grid;
    gap: 0.75rem;
    max-width: 44rem;
  }
  .en-contacts li {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
  }
  .en-contacts span {
    color: var(--text-3);
  }
  .en-contacts a {
    color: var(--text);
    font-weight: 600;
    overflow-wrap: anywhere;
  }
</style>
