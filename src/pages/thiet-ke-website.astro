---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import PlanCard from '../components/PlanCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { links } from '../config/site';
import { getPlan, priceNote } from '../data/pricing';

const web = getPlan('web');

const offers = [
  {
    icon: 'code' as const,
    title: 'Website doanh nghiệp',
    text: 'Giới thiệu cửa hàng, dịch vụ, bảng giá, cách liên hệ. Gọn, rõ, dễ tự cập nhật nội dung.',
  },
  {
    icon: 'chart' as const,
    title: 'Landing page cho quảng cáo',
    text: 'Một trang cho một chiến dịch: nói đúng điều khách vừa thấy trên quảng cáo, nút liên hệ rõ ràng, đo được hiệu quả.',
  },
  {
    icon: 'chat' as const,
    title: 'Phần mềm hỗ trợ bán hàng online',
    text: 'Phần mềm hỗ trợ anh/chị bán hàng online trên mạng xã hội, kết nối được với AI Agent.',
  },
];

const standards = [
  'Tải nhanh trên điện thoại, nơi phần lớn khách đọc',
  'Tiêu đề, mô tả, sitemap chuẩn để Google hiểu từng trang',
  'Nút Zalo, gọi điện, Messenger luôn trong tầm tay',
  'Gắn công cụ đo lường (Google Analytics, Meta Pixel) khi anh/chị cần, kèm cập nhật chính sách bảo mật',
  'Sẵn chỗ gắn khung chat AI Agent về sau',
];

const steps = [
  { title: 'Khảo sát', text: 'Website để làm gì: bán hàng, nhận lịch hẹn, hay chạy quảng cáo? Ai sẽ đọc, đọc trên thiết bị nào.' },
  { title: 'Thiết kế', text: 'Sơ đồ trang, nội dung chính và bản thiết kế giao diện. Anh/chị duyệt trước khi lập trình.' },
  { title: 'Triển khai', text: 'Lập trình, đưa nội dung lên, kiểm tra trên điện thoại và máy tính, gắn tên miền.' },
  { title: 'Đo và tối ưu', text: 'Theo dõi khách vào từ đâu, bấm nút nào; chỉnh nội dung và giao diện theo số liệu thật.' },
];
---

<BaseLayout
  title="Thiết kế website, landing page & phần mềm bán hàng online | ADS-Nolimit"
  description="ADS-Nolimit thiết kế, lập trình website, landing page cho quảng cáo và phần mềm hỗ trợ bán hàng online trên mạng xã hội. Nhanh trên điện thoại, sẵn sàng gắn AI Agent. Liên hệ báo giá."
>
  <PageHero
    title="Website, landing page và phần mềm hỗ trợ bán hàng online"
    lead="Lập trình và thiết kế website là việc ADS-Nolimit làm song song với quảng cáo. Một trang web tốt giúp quảng cáo hiệu quả hơn: khách bấm vào thấy đúng điều họ cần, liên hệ được ngay."
  >
    <a class="btn btn-primary" href={links.zalo} rel="noopener"><Icon name="zalo" /> Nhận báo giá qua Zalo</a>
  </PageHero>

  <section class="section" aria-labelledby="offers-title">
    <div class="container">
      <div class="section-head">
        <h2 id="offers-title">ADS-Nolimit làm gì</h2>
      </div>
      <ul class="offers">
        {
          offers.map((o) => (
            <li class="panel">
              <span class="offer-icon">
                <Icon name={o.icon} />
              </span>
              <h3>{o.title}</h3>
              <p>{o.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--raise" aria-labelledby="standards-title">
    <div class="container split">
      <div>
        <h2 id="standards-title">Mọi website đều có</h2>
        <p class="lead standards-lead">Những thứ cơ bản nhưng hay bị bỏ qua, ảnh hưởng trực tiếp đến số khách liên hệ.</p>
      </div>
      <ul class="checklist standards">{standards.map((s) => <li>{s}</li>)}</ul>
    </div>
  </section>

  <section class="section" aria-labelledby="steps-title">
    <div class="container">
      <div class="section-head">
        <h2 id="steps-title">Quy trình làm website</h2>
      </div>
      <ProcessSteps steps={steps} />
    </div>
  </section>

  <section class="section section--raise" aria-labelledby="price-title">
    <div class="container split">
      <div>
        <h2 id="price-title">Giá</h2>
        <p class="lead standards-lead">
          Mỗi website khác nhau về số trang, tính năng và nội dung, nên ADS-Nolimit báo giá sau khi trao đổi nhu cầu.
        </p>
        <p class="note">{priceNote}</p>
      </div>
      <PlanCard plan={web} showLink={false} />
    </div>
  </section>

  <CtaBand
    title="Cần website mới hoặc làm lại website cũ?"
    text="Gửi ADS-Nolimit đường dẫn website hiện tại (nếu có) và điều anh/chị muốn khách làm khi vào trang. Chúng tôi tư vấn miễn phí."
  />
</BaseLayout>

<style>
  .offers {
    list-style: none;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 900px) {
    .offers {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }
  .offer-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 1rem;
    border-radius: 12px;
    background: var(--bg);
    border: 1px solid var(--line-strong);
    color: var(--sun);
  }
  .offer-icon svg {
    width: 1.35rem;
    height: 1.35rem;
  }
  .offers h3 {
    font-size: var(--step-1);
  }
  .offers p {
    margin-top: 0.5rem;
    color: var(--text-2);
  }

  .standards-lead {
    margin: 1rem 0;
  }
  .standards {
    font-size: var(--step-1);
    gap: 0.9rem;
  }
</style>
