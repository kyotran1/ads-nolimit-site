---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { formatDate } from '../../lib/format';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Blog: AI Agent, tự động hóa và quảng cáo cho chủ shop | ADS-Nolimit"
  description="Bài viết dễ hiểu về AI Agent, tự động hóa, quảng cáo và các quy định mới cho chủ shop, doanh nghiệp nhỏ Việt Nam."
>
  <PageHero title="Blog" lead="Viết ngắn, dễ hiểu, cho chủ shop và doanh nghiệp nhỏ muốn dùng AI vào việc thật." />

  <section class="section">
    <div class="container">
      <ul class="posts">
        {
          posts.map((post) => (
            <li>
              <article class="post-card">
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                <h2>
                  <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                </h2>
                <p>{post.data.description}</p>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .posts {
    list-style: none;
    display: grid;
    gap: 0;
    max-width: 50rem;
    border-top: 1px solid var(--line);
  }

  .post-card {
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--line);
  }

  .post-card time {
    font-size: 0.875rem;
    color: var(--text-3);
  }

  .post-card h2 {
    margin-top: 0.4rem;
    font-size: var(--step-2);
    line-height: 1.3;
  }

  .post-card h2 a {
    color: var(--text);
    text-decoration: none;
  }
  .post-card h2 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--green);
  }

  .post-card p {
    margin-top: 0.6rem;
    color: var(--text-2);
  }
</style>
