---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import { formatDate } from '../../lib/format';
import { site } from '../../config/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  inLanguage: 'vi',
  author: { '@type': 'Organization', name: site.name, url: `${site.url}/` },
  publisher: { '@type': 'Organization', name: site.name, logo: { '@type': 'ImageObject', url: `${site.url}/logo.png` } },
  mainEntityOfPage: new URL(Astro.url.pathname, site.url).href,
};
---

<BaseLayout
  title={`${post.data.title} | ADS-Nolimit`}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
>
  <article class="post">
    <header class="post-head">
      <div class="container">
        <p class="post-meta">
          <a href="/blog/">Blog</a>
          <span aria-hidden="true">/</span>
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        </p>
        <h1>{post.data.title}</h1>
        <p class="lead post-lead">{post.data.description}</p>
      </div>
    </header>

    <div class="container">
      <div class="prose post-body">
        <Content />
      </div>

      {
        ((post.data.sources && post.data.sources.length > 0) || post.data.legalDisclaimer) && (
          <footer class="post-foot prose">
            {post.data.sources && post.data.sources.length > 0 && (
              <>
                <h2>Nguồn tham khảo</h2>
                <ol>
                  {post.data.sources.map((s) => (
                    <li>
                      <a href={s.url} rel="noopener">
                        {s.title}
                      </a>
                    </li>
                  ))}
                </ol>
              </>
            )}
            {post.data.legalDisclaimer && (
              <p class="disclaimer">Bài viết mang tính tham khảo, không phải tư vấn pháp lý.</p>
            )}
          </footer>
        )
      }
    </div>
  </article>

  <CtaBand
    title="Muốn áp dụng vào cửa hàng của mình?"
    text="Nhắn Zalo cho ADS-Nolimit. Tư vấn miễn phí, nói thẳng việc nào nên làm trước."
  />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleLd)}></script>
</BaseLayout>

<style>
  .post-head {
    padding-block: clamp(2.5rem, 2rem + 3vw, 4.5rem) clamp(1.5rem, 1rem + 2vw, 2.5rem);
    background: radial-gradient(70% 120% at 85% -20%, rgb(72 0 168 / 0.3), transparent 60%);
  }

  .post-head h1 {
    max-width: 22em;
    font-size: clamp(1.85rem, 1.3rem + 2.4vw, 3rem);
  }

  .post-meta {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    font-size: 0.9375rem;
    color: var(--text-3);
  }

  .post-lead {
    margin-top: 1rem;
  }

  .post-body {
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem) 1rem;
    font-size: var(--step-1);
    line-height: 1.7;
  }

  .post-body :global(p),
  .post-body :global(li) {
    color: var(--text-2);
  }
  .post-body :global(strong) {
    color: var(--text);
  }

  .post-foot {
    margin-block: 2.5rem 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .post-foot h2 {
    font-size: var(--step-1);
    margin-top: 0;
  }
  .post-foot li {
    overflow-wrap: anywhere;
  }

  .disclaimer {
    margin-top: 1.5rem;
    padding: 0.85rem 1rem;
    border-left: 3px solid var(--sun);
    background: rgb(238 214 90 / 0.06);
    color: var(--text);
    font-weight: 600;
  }
</style>
