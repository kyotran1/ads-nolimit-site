---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import AiOfficeTeaser from '../components/AiOfficeTeaser.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { getPlan, priceInline } from '../data/pricing';

const starter = getPlan('ai-starter');
const automation = getPlan('automation');
const training = getPlan('training');

const tools = [
  {
    icon: 'chat' as const,
    title: 'AI Agent bán hàng & chăm sóc khách',
    text: 'Trợ lý AI trả lời tin nhắn trên Messenger, Zalo OA, website theo tài liệu của doanh nghiệp.',
    meta: `Từ gói ${starter.name}: ${priceInline(starter)}`,
    href: '/giai-phap-ai-agent/',
  },
  {
    icon: 'bolt' as const,
    title: 'Tự động hóa quy trình theo yêu cầu',
    text: 'Quy trình tự chạy nối các phần mềm anh/chị đang dùng: báo cáo, đơn hàng, nội dung, lịch hẹn.',
    meta: priceInline(automation),
    href: '/tu-dong-hoa/',
  },
  {
    icon: 'code' as const,
    title: 'Phần mềm hỗ trợ bán hàng online',
    text: 'Phần mềm hỗ trợ anh/chị bán hàng online trên mạng xã hội.',
    meta: 'Liên hệ báo giá',
    href: '/thiet-ke-website/',
  },
  {
    icon: 'school' as const,
    title: 'Bộ mẫu câu lệnh AI cho chủ shop',
    text: 'Đi kèm workshop Đào tạo AI cho chủ shop (1 buổi), để anh/chị tự dùng AI trong việc hằng ngày.',
    meta: priceInline(training),
    href: '/bang-gia/#training',
  },
];
---

<BaseLayout
  title="Công cụ & phần mềm AI | ADS-Nolimit"
  description="Công cụ và phần mềm AI của ADS-Nolimit cho cá nhân và doanh nghiệp: AI Agent, tự động hóa quy trình, phần mềm bán hàng online. ADS-NOLIMIT AI Office sắp ra mắt."
>
  <PageHero
    title="Công cụ & phần mềm AI cho cá nhân và doanh nghiệp"
    lead="Những công cụ ADS-Nolimit đang cung cấp để anh/chị tự động hóa việc phức tạp, và phần mềm văn phòng AI do chính ADS-Nolimit phát triển, sắp ra mắt."
  />

  <section class="section" aria-labelledby="tools-title">
    <div class="container">
      <div class="section-head">
        <h2 id="tools-title">Đang cung cấp</h2>
      </div>
      <ul class="tools">
        {
          tools.map((t) => (
            <li>
              <a class="tool" href={t.href}>
                <span class="tool-icon">
                  <Icon name={t.icon} />
                </span>
                <span class="tool-body">
                  <strong class="tool-title">{t.title}</strong>
                  <span class="tool-text">{t.text}</span>
                  <span class="tool-meta">{t.meta}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--tight" aria-label="ADS-NOLIMIT AI Office">
    <div class="container">
      <AiOfficeTeaser />
    </div>
  </section>

  <CtaBand
    title="Chưa biết công cụ nào hợp với mình?"
    text="Kể cho ADS-Nolimit nghe công việc hằng ngày của anh/chị. Chúng tôi gợi ý công cụ phù hợp, kể cả khi câu trả lời là chưa cần AI."
  />
</BaseLayout>

<style>
  .tools {
    list-style: none;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 820px) {
    .tools {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  .tool {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    height: 100%;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    background: var(--bg-raise);
    color: var(--text);
    text-decoration: none;
  }
  .tool:hover {
    border-color: var(--line-strong);
  }
  .tool:hover .tool-title {
    text-decoration: underline;
  }

  .tool-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 12px;
    background: var(--bg);
    border: 1px solid var(--line-strong);
    color: var(--violet-ink);
  }
  .tool-icon svg {
    width: 1.35rem;
    height: 1.35rem;
  }

  .tool-body {
    display: grid;
    gap: 0.4rem;
  }
  .tool-title {
    font-size: var(--step-1);
  }
  .tool-text {
    color: var(--text-2);
  }
  .tool-meta {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--sun);
  }
</style>
