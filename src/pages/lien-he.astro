---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/Icon.astro';
import { channels, contact, links } from '../config/site';

const iconFor: Record<string, IconName> = {
  zalo: 'zalo',
  hotline: 'phone',
  phone: 'phone',
  assistant: 'phone',
  messenger: 'messenger',
  telegram: 'telegram',
  email: 'mail',
  facebook: 'facebook',
};

const needs = [
  'AI Agent bán hàng & chăm sóc khách',
  'Tự động hóa quy trình',
  'Quảng cáo hiệu suất',
  'Tài khoản quảng cáo Agency doanh nghiệp',
  'Website & phần mềm bán hàng',
  'Đào tạo AI cho chủ shop',
  'ADS-NOLIMIT AI Office',
  'Khác',
];
---

<BaseLayout
  title="Liên hệ tư vấn miễn phí | ADS-Nolimit"
  description={`Liên hệ ADS-Nolimit: Zalo ${contact.zaloPhone}, hotline ${contact.hotline}, Messenger, Telegram @${contact.telegramUser}, email ${contact.email}. Tư vấn miễn phí.`}
>
  <PageHero
    title="Liên hệ ADS-Nolimit"
    lead="Tư vấn miễn phí. Nhắn Zalo là nhanh nhất, hoặc chọn kênh anh/chị quen dùng."
  />

  <section class="section" aria-labelledby="channels-title">
    <div class="container">
      <h2 id="channels-title" class="visually-hidden">Các kênh liên hệ</h2>
      <ul class="channels">
        {
          channels.map((c) => (
            <li>
              <a class:list={['channel', { 'channel--main': c.id === 'zalo' }]} href={c.href} rel={c.external ? 'noopener' : undefined}>
                <span class="channel-icon">
                  <Icon name={iconFor[c.id] ?? 'chat'} />
                </span>
                <span class="channel-body">
                  <span class="channel-label">{c.label}</span>
                  <strong class="channel-value">{c.value}</strong>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--raise" aria-labelledby="form-title">
    <div class="container split">
      <div>
        <h2 id="form-title">Hoặc để lại lời nhắn</h2>
        <p class="lead form-lead">
          Điền vài dòng, rồi chọn gửi qua email hoặc Zalo. ADS-Nolimit sẽ liên hệ lại để tư vấn.
        </p>
        <p class="note">
          Website không lưu thông tin trong form. Nội dung được chuyển sang ứng dụng email hoặc Zalo của anh/chị, và chỉ đến
          ADS-Nolimit khi anh/chị bấm gửi trong ứng dụng đó. Thông tin chỉ dùng để liên hệ tư vấn. Xem
          <a href="/chinh-sach-bao-mat/">chính sách bảo mật</a>.
        </p>
      </div>

      <!--
        TODO: Site tĩnh chưa có backend. Form hiện chỉ soạn nội dung rồi mở mailto: hoặc Zalo.
        Khi có dịch vụ nhận form (ví dụ Formspree, Google Forms, backend riêng), thay `action`
        và phần script bên dưới, đồng thời cập nhật /chinh-sach-bao-mat/.
      -->
      <form
        class="contact-form panel"
        id="contact-form"
        action={links.email}
        method="post"
        enctype="text/plain"
        data-email={contact.email}
        data-zalo={links.zalo}
      >
        <div class="field">
          <label for="f-name">Họ tên</label>
          <input id="f-name" name="ho_ten" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="f-phone">Số điện thoại / Zalo</label>
          <input id="f-phone" name="dien_thoai" type="tel" autocomplete="tel" inputmode="tel" required />
        </div>
        <div class="field">
          <label for="f-email">Email <span class="optional">(không bắt buộc)</span></label>
          <input id="f-email" name="email" type="email" autocomplete="email" />
        </div>
        <div class="field">
          <label for="f-need">Anh/chị quan tâm</label>
          <select id="f-need" name="nhu_cau">
            {needs.map((n) => <option>{n}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="f-msg">Lời nhắn</label>
          <textarea id="f-msg" name="loi_nhan" rows="4" placeholder="Ví dụ: shop mỹ phẩm, khách nhắn nhiều qua fanpage buổi tối…"></textarea>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary" data-send="email"><Icon name="mail" /> Gửi qua email</button>
          <button type="button" class="btn" data-send="zalo"><Icon name="zalo" /> Gửi qua Zalo</button>
        </div>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  // Soạn nội dung từ form rồi mở email (mailto:) hoặc Zalo. Không gửi dữ liệu đến máy chủ nào.
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  if (form) {
    const status = form.querySelector<HTMLParagraphElement>('.form-status');
    const say = (text: string) => {
      if (status) status.textContent = text;
    };
    const compose = () => {
      const data = new FormData(form);
      const get = (key: string) => String(data.get(key) ?? '').trim();
      const lines = [
        'Chào ADS-Nolimit, tôi cần tư vấn.',
        '',
        `Họ tên: ${get('ho_ten')}`,
        `Số điện thoại / Zalo: ${get('dien_thoai')}`,
      ];
      if (get('email')) lines.push(`Email: ${get('email')}`);
      lines.push(`Quan tâm: ${get('nhu_cau')}`);
      if (get('loi_nhan')) lines.push('', get('loi_nhan'));
      return { subject: `Tư vấn: ${get('nhu_cau')} - ${get('ho_ten')}`, body: lines.join('\r\n') };
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const { subject, body } = compose();
      const email = form.dataset.email ?? '';
      window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      say('Đang mở ứng dụng email của anh/chị. Bấm Gửi trong ứng dụng email để hoàn tất.');
    });

    form.querySelector('[data-send="zalo"]')?.addEventListener('click', async () => {
      if (!form.reportValidity()) return;
      const { body } = compose();
      let copied = false;
      try {
        await navigator.clipboard.writeText(body);
        copied = true;
      } catch {
        copied = false;
      }
      window.open(form.dataset.zalo, '_blank', 'noopener');
      say(
        copied
          ? 'Đã sao chép lời nhắn. Dán vào khung chat Zalo vừa mở rồi bấm gửi.'
          : 'Zalo đã mở trong tab mới. Anh/chị nhắn trực tiếp nội dung cần tư vấn nhé.',
      );
    });
  }
</script>

<style>
  .channels {
    list-style: none;
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .channels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .channels {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  .channel {
    display: flex;
    gap: 0.9rem;
    align-items: center;
    height: 100%;
    padding: 1rem 1.1rem;
    border-radius: var(--r-md);
    border: 1px solid var(--line);
    background: var(--bg-raise);
    color: var(--text);
    text-decoration: none;
  }
  .channel:hover {
    border-color: var(--line-strong);
  }
  .channel:hover .channel-value {
    text-decoration: underline;
  }

  .channel--main {
    border-color: var(--green);
    background: rgb(0 216 120 / 0.08);
  }

  .channel-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 10px;
    background: var(--bg);
    border: 1px solid var(--line-strong);
    color: var(--green-ink);
  }
  .channel-icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .channel-body {
    display: grid;
    min-width: 0;
  }
  .channel-label {
    font-size: 0.8125rem;
    color: var(--text-3);
  }
  .channel-value {
    overflow-wrap: anywhere;
    font-size: 0.9688rem;
  }

  .form-lead {
    margin: 1rem 0;
  }

  .contact-form {
    display: grid;
    gap: 1rem;
  }

  .field {
    display: grid;
    gap: 0.4rem;
  }

  .field label {
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .optional {
    font-weight: 400;
    color: var(--text-3);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 48px;
    padding: 0.7rem 0.9rem;
    border-radius: 10px;
    border: 1.5px solid var(--line-strong);
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 1rem;
  }
  .field textarea {
    resize: vertical;
  }
  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    outline: 3px solid var(--sun);
    outline-offset: 1px;
    border-color: var(--sun);
  }
  .field ::placeholder {
    color: var(--text-3);
  }

  .form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }
  @media (max-width: 479.98px) {
    .form-actions .btn {
      flex: 1 1 100%;
    }
  }

  .form-status {
    min-height: 1.5em;
    font-size: 0.9375rem;
    color: var(--green-ink);
  }
</style>
