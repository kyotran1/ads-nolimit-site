---
import { Image } from 'astro:assets';
import logoFull from '../assets/brand/logo-full.png';
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
import { site, contact, links, solutionsNav, mainNav } from '../config/site';
import { homeOf, localize, t } from '../config/i18n';
import type { Lang } from '../config/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'vi' } = Astro.props;
const s = t(lang);
const c = s.contactLabels;
const year = new Date().getFullYear();

const solutions = solutionsNav.map((item) => ({ href: localize(item.href, lang), label: item.label[lang] }));
const company = [
  ...mainNav.map((item) => ({ href: localize(item.href, lang), label: item.label[lang] })),
  { href: localize('/lien-he/', lang), label: s.contact },
  { href: localize('/chinh-sach-bao-mat/', lang), label: s.privacy },
  { href: localize('/dieu-khoan/', lang), label: s.terms },
];

const contacts = [
  { label: c.hotline, value: contact.hotline, href: links.hotline },
  { label: c.phone, value: contact.zaloPhone, href: links.phone },
  { label: c.assistant, value: contact.assistantPhone, href: links.assistant },
  { label: c.telegram, value: `@${contact.telegramUser}`, href: links.telegram, external: true },
  { label: c.email, value: contact.email, href: links.email },
  { label: c.fanpage, value: contact.facebookName, href: links.facebook, external: true },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href={homeOf[lang]} class="footer-logo" aria-label={`${site.name}, ${s.home}`}>
          <Image src={logoFull} alt="" width={132} densities={[1, 2]} />
        </a>
        <p class="footer-about">{s.footerAbout}</p>
        <ul class="footer-quick" aria-label={s.quickContact}>
          <li>
            <a href={links.zalo} rel="noopener"><Icon name="zalo" /> Zalo</a>
          </li>
          <li>
            <a href={links.telegram} rel="noopener"><Icon name="telegram" /> Telegram</a>
          </li>
          <li>
            <a href={links.email}><Icon name="mail" /> Email</a>
          </li>
          <li>
            <a href={links.messenger} rel="noopener"><Icon name="messenger" /> Messenger</a>
          </li>
        </ul>
      </div>

      <nav class="footer-col" aria-label={s.solutions}>
        <p class="footer-title">{s.solutions}</p>
        <ul>
          {
            solutions.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="footer-col" aria-label={s.company}>
        <p class="footer-title">{s.company}</p>
        <ul>
          {
            company.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="footer-col">
        <p class="footer-title">{s.contact}</p>
        <dl class="footer-contacts">
          {
            contacts.map((item) => (
              <div>
                <dt>{item.label}</dt>
                <dd>
                  <a href={item.href} rel={item.external ? 'noopener' : undefined}>
                    {item.value}
                  </a>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} {site.name}</p>
      <p class="footer-ai">{s.footerAiNote}</p>
      <LangSwitch lang={lang} />
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: var(--footer-bg);
    padding-top: clamp(3rem, 2.25rem + 3vw, 4.5rem);
    font-size: 0.9375rem;
  }
  .site-footer::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--grad);
    opacity: 0.45;
  }

  .footer-grid {
    display: grid;
    gap: 2.25rem 2rem;
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr) minmax(0, 0.8fr) minmax(0, 1.25fr);
      gap: 2.5rem;
    }
    .footer-brand {
      grid-column: auto;
    }
  }

  .footer-logo {
    display: inline-block;
    margin-bottom: 1rem;
  }
  .footer-logo img {
    width: 132px;
  }

  .footer-about {
    max-width: 22rem;
    color: var(--text-2);
    line-height: 1.6;
  }

  .footer-quick {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }
  .footer-quick a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 40px;
    padding: 0 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--text);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .footer-quick a:hover,
  .footer-quick a:focus-visible {
    border-color: rgb(165 140 255 / 0.65);
    background: rgb(124 92 255 / 0.12);
    box-shadow: 0 10px 26px -14px rgb(124 92 255 / 0.9);
  }
  .footer-quick svg {
    width: 1rem;
    height: 1rem;
    color: var(--green-ink);
  }

  .footer-title {
    margin-bottom: 0.9rem;
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--text);
  }

  .footer-col ul {
    list-style: none;
    display: grid;
    gap: 0.15rem;
  }

  /* Hover: chữ sáng lên, gạch chân gradient chạy từ trái sang */
  .footer-col ul a,
  .footer-contacts a {
    background: linear-gradient(90deg, #b49dff, #2ee89a) no-repeat 0 100% / 0% 1px;
    transition:
      color 0.2s ease,
      background-size 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
      text-shadow 0.2s ease;
  }
  .footer-col ul a:hover,
  .footer-col ul a:focus-visible,
  .footer-contacts a:hover,
  .footer-contacts a:focus-visible {
    color: var(--text-hi);
    text-decoration: none;
    background-size: 100% 1px;
    text-shadow: 0 0 16px rgb(165 140 255 / 0.55);
  }

  .footer-col ul a {
    display: inline-block;
    padding-block: 0.3rem;
    color: var(--text-2);
    text-decoration: none;
    background-position: 0 calc(100% - 0.2rem);
  }

  .footer-contacts {
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  .footer-contacts div {
    display: grid;
    gap: 0.05rem;
  }
  .footer-contacts dt {
    font-size: 0.8125rem;
    color: var(--text-3);
  }
  .footer-contacts dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .footer-contacts a {
    color: var(--text);
    font-weight: 400;
    text-decoration: none;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    padding-block: 1.1rem 1.4rem;
    border-top: 1px solid var(--line);
    color: var(--text-3);
    font-size: 0.8125rem;
  }
  .footer-bottom p {
    margin: 0;
  }
  .footer-bottom .footer-ai {
    margin-right: auto;
  }
</style>
