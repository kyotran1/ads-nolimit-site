---
/**
 * Nút trợ lý AI (góc dưới phải). Bấm mới tải phần khung chat (src/lib/tro-ly/widget.ts).
 * Chỉ hiện khi đã có địa chỉ trạm (aiChat.endpoint trong src/config/site.ts).
 * Phần tử nào có thuộc tính data-open-tro-ly cũng mở được khung chat (vd nhãn "Mới" ở trang chủ).
 */
import '../styles/tro-ly.css';
import Icon from './Icon.astro';
import { aiChat, links } from '../config/site';
import type { Lang } from '../config/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const label = lang === 'en' ? 'Ask our AI assistant' : 'Hỏi trợ lý AI';
---

{
  aiChat.endpoint && (
    <div id="trl" class="trl" data-endpoint={aiChat.endpoint} data-lang={lang} data-zalo={links.zalo}>
      <button type="button" class="trl-fab" aria-expanded="false" aria-label={label} title={label}>
        <Icon name="chat" />
        <span class="trl-fab-tag" aria-hidden="true">AI</span>
      </button>
    </div>
  )
}

<script>
  const root = document.getElementById('trl');
  if (root) {
    let mod: Promise<typeof import('../lib/tro-ly/widget')> | null = null;
    const load = () => (mod ??= import('../lib/tro-ly/widget'));
    root.querySelector('.trl-fab')?.addEventListener('click', () => void load().then((m) => m.toggleChat(root)));
    document.addEventListener('click', (e) => {
      const t = (e.target as Element | null)?.closest?.('[data-open-tro-ly]');
      if (!t) return;
      e.preventDefault();
      void load().then((m) => m.openChat(root));
    });
    try {
      if (JSON.parse(sessionStorage.getItem('trl-v1') || '{}').open === true) void load().then((m) => m.openChat(root));
    } catch {
      /* bỏ qua */
    }
  } else {
    document.querySelectorAll<HTMLElement>('[data-open-tro-ly]').forEach((el) => (el.hidden = true));
  }
</script>
