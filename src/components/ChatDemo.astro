---
/**
 * Khung chat mô phỏng AI Agent, tự phát như một đoạn video ngắn.
 * LUÔN có nhãn "Hội thoại minh họa" / "Illustrative conversation" (không bao giờ bị ẩn).
 *
 * - Không JavaScript hoặc người dùng bật "giảm chuyển động": hiện toàn bộ hội thoại, không tự phát.
 * - Có JavaScript: tin nhắn hiện lần lượt (khách → "đang nhập…" → AI trả lời → thông báo hệ thống),
 *   tự phát khi cuộn tới, tạm dừng khi ra khỏi màn hình, lặp lại sau vài giây.
 * - Chiều cao khung chat = chiều cao hội thoại đầy đủ (mọi tin luôn chiếm chỗ) → không xô lệch bố cục.
 * - Âm thanh (public/sounds/chat-*.mp3, tự tổng hợp bằng scripts/make-chat-sounds.py):
 *   khách gửi tin → "send", AI đang soạn → "typing" (rất nhỏ), AI trả lời → "receive",
 *   thông báo hệ thống → "notify". Trình duyệt chặn tự phát tiếng nên mặc định TẮT;
 *   khách bấm "Bật tiếng" một lần, lựa chọn được nhớ cho các trang sau (localStorage).
 *   File âm thanh chỉ tải khi khách bật tiếng.
 */
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';
import type { Lang } from '../config/i18n';

export interface ChatMessage {
  from: 'customer' | 'ai' | 'event';
  text: string;
  /** Giờ hiện dưới tin nhắn (ví dụ tin đầu tiên) */
  time?: string;
  /** Icon cho thông báo hệ thống (event) */
  icon?: IconName;
}

interface Props {
  lang?: Lang;
  /** Tên hiển thị của trợ lý trong khung chat */
  agentName: string;
  /** Kênh hiển thị, ví dụ "Messenger" */
  channel: string;
  messages: ChatMessage[];
  /** Giờ ở góc header (giờ khuya của cuộc trò chuyện) */
  clock?: string;
  /** Ghi chú nhỏ bên dưới khung */
  note?: string;
}

const { lang = 'vi', agentName, channel, messages, clock } = Astro.props;

const copy = {
  vi: {
    badge: 'Hội thoại minh họa',
    note: 'Tên cửa hàng, sản phẩm và giá trong hội thoại là ví dụ.',
    via: `Trả lời qua ${channel}`,
    typing: 'đang nhập…',
    customer: 'Khách:',
    ai: 'AI Agent:',
    play: 'Phát hội thoại minh họa',
    soundOn: 'Bật âm thanh hội thoại',
    soundOff: 'Tắt âm thanh hội thoại',
    soundText: 'Bật tiếng',
    pause: 'Tạm dừng hội thoại minh họa',
    replay: 'Phát lại từ đầu',
    caption: 'Hội thoại minh họa giữa khách hàng và AI Agent, không phải hội thoại thật.',
    clock: 'Giờ trong hội thoại',
  },
  en: {
    badge: 'Illustrative conversation',
    note: 'Shop names, products and prices in this conversation are examples.',
    via: `Replies on ${channel}`,
    typing: 'typing…',
    customer: 'Customer:',
    ai: 'AI agent:',
    play: 'Play the illustrative conversation',
    soundOn: 'Turn conversation sound on',
    soundOff: 'Turn conversation sound off',
    soundText: 'Sound on',
    pause: 'Pause the illustrative conversation',
    replay: 'Replay from the start',
    caption: 'An illustrative conversation between a customer and an AI agent, not a real one.',
    clock: 'Time in the conversation',
  },
}[lang];

const note = Astro.props.note ?? copy.note;
const clockTime = clock ?? messages.find((m) => m.time)?.time;
---

<figure
  class="chat"
  data-chat
  data-label-play={copy.play}
  data-label-pause={copy.pause}
  data-label-sound-on={copy.soundOn}
  data-label-sound-off={copy.soundOff}
>
  <div class="chat-window">
    <div class="chat-head">
      <span class="chat-avatar" aria-hidden="true">AI</span>
      <span class="chat-who">
        <strong>{agentName}</strong>
        <span class="chat-status">
          <span class="status-via">{copy.via}</span>
          <span class="status-typing" aria-hidden="true">{copy.typing}</span>
        </span>
      </span>
      {
        clockTime && (
          <span class="chat-clock" title={copy.clock}>
            <Icon name="clock" />
            <span>{clockTime}</span>
          </span>
        )
      }
    </div>

    <ol class="chat-log">
      <li class="chat-badge">
        <Icon name="spark" />
        {copy.badge}
      </li>
      {
        messages.map((m) =>
          m.from === 'event' ? (
            <li class="msg-event" data-step="event" data-len={m.text.length}>
              <Icon name={m.icon ?? 'bolt'} />
              <span>{m.text}</span>
            </li>
          ) : (
            <li
              class:list={['msg', m.from === 'ai' ? 'msg-ai' : 'msg-customer']}
              data-step={m.from}
              data-len={m.text.length}
            >
              {m.from === 'ai' && (
                <span class="typing" aria-hidden="true">
                  <i />
                  <i />
                  <i />
                </span>
              )}
              <span class="bubble">
                <span class="visually-hidden">{m.from === 'ai' ? copy.ai : copy.customer}</span>
                <span class="bubble-text">{m.text}</span>
                {m.time && <span class="msg-time">{m.time}</span>}
              </span>
            </li>
          ),
        )
      }
    </ol>

    <div class="chat-strip">
      <p class="strip-note">{note}</p>
      <div class="strip-player">
        <button type="button" class="cc-btn" data-act="toggle" aria-label={copy.pause}>
          <Icon name="pause" class="i-pause" />
          <Icon name="play" class="i-play" />
        </button>
        <span class="cc-track" aria-hidden="true"><span class="cc-fill"></span></span>
        <button type="button" class="cc-btn cc-sound" data-act="sound" aria-pressed="false" aria-label={copy.soundOn}>
          <Icon name="volume-off" class="i-sound-off" />
          <Icon name="volume" class="i-sound-on" />
          <span class="cc-sound-text" aria-hidden="true">{copy.soundText}</span>
        </button>
        <button type="button" class="cc-btn" data-act="replay" aria-label={copy.replay}>
          <Icon name="replay" />
        </button>
      </div>
    </div>
  </div>
  <figcaption class="chat-caption">
    <span class="visually-hidden">{copy.caption}</span>
    <span class="caption-note" aria-hidden="true">{note}</span>
  </figcaption>
</figure>

<script>
  // Phát hội thoại minh họa như video. Không thư viện. Tôn trọng prefers-reduced-motion.
  type State = 'hidden' | 'typing' | 'shown';
  interface Step {
    el: HTMLElement;
    typingAt: number;
    showAt: number;
    state?: State;
  }

  const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  /* ---------- Âm thanh: một bộ phát dùng chung cho mọi khung chat trên trang ---------- */
  type SoundName = 'send' | 'typing' | 'receive' | 'notify';
  const SOUND_NAMES: SoundName[] = ['send', 'typing', 'receive', 'notify'];
  const SOUND_KEY = 'adsnl-chat-sound';
  const SOUND_EVENT = 'adsnl-chat-sound';

  const readPref = () => {
    try {
      return localStorage.getItem(SOUND_KEY) === 'on';
    } catch {
      return false;
    }
  };
  const writePref = (on: boolean) => {
    try {
      localStorage.setItem(SOUND_KEY, on ? 'on' : 'off');
    } catch {
      /* chế độ ẩn danh / chặn lưu trữ: bỏ qua */
    }
  };

  const sound = {
    enabled: readPref(),
    ctx: null as AudioContext | null,
    out: null as GainNode | null,
    buffers: new Map<SoundName, AudioBuffer>(),
    loading: null as Promise<void> | null,

    /** Tạo AudioContext + tải file. Chỉ gọi trong thao tác của người dùng (bấm/chạm/phím). */
    unlock() {
      if (!this.ctx) {
        const Ctx: typeof AudioContext | undefined =
          window.AudioContext ?? (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
        if (!Ctx) return;
        const ctx = new Ctx();
        const comp = ctx.createDynamicsCompressor();
        comp.threshold.value = -14;
        comp.ratio.value = 3;
        const out = ctx.createGain();
        out.gain.value = 1;
        out.connect(comp).connect(ctx.destination);
        this.ctx = ctx;
        this.out = out;
      }
      if (this.ctx.state !== 'running') this.ctx.resume().catch(() => {});
      if (!this.loading) {
        const ctx = this.ctx;
        this.loading = Promise.all(
          SOUND_NAMES.map(async (name) => {
            try {
              const res = await fetch(`/sounds/chat-${name}.mp3`);
              const data = await res.arrayBuffer();
              const buf = await new Promise<AudioBuffer>((ok, fail) => ctx.decodeAudioData(data, ok, fail));
              this.buffers.set(name, buf);
            } catch {
              /* thiếu một tiếng thì im lặng, không làm hỏng hội thoại */
            }
          }),
        ).then(() => {});
      }
    },

    /** Phát một tiếng. Trả về hàm dừng (có giảm dần) cho tiếng gõ phím. */
    play(name: SoundName, gain = 1): (() => void) | null {
      const { ctx, out } = this;
      const buf = this.buffers.get(name);
      if (!this.enabled || !ctx || !out || !buf || ctx.state !== 'running') return null;
      const src = ctx.createBufferSource();
      const g = ctx.createGain();
      src.buffer = buf;
      g.gain.value = gain;
      src.connect(g).connect(out);
      src.start();
      return () => {
        const now = ctx.currentTime;
        g.gain.cancelScheduledValues(now);
        g.gain.setValueAtTime(g.gain.value, now);
        g.gain.linearRampToValueAtTime(0, now + 0.08);
        try {
          src.stop(now + 0.1);
        } catch {
          /* đã dừng */
        }
      };
    },

    set(on: boolean) {
      this.enabled = on;
      writePref(on);
      if (on) this.unlock();
      document.dispatchEvent(new CustomEvent(SOUND_EVENT));
    },
  };

  // Khách đã bật tiếng ở trang trước: mở khóa âm thanh ngay ở lần chạm/bấm/gõ phím đầu tiên.
  if (sound.enabled) {
    const kick = () => {
      sound.unlock();
      if (sound.ctx?.state === 'running') {
        for (const ev of ['pointerdown', 'pointerup', 'touchend', 'keydown']) document.removeEventListener(ev, kick, true);
      }
    };
    for (const ev of ['pointerdown', 'pointerup', 'touchend', 'keydown']) document.addEventListener(ev, kick, true);
  }

  function setup(root: HTMLElement) {
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-step]'));
    const fill = root.querySelector<HTMLElement>('.cc-fill');
    const toggle = root.querySelector<HTMLButtonElement>('[data-act="toggle"]');
    const replay = root.querySelector<HTMLButtonElement>('[data-act="replay"]');
    const soundBtn = root.querySelector<HTMLButtonElement>('[data-act="sound"]');
    if (!items.length || !fill || !toggle || !replay || !soundBtn) return;

    // Dựng dòng thời gian (ms): độ dài tin nhắn quyết định thời gian "đang nhập" và thời gian đọc.
    const steps: Step[] = [];
    let cursor = 700;
    for (const el of items) {
      const kind = el.dataset.step;
      const len = Number(el.dataset.len) || 40;
      const read = clamp(700 + len * 17, 900, 2600);
      if (kind === 'ai') {
        const typing = clamp(900 + len * 4, 1000, 1500);
        steps.push({ el, typingAt: cursor, showAt: cursor + typing });
        cursor += typing + read;
      } else if (kind === 'event') {
        steps.push({ el, typingAt: cursor, showAt: cursor });
        cursor += 950;
      } else {
        steps.push({ el, typingAt: cursor, showAt: cursor });
        cursor += read;
      }
    }
    const total = steps[steps.length - 1].showAt + 700; // thanh tiến trình đầy khi tin cuối đã hiện
    const hold = 4200; // dừng ở cuối trước khi lặp
    const fade = 450;

    let t = 0;
    let playing = false;
    let inView = false;
    let userPaused = false;
    let last = 0;
    let raf = 0;
    let stopTyping: (() => void) | null = null;

    const endTyping = () => {
      stopTyping?.();
      stopTyping = null;
    };

    /** Âm thanh khi một tin đổi trạng thái lúc đang phát (không kêu khi tua về đầu). */
    const cue = (s: Step, state: State) => {
      const kind = s.el.dataset.step;
      if (state === 'typing') {
        endTyping();
        stopTyping = sound.play('typing', 0.9);
      } else if (state === 'shown') {
        if (kind === 'ai') {
          endTyping();
          sound.play('receive');
        } else if (kind === 'event') {
          sound.play('notify');
        } else {
          sound.play('send');
        }
      }
    };

    const render = (withSound = false) => {
      let typing = false;
      for (const s of steps) {
        const state: State = t >= s.showAt ? 'shown' : t >= s.typingAt && s.typingAt < s.showAt ? 'typing' : 'hidden';
        if (state === 'typing') typing = true;
        if (state !== s.state) {
          const before = s.state;
          s.state = state;
          s.el.dataset.state = state;
          if (withSound && before !== undefined && state !== 'hidden') cue(s, state);
        }
      }
      if (!typing) endTyping();
      root.classList.toggle('is-typing', typing);
      root.classList.toggle('is-fading', t >= total + hold);
      fill.style.transform = `scaleX(${Math.min(1, t / total)})`;
    };

    const frame = (now: number) => {
      const dt = Math.min(now - last, 100);
      last = now;
      t += dt;
      if (t >= total + hold + fade) t = 0; // lặp lại
      render(true);
      raf = requestAnimationFrame(frame);
    };

    const updateButton = () => {
      root.classList.toggle('is-paused', !playing);
      toggle.setAttribute('aria-label', (playing ? root.dataset.labelPause : root.dataset.labelPlay) ?? '');
    };

    const play = () => {
      if (playing) return;
      playing = true;
      last = performance.now();
      raf = requestAnimationFrame(frame);
      updateButton();
    };
    const pause = () => {
      playing = false;
      cancelAnimationFrame(raf);
      endTyping();
      updateButton();
    };
    const sync = () => (inView && !userPaused && !document.hidden ? play() : pause());

    toggle.addEventListener('click', () => {
      if (playing) {
        userPaused = true;
        pause();
      } else {
        userPaused = false;
        if (t >= total) t = 0;
        play();
      }
    });
    replay.addEventListener('click', () => {
      t = 0;
      userPaused = false;
      render();
      play();
    });
    document.addEventListener('visibilitychange', sync);

    const updateSound = () => {
      root.classList.toggle('is-sound', sound.enabled);
      soundBtn.setAttribute('aria-pressed', String(sound.enabled));
      soundBtn.setAttribute('aria-label', (sound.enabled ? root.dataset.labelSoundOff : root.dataset.labelSoundOn) ?? '');
      if (!sound.enabled) endTyping();
    };
    soundBtn.addEventListener('click', () => {
      const on = !sound.enabled;
      sound.set(on);
      if (on) {
        // tiếng xác nhận ngắn khi tệp đã sẵn sàng; nếu đang tạm dừng thì phát tiếp
        sound.loading?.then(() => sound.play('send', 0.55));
        if (!playing) {
          userPaused = false;
          if (t >= total) t = 0;
          sync();
        }
      }
    });
    document.addEventListener(SOUND_EVENT, updateSound);
    updateSound();

    // Tự phát khi ít nhất 1/4 khung chat nằm trong màn hình; ra ngoài thì tạm dừng.
    new IntersectionObserver(
      (entries) => {
        const entry = entries[entries.length - 1];
        inView = entry.isIntersecting && entry.intersectionRatio >= 0.25;
        sync();
      },
      { threshold: [0, 0.25, 0.5] },
    ).observe(root);

    root.classList.add('is-player');
    render();
    updateButton();
  }

  if (!reduce.matches) {
    document.querySelectorAll<HTMLElement>('[data-chat]').forEach(setup);
  }
</script>

<style>
  .chat {
    margin: 0;
    max-width: 30rem;
    width: 100%;
  }

  .chat-window {
    position: relative;
    border-radius: 26px;
    border: 1px solid var(--line-strong);
    background:
      radial-gradient(120% 60% at 50% 0%, rgb(72 0 168 / 0.16), transparent 60%),
      #0a0f27;
    overflow: hidden;
    box-shadow:
      var(--shadow-glow),
      inset 0 1px 0 rgb(255 255 255 / 0.05);
  }

  /* ---------- Header ---------- */
  .chat-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--line);
    background: rgb(18 26 64 / 0.75);
  }

  .chat-avatar {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: var(--grad);
    color: #fff;
    font-weight: 800;
    font-size: 0.8125rem;
    flex: none;
  }
  .chat-avatar::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 2px #121a40;
  }

  .chat-who {
    display: grid;
    min-width: 0;
    line-height: 1.35;
    margin-right: auto;
  }
  .chat-who strong {
    font-size: 0.9375rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .chat-status {
    display: grid;
    font-size: 0.8125rem;
    color: var(--text-3);
  }
  .chat-status > span {
    grid-area: 1 / 1;
    transition: opacity 0.2s ease;
  }
  .status-typing {
    opacity: 0;
    color: var(--green-ink);
  }
  .chat.is-typing .status-typing {
    opacity: 1;
  }
  .chat.is-typing .status-via {
    opacity: 0;
  }

  .chat-clock {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    flex: none;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: rgb(7 10 26 / 0.7);
    border: 1px solid var(--line);
    font-size: 0.8125rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--text-2);
  }
  .chat-clock :global(svg) {
    width: 0.9rem;
    height: 0.9rem;
    color: var(--violet-ink);
  }

  /* ---------- Log ---------- */
  .chat-log {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 0.9rem 1rem 1.1rem;
    transition: opacity 0.45s ease;
  }
  .chat.is-fading .chat-log {
    opacity: 0;
  }

  .chat-badge {
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 0.25rem;
    padding: 0.15rem 0.7rem;
    border-radius: 999px;
    border: 1px solid rgb(238 214 90 / 0.45);
    background: rgb(238 214 90 / 0.08);
    color: var(--sun);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.6;
  }
  .chat-badge :global(svg) {
    width: 0.8rem;
    height: 0.8rem;
  }

  .msg {
    position: relative;
    display: flex;
    max-width: 86%;
  }
  .msg-customer {
    align-self: flex-end;
    justify-content: flex-end;
  }
  .msg-ai {
    align-self: flex-start;
  }

  .bubble {
    display: block;
    padding: 0.6rem 0.85rem;
    border-radius: 18px;
    font-size: 0.9375rem;
    line-height: 1.5;
    transition:
      opacity 0.35s ease,
      transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .msg-customer .bubble {
    background: linear-gradient(160deg, #2a33a0, #1d2575);
    border-bottom-right-radius: 6px;
    transform-origin: 100% 100%;
  }
  .msg-ai .bubble {
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-bottom-left-radius: 6px;
    transform-origin: 0 100%;
  }

  .msg-time {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.75rem;
    color: #c3c8ea;
    text-align: right;
  }

  .msg-event {
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    border: 1px solid rgb(0 216 120 / 0.45);
    background: rgb(0 216 120 / 0.07);
    color: var(--green-ink);
    font-size: 0.8125rem;
    font-weight: 600;
    text-align: center;
    transition:
      opacity 0.3s ease,
      transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1.4);
  }
  .msg-event :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
    flex: none;
  }

  /* "đang nhập…": bong bóng nhỏ đè lên chỗ đã chừa sẵn cho câu trả lời */
  .typing {
    position: absolute;
    left: 0;
    top: 0;
    display: none;
    gap: 4px;
    align-items: center;
    padding: 0.85rem 0.95rem;
    border-radius: 18px;
    border-bottom-left-radius: 6px;
    background: var(--surface-2);
    border: 1px solid var(--line);
  }
  .typing i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--text-2);
    animation: dot 1.1s infinite ease-in-out;
  }
  .typing i:nth-child(2) {
    animation-delay: 0.15s;
  }
  .typing i:nth-child(3) {
    animation-delay: 0.3s;
  }
  @keyframes dot {
    0%,
    60%,
    100% {
      transform: translateY(0);
      opacity: 0.45;
    }
    30% {
      transform: translateY(-4px);
