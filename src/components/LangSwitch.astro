---
/**
 * Nút chuyển ngôn ngữ "VI | EN". Link tới đúng trang tương ứng ở ngôn ngữ kia
 * theo bảng đối chiếu trong src/config/i18n.ts. Ngôn ngữ đang xem được làm nổi.
 */
import { counterpart, langs, t } from '../config/i18n';
import type { Lang } from '../config/i18n';

interface Props {
  lang: Lang;
  /** 'lg' = bản lớn trong menu điện thoại */
  size?: 'sm' | 'lg';
}

const { lang, size = 'sm' } = Astro.props;
const s = t(lang);
const path = Astro.url.pathname;

const items = langs.map((code) => ({
  code,
  href: code === lang ? undefined : counterpart(path, code),
  short: code.toUpperCase(),
  name: s.langName[code],
}));
---

<ul class:list={['lang-switch', `lang-switch--${size}`]} aria-label={s.language}>
  {
    items.map((item, i) => (
      <>
        {i > 0 && (
          <li class="ls-sep" aria-hidden="true">
            |
          </li>
        )}
        <li>
          {item.href ? (
            <a href={item.href} lang={item.code} hreflang={item.code} class="ls-item">
              {size === 'lg' ? item.name : item.short}
              {size !== 'lg' && <span class="visually-hidden"> – {item.name}</span>}
            </a>
          ) : (
            <span class="ls-item is-active" aria-current="true" lang={item.code}>
              {size === 'lg' ? item.name : item.short}
              {size !== 'lg' && <span class="visually-hidden"> – {item.name}</span>}
            </span>
          )}
        </li>
      </>
    ))
  }
</ul>

<style>
  .lang-switch {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.1rem;
    margin: 0;
    padding: 0;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .ls-sep {
    color: var(--line-strong);
    font-weight: 400;
  }

  .ls-item {
    display: inline-grid;
    place-items: center;
    min-width: 36px;
    min-height: 40px;
    padding: 0 0.35rem;
    border-radius: var(--r-sm);
    color: var(--text-3);
    text-decoration: none;
  }
  a.ls-item:hover {
    color: var(--text);
    background: rgb(var(--ov) / 0.06);
  }
  .ls-item.is-active {
    color: var(--text);
    box-shadow: inset 0 -2px 0 var(--green);
    border-radius: 0;
  }

  .lang-switch--lg {
    font-size: 1rem;
    letter-spacing: 0;
    gap: 0.5rem;
  }
  .lang-switch--lg .ls-item {
    min-height: 44px;
    padding: 0 0.75rem;
  }
</style>
