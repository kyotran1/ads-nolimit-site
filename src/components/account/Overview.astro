---
/** Tổng quan: lời chào, 4 ô số liệu, 3 bước bắt đầu, giao dịch gần đây. Dữ liệu: src/lib/account/overview.ts */
import Icon from '../Icon.astro';
import { primaryChannel } from '../../config/site';
import type { Lang } from '../../config/i18n';
import { hashFor } from '../../lib/account/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const h = (id: Parameters<typeof hashFor>[0]) => hashFor(id, lang);
const support = primaryChannel[lang];

const copy = {
  vi: {
    eyebrow: 'Trung tâm tài khoản',
    hello: 'Xin chào!',
    lead: 'Nạp số dư một lần, đặt dịch vụ, theo dõi đơn hàng, học khóa học và quản lý key phần mềm, tất cả ở một nơi.',
    topUp: 'Nạp tiền',
    order: 'Đặt dịch vụ',
    support: 'Liên hệ hỗ trợ',
    stats: 'Số liệu tài khoản',
    balance: 'Số dư',
    orders: 'Đơn hàng',
    keys: 'Key & máy',
    courses: 'Khóa học',
    stepsTitle: '3 bước bắt đầu',
    steps: [
      { icon: 'wallet', title: 'Nạp tiền', text: 'Tạo lệnh nạp, quét mã VietQR bằng app ngân hàng. ADS-Nolimit xác nhận là số dư được cộng.', cta: 'Nạp tiền', to: h('topup') },
      { icon: 'spark', title: 'Chọn dịch vụ', text: 'Chọn AI Agent, quảng cáo, khóa học… thanh toán ngay bằng số dư hoặc gửi yêu cầu tư vấn.', cta: 'Chọn dịch vụ', to: h('services') },
      { icon: 'bolt', title: 'ADS-Nolimit triển khai', text: 'Đội ngũ liên hệ bạn để bắt tay vào việc. Theo dõi tiến độ ở mục Đơn hàng.', cta: 'Xem đơn hàng', to: h('orders') },
    ],
    recent: 'Giao dịch gần đây',
    seeAll: 'Xem tất cả',
  },
  en: {
    eyebrow: 'Account centre',
    hello: 'Hello!',
    lead: 'Top up once, order services, track your orders, take courses and manage your software keys, all in one place.',
    topUp: 'Top up',
    order: 'Order a service',
    support: 'Contact support',
    stats: 'Account summary',
    balance: 'Balance',
    orders: 'Orders',
    keys: 'Keys & devices',
    courses: 'Courses',
    stepsTitle: 'Get started in 3 steps',
    steps: [
      { icon: 'wallet', title: 'Top up', text: 'Create a top-up and scan the VietQR code with your banking app. Your balance is credited once we confirm.', cta: 'Top up', to: h('topup') },
      { icon: 'spark', title: 'Choose a service', text: 'AI agents, advertising, courses… pay straight from your balance or ask for a consultation.', cta: 'Choose a service', to: h('services') },
      { icon: 'bolt', title: 'ADS-Nolimit delivers', text: 'Our team contacts you to get started. Follow progress under Orders.', cta: 'View orders', to: h('orders') },
    ],
    recent: 'Recent transactions',
    seeAll: 'See all',
  },
}[lang];

const stats = [
  { id: 'balance', icon: 'wallet', tone: 'tone-green', label: copy.balance, to: h('topup') },
  { id: 'orders', icon: 'bag', tone: 'tone-blue', label: copy.orders, to: h('orders') },
  { id: 'keys', icon: 'key', tone: 'tone-violet', label: copy.keys, to: h('keys') },
  { id: 'courses', icon: 'book', tone: 'tone-teal', label: copy.courses, to: h('courses') },
] as const;
---

<section class="view" data-view="overview" hidden>
  <div class="welcome">
    <div class="welcome-text">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2 class="welcome-title" id="ov-hello">{copy.hello}</h2>
      <p class="welcome-lead">{copy.lead}</p>
      <div class="btn-row welcome-actions">
        <a class="btn btn-primary" href={h('topup')}><Icon name="wallet" />{copy.topUp}</a>
        <a class="btn" href={h('services')}><Icon name="spark" />{copy.order}</a>
        <a class="btn btn-ghost" href={support.href} rel="noopener" target="_blank"><Icon name={support.icon} />{copy.support}</a>
      </div>
    </div>
    <div class="welcome-art" aria-hidden="true">
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
      <span class="ring ring-3"></span>
      <svg class="welcome-infinity" viewBox="0 0 120 60" fill="none">
        <defs>
          <linearGradient id="wl-grad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#a58cff"></stop>
            <stop offset="0.45" stop-color="#8592ff"></stop>
            <stop offset="0.75" stop-color="#3fd0c2"></stop>
            <stop offset="1" stop-color="#2ee89a"></stop>
          </linearGradient>
        </defs>
        <path
          d="M60 30c-9-12-17-18-27-18a18 18 0 0 0 0 36c10 0 18-6 27-18Zm0 0c9 12 17 18 27 18a18 18 0 0 0 0-36c-10 0-18 6-27 18Z"
          stroke="url(#wl-grad)"
          stroke-width="7"
          stroke-linecap="round"></path>
      </svg>
    </div>
  </div>

  <div class="ov-pending ov-ads-low" id="ov-ads-low" role="status" hidden></div>
  <div class="ov-pending" id="ov-pending" hidden>
    <Icon name="clock" />
    <p id="ov-pending-text"></p>
    <a class="btn btn-sm btn-sun" href={h('topup')} id="ov-pending-link"></a>
  </div>

  <h2 class="visually-hidden">{copy.stats}</h2>
  <div class="stats">
    {
      stats.map((s) => (
        <a class:list={['stat', s.tone]} href={s.to} data-glow>
          <span class="stat-head">
            <span class="icon-tile">
              <Icon name={s.icon} />
            </span>
            <span class="stat-label">{s.label}</span>
          </span>
          <strong class="stat-value" id={`ov-${s.id}`} data-bind={s.id === 'balance' ? 'balance' : undefined}>
            —
          </strong>
          <span class="stat-sub">
            <span id={`ov-${s.id}-sub`} />
            <Icon name="arrow" />
          </span>
        </a>
      ))
    }
  </div>

  <section class="steps3" aria-labelledby="ov-steps-title">
    <h2 class="sub-title" id="ov-steps-title">{copy.stepsTitle}</h2>
    <ol>
      {
        copy.steps.map((step, i) => (
          <li class="step3" data-glow>
            <span class="step3-num" aria-hidden="true">
              {i + 1}
            </span>
            <span class="step3-icon" aria-hidden="true">
              <Icon name={step.icon as 'wallet'} />
            </span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
            <a class="text-link" href={step.to}>
              {step.cta}
              <Icon name="arrow" />
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="panel" aria-labelledby="ov-tx-title">
    <div class="panel-head">
      <h2 id="ov-tx-title">{copy.recent}</h2>
      <a class="text-link" href={h('topup')}>{copy.seeAll}<Icon name="arrow" /></a>
    </div>
    <div class="auth-alert" role="alert" id="ov-tx-alert"></div>
    <ul class="ledger" id="ov-tx"></ul>
  </section>
</section>
