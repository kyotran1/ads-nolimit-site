---
import { Image } from 'astro:assets';
import logoMark from '../assets/brand/logo-mark.png';
import Icon from './Icon.astro';
import { site, solutionsNav, mainNav } from '../config/site';

interface Props {
  lang?: 'vi' | 'en';
}
const { lang = 'vi' } = Astro.props;

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
const inSolutions = solutionsNav.some((item) => isCurrent(item.href));
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${site.name}, về trang chủ`}>
      <Image src={logoMark} alt="" width={52} densities={[1, 2]} loading="eager" class="brand-mark" />
      <span class="brand-name">ADS-Nolimit</span>
    </a>

    {lang === 'vi' && (
    <nav class="nav-desktop" aria-label="Điều hướng chính">
      <ul class="nav-list">
        <li>
          <details class="dd" data-dismissable>
            <summary class:list={['nav-link', { 'is-current': inSolutions }]}>
              Giải pháp <Icon name="chevron" class="dd-chevron" />
            </summary>
            <ul class="dd-panel">
              {
                solutionsNav.map((item) => (
                  <li>
                    <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
        </li>
        {
          mainNav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['nav-link', { 'is-current': isCurrent(item.href) }]}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    )}

    <div class="header-actions">
      {
        lang === 'vi' ? (
          <a href="/en/" class="lang-switch" lang="en" hreflang="en">
            EN
          </a>
        ) : (
          <a href="/" class="lang-switch" lang="vi" hreflang="vi">
            VI
          </a>
        )
      }
      <a href={lang === 'en' ? '/en/#contact' : '/lien-he/'} class="btn btn-primary btn-sm header-cta">
        {lang === 'en' ? 'Contact us' : 'Tư vấn miễn phí'}
      </a>

      {lang === 'vi' && (
      <details class="nav-mobile" data-dismissable>
        <summary class="menu-toggle" aria-label="Mở menu">
          <Icon name="menu" />
          <span>Menu</span>
        </summary>
        <nav class="mobile-panel" aria-label="Điều hướng trên điện thoại">
          <p class="mobile-group">Giải pháp</p>
          <ul>
            {
              solutionsNav.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="mobile-group">ADS-Nolimit</p>
          <ul>
            {
              mainNav.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a href="/lien-he/" aria-current={isCurrent('/lien-he/') ? 'page' : undefined}>Liên hệ</a>
            </li>
            <li>
              <a href="/en/" lang="en" hreflang="en">English</a>
            </li>
          </ul>
        </nav>
      </details>
      )}
    </div>
  </div>
</header>

<script>
  // Đóng menu/dropdown khi bấm ra ngoài hoặc nhấn Esc. Không có JS menu vẫn dùng được.
  const menus = document.querySelectorAll<HTMLDetailsElement>('details[data-dismissable]');
  document.addEventListener('click', (event) => {
    menus.forEach((menu) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    menus.forEach((menu) => {
      if (menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(7 10 26 / 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--text);
    margin-right: auto;
    flex: none;
  }

  .brand-mark {
    width: 52px;
    height: auto;
  }

  .brand-name {
    font-weight: 800;
    font-size: 1.125rem;
    letter-spacing: -0.01em;
  }

  .nav-desktop {
    display: none;
  }

  .nav-list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--r-sm);
    color: var(--text-2);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9688rem;
    cursor: pointer;
    list-style: none;
  }
  .nav-link::-webkit-details-marker {
    display: none;
  }
  .nav-link:hover,
  .nav-link.is-current {
    color: var(--text);
  }
  .nav-link.is-current {
    box-shadow: inset 0 -2px 0 var(--green);
    border-radius: 0;
  }

  .dd {
    position: relative;
  }
  .dd > summary {
    list-style: none;
  }
  .dd-chevron {
    width: 1rem;
    height: 1rem;
    transition: transform 0.15s ease;
  }
  .dd[open] .dd-chevron {
    transform: rotate(180deg);
  }
  .dd-panel {
    position: absolute;
    top: calc(100% + 10px);
    left: -0.5rem;
    min-width: 19rem;
    list-style: none;
    padding: 0.5rem;
    background: var(--bg-raise);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-md);
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.45);
  }
  .dd-panel a {
    display: block;
    padding: 0.6rem 0.75rem;
    border-radius: var(--r-sm);
    color: var(--text);
    text-decoration: none;
    font-size: 0.9688rem;
  }
  .dd-panel a:hover,
  .dd-panel a[aria-current='page'] {
    background: var(--bg-raise-2);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    min-height: 40px;
    color: var(--text-2);
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    border-radius: var(--r-sm);
  }
  .lang-switch:hover {
    color: var(--text);
  }

  .header-cta {
    display: none;
  }

  .nav-mobile {
    position: static;
  }
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0 0.85rem;
    border: 1.5px solid var(--line-strong);
    border-radius: 12px;
    color: var(--text);
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;
    list-style: none;
  }
  .menu-toggle::-webkit-details-marker {
    display: none;
  }
  .menu-toggle svg {
    width: 1.2rem;
    height: 1.2rem;
  }
  .nav-mobile[open] .menu-toggle {
    border-color: var(--green);
  }

  .mobile-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    max-height: calc(100vh - var(--header-h) - var(--bar-h));
    max-height: calc(100dvh - var(--header-h) - var(--bar-h) - env(safe-area-inset-bottom, 0px));
    overflow-y: auto;
    padding: 0.5rem var(--gutter) 1.5rem;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .mobile-panel ul {
    list-style: none;
  }
  .mobile-panel a {
    display: block;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
  }
  .mobile-panel a[aria-current='page'] {
    color: var(--green-ink);
  }
  .mobile-group {
    margin-top: 1rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-3);
  }

  @media (min-width: 560px) {
    .header-cta {
      display: inline-flex;
    }
  }

  @media (min-width: 1080px) {
    .nav-desktop {
      display: block;
    }
    .nav-mobile {
      display: none;
    }
    .brand {
      margin-right: 1rem;
    }
    .nav-desktop {
      margin-right: auto;
    }
  }
</style>
