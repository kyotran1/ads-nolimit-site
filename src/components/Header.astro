---
import { Image } from 'astro:assets';
import logoMark from '../assets/brand/logo-mark.png';
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
import AccountLink from './AccountLink.astro';
import { site, solutionsNav, mainNav } from '../config/site';
import { homeOf, localize, normalizePath, t } from '../config/i18n';
import type { Lang } from '../config/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'vi' } = Astro.props;
const s = t(lang);

const path = normalizePath(Astro.url.pathname);
const home = homeOf[lang];
const isCurrent = (href: string) => path === href || (href !== home && path.startsWith(href));

const solutions = solutionsNav.map((item) => ({ href: localize(item.href, lang), label: item.label[lang] }));
const main = mainNav.map((item) => ({ href: localize(item.href, lang), label: item.label[lang] }));
const contactHref = localize('/lien-he/', lang);
const inSolutions = solutions.some((item) => isCurrent(item.href));
// Hàng dưới (Đăng nhập | Tạo tài khoản) không cần ở chính các trang tài khoản / đăng nhập / đăng ký.
const accountPaths = ['/dang-nhap/', '/dang-ky/', '/quen-mat-khau/', '/tai-khoan/'].map((p) => localize(p, lang));
const showRow2 = !accountPaths.includes(path);
---

<header class="site-header">
  <div class="container header-inner">
    <a href={home} class="brand" aria-label={`${site.name}, ${s.home}`}>
      <Image src={logoMark} alt="" width={52} densities={[1, 2]} loading="eager" class="brand-mark" />
      <span class="brand-name">ADS-Nolimit</span>
    </a>

    <nav class="nav-desktop" aria-label={s.mainNav}>
      <ul class="nav-list">
        <li>
          <details class="dd" data-dismissable>
            <summary class:list={['nav-link', { 'is-current': inSolutions }]}>
              {s.solutions} <Icon name="chevron" class="dd-chevron" />
            </summary>
            <ul class="dd-panel">
              {
                solutions.map((item) => (
                  <li>
                    <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
        </li>
        {
          main.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['nav-link', { 'is-current': isCurrent(item.href) }]}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <LangSwitch lang={lang} />
      <button
        type="button"
        class="theme-toggle"
        aria-label={s.themeToLight}
        title={s.themeToLight}
        data-label-to-light={s.themeToLight}
        data-label-to-dark={s.themeToDark}
      >
        <Icon name="sun" class="theme-ic theme-ic-sun" />
        <Icon name="moon" class="theme-ic theme-ic-moon" />
      </button>
      <AccountLink lang={lang} variant="desktop" />
      <a href={contactHref} class="btn btn-primary btn-sm header-cta">{s.headerCta}</a>

      <details class="nav-mobile" data-dismissable>
        <summary class="menu-toggle" aria-label={s.openMenu}>
          <Icon name="menu" />
          <span>{s.menu}</span>
        </summary>
        <nav class="mobile-panel" aria-label={s.mobileNav}>
          <p class="mobile-group">{s.account}</p>
          <div class="mobile-acct">
            <AccountLink lang={lang} variant="mobile" />
            <a href={localize('/dang-ky/', lang)} class="btn mobile-signup">{s.signUp}</a>
            <button type="button" class="btn mobile-app install-entry" data-install-app>
              <Icon name="download" />{s.getAppMenu}
            </button>
          </div>
          <p class="mobile-group">{s.language}</p>
          <LangSwitch lang={lang} size="lg" />
          <p class="mobile-group">{s.solutions}</p>
          <ul>
            {
              solutions.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="mobile-group">{s.company}</p>
          <ul>
            {
              main.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a href={contactHref} aria-current={isCurrent(contactHref) ? 'page' : undefined}>{s.contact}</a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
{
  /* Hàng dưới của thanh đầu trang (< 1080px): cùng nền với thanh đầu trang, không dính khi cuộn (trôi theo trang). */
  showRow2 && (
    <div class="header-row2">
      <div class="container row2-inner">
        <AccountLink lang={lang} variant="bar" />
        <a href={localize('/dang-ky/', lang)} class="btn row2-signup">
          {s.signUp}
        </a>
        <button type="button" class="btn row2-app install-entry" data-install-app aria-label={s.getAppMenu}>
          <Icon name="download" /><span class="row2-app-label">{s.getApp}</span>
        </button>
      </div>
    </div>
  )
}

<script>
  // Nút sáng/tối: đổi thuộc tính data-theme trên <html>, nhớ lựa chọn (khóa adsnl-theme), đổi màu thanh trình duyệt,
  // rồi phát sự kiện 'adsnl-theme' trên window để phần khác (vd khung trợ lý AI) biết. Lỗi localStorage → vẫn đổi được, chỉ không nhớ.
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const syncToggle = () => {
    if (!toggle) return;
    const light = document.documentElement.getAttribute('data-theme') === 'light';
    const label = (light ? toggle.dataset.labelToDark : toggle.dataset.labelToLight) ?? '';
    toggle.setAttribute('aria-label', label);
    toggle.setAttribute('title', label);
  };
  syncToggle();
  // Sau khi đổi thuộc tính data-theme: màu thanh trình duyệt, nhãn nút, sự kiện cho phần khác.
  const applyTheme = (theme: 'light' | 'dark') => {
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'light' ? '#f6f7fb' : '#070a1a');
    syncToggle();
    window.dispatchEvent(new CustomEvent('adsnl-theme', { detail: { theme } }));
  };
  toggle?.addEventListener('click', () => {
    const next = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    if (next === 'light') document.documentElement.setAttribute('data-theme', 'light');
    else document.documentElement.removeAttribute('data-theme');
    try {
      localStorage.setItem('adsnl-theme', next);
    } catch {
      /* bị chặn: chỉ không nhớ được lựa chọn */
    }
    applyTheme(next);
  });

  // Đồng bộ khi khách đổi giao diện ở tab khác, hoặc bấm Quay lại (trang lấy từ bộ nhớ đệm bfcache còn giao diện cũ).
  const readSaved = (): 'light' | 'dark' => {
    try {
      return localStorage.getItem('adsnl-theme') === 'light' ? 'light' : 'dark';
    } catch {
      return document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
    }
  };
  const resync = () => {
    const saved = readSaved();
    const now = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
    if (saved === now) return;
    if (saved === 'light') document.documentElement.setAttribute('data-theme', 'light');
    else document.documentElement.removeAttribute('data-theme');
    applyTheme(saved);
  };
  window.addEventListener('storage', (e) => {
    if (!e.key || e.key === 'adsnl-theme') resync();
  });
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) resync();
  });

  // Đóng menu/dropdown khi bấm ra ngoài hoặc nhấn Esc. Không có JS menu vẫn dùng được.
  const menus = document.querySelectorAll<HTMLDetailsElement>('details[data-dismissable]');
  document.addEventListener('click', (event) => {
    menus.forEach((menu) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    menus.forEach((menu) => {
      if (menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(var(--scrim) / 0.82);
    backdrop-filter: saturate(140%) blur(16px);
    -webkit-backdrop-filter: saturate(140%) blur(16px);
    border-bottom: 1px solid rgb(var(--ov) / 0.06);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text);
    margin-right: auto;
    flex: none;
  }

  .brand-mark {
    width: 44px;
    height: auto;
  }

  .brand-name {
    font-weight: 800;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }

  .nav-desktop {
    display: none;
  }

  .nav-list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 40px;
    padding: 0.4rem 0.75rem;
    border-radius: var(--r-sm);
    color: var(--text-2);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;
    list-style: none;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }
  .nav-link::-webkit-details-marker {
    display: none;
  }
  .nav-link:hover {
    color: var(--text);
    background: rgb(var(--ov) / 0.05);
  }
  .nav-link.is-current {
    color: var(--text);
  }
  .nav-link.is-current::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 2px;
    height: 2px;
    border-radius: 2px;
    background: var(--green);
  }

  .dd {
    position: relative;
  }
  .dd > summary {
    list-style: none;
  }
  .dd-chevron {
    width: 1rem;
    height: 1rem;
    transition: transform 0.15s ease;
  }
  .dd[open] .dd-chevron {
    transform: rotate(180deg);
  }
  .dd-panel {
    position: absolute;
    top: calc(100% + 12px);
    left: -0.5rem;
    min-width: 18.5rem;
    list-style: none;
    padding: 0.4rem;
    background: var(--surface-2);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-lg);
  }
  .dd-panel a {
    display: block;
    padding: 0.6rem 0.75rem;
    border-radius: var(--r-sm);
    color: var(--text);
    text-decoration: none;
    font-size: 0.9375rem;
  }
  .dd-panel a:hover,
  .dd-panel a[aria-current='page'] {
    background: rgb(var(--ov) / 0.06);
  }
  .dd-panel a[aria-current='page'] {
    box-shadow: inset 2px 0 0 var(--green);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .header-cta {
    display: none;
  }

  .theme-toggle {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-sm);
    background: transparent;
    color: var(--text-2);
    cursor: pointer;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }
  .theme-toggle:hover {
    color: var(--text);
    background: rgb(var(--ov) / 0.05);
  }
  .theme-toggle :global(.theme-ic) {
    grid-area: 1 / 1;
    width: 1.2rem;
    height: 1.2rem;
  }
  /* Đang tối: hiện mặt trời (bấm để sáng). Đang sáng: hiện mặt trăng (bấm để tối). */
  .theme-toggle :global(.theme-ic-moon) {
    display: none;
  }
  :global(:root[data-theme='light']) .theme-toggle :global(.theme-ic-sun) {
    display: none;
  }
  :global(:root[data-theme='light']) .theme-toggle :global(.theme-ic-moon) {
    display: block;
  }

  .nav-mobile {
    position: static;
  }
  .menu-toggle {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0 0.8rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-sm);
    color: var(--text);
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;
    list-style: none;
  }
  .menu-toggle::-webkit-details-marker {
    display: none;
  }
  .menu-toggle svg {
    width: 1.2rem;
    height: 1.2rem;
  }
  .nav-mobile[open] .menu-toggle {
    border-color: var(--green);
  }

  .mobile-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    max-height: calc(100vh - var(--header-h) - var(--bar-h));
    max-height: calc(100dvh - var(--header-h) - var(--bar-h) - env(safe-area-inset-bottom, 0px));
    overflow-y: auto;
    padding: 0.25rem var(--gutter) 1.5rem;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
  }
  .mobile-panel ul {
    list-style: none;
  }
  .mobile-panel ul a {
    display: block;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
  }
  .mobile-panel ul a[aria-current='page'] {
    color: var(--green-ink);
  }
  .mobile-group {
    margin: 1.25rem 0 0.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-3);
  }
  .mobile-panel :global(.lang-switch) {
    margin-top: 0.5rem;
  }

  /* Tài khoản ở đầu menu: chưa đăng nhập → "Đăng nhập" | "Tạo tài khoản"; đã đăng nhập → ảnh + tên */
  .mobile-acct {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }
  .mobile-signup {
    min-height: 48px;
  }
  .mobile-acct :global(.acct.is-in) {
    grid-column: 1 / -1;
  }
  .mobile-acct :global(.acct.is-in) ~ .mobile-signup {
    display: none;
  }
  .mobile-app {
    grid-column: 1 / -1;
    min-height: 48px;
    flex: none;
  }

  /* Hàng dưới của thanh đầu trang (< 1080px): "Đăng nhập" | "Tạo tài khoản" */
  .header-row2 {
    position: relative;
    z-index: 2;
    padding: 0.6rem 0;
    background: rgb(var(--scrim) / 0.92);
    border-bottom: 1px solid rgb(var(--ov) / 0.06);
  }
  .row2-inner {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 0.6rem;
  }
  .row2-signup {
    min-height: 44px;
    padding-inline: 0.75rem;
    font-size: 0.9375rem;
    white-space: nowrap;
  }
  .row2-inner :global(.acct.is-in) {
    grid-column: 1 / -1;
  }
  .row2-inner :global(.acct.is-in) ~ .row2-signup {
    display: none;
  }
  /* Nút "Tải app" luôn thấy ở hàng dưới (ẩn khi đã ở trong app: <html data-pwa>, xem global.css) */
  .row2-app {
    flex: none;
    min-height: 44px;
    min-width: 44px;
    padding-inline: 0.85rem;
    font-size: 0.9375rem;
    white-space: nowrap;
  }
  .row2-app :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }
  /* Đã đăng nhập: nút Tài khoản chiếm phần còn lại, nút app nằm bên phải */
  .row2-inner:has(:global(.acct.is-in)) {
    grid-template-columns: 1fr auto;
  }
  .row2-inner:has(:global(.acct.is-in)) :global(.acct.is-in) {
    grid-column: 1 / 2;
  }
  /* Đang ở trong app: không còn nút app, hai nút kia chia đều như cũ */
  :global(:root[data-pwa]) .row2-inner {
    grid-template-columns: 1fr 1fr;
  }
  :global(:root[data-pwa]) .row2-inner:has(:global(.acct.is-in)) {
    grid-template-columns: 1fr;
  }
  :global(:root[data-pwa]) .row2-inner:has(:global(.acct.is-in)) :global(.acct.is-in) {
    grid-column: 1 / -1;
  }
  /* Điện thoại (< 480px): 3 nút chung một hàng, chữ nhỏ lại một nấc, bỏ biểu tượng người ở nút Đăng nhập cho đủ chỗ */
  @media (max-width: 479.98px) {
    .row2-signup,
    .row2-app,
    .row2-inner :global(.acct--bar) {
      font-size: 0.875rem;
      padding-inline: 0.5rem;
    }
    .row2-app {
      gap: 0.4rem;
    }
    .row2-inner :global(.acct--bar:not(.is-in) .acct-avatar) {
      display: none;
    }
  }
  @media (max-width: 359.98px) {
    .row2-inner {
      gap: 0.5rem;
    }
    .row2-signup {
      padding-inline: 0.5rem;
    }
    /* Hẹp: nút app chỉ còn biểu tượng (nhãn vẫn đọc được bằng trình đọc màn hình), cao ≥ 44px */
    .row2-app {
      padding-inline: 0.6rem;
    }
    .row2-app-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* Điện thoại (≤ 479px): có thêm nút sáng/tối nên nút Menu chỉ còn icon (nhãn đọc màn hình vẫn có). */
  @media (max-width: 479.98px) {
    .menu-toggle {
      padding: 0 0.7rem;
    }
    .menu-toggle span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }

  /* Điện thoại hẹp (< 380px): tên thương hiệu nhỏ lại, các nút sát hơn. */
  @media (max-width: 379.98px) {
    .header-inner {
      gap: 0.4rem;
    }
    .brand-mark {
      width: 38px;
    }
    .brand-name {
      font-size: 1rem;
    }
    .header-actions {
      gap: 0.35rem;
    }
    /* Hàng trên chỉ còn logo | sáng/tối | Menu; VI/EN nằm ở mục thứ hai trong Menu. */
    .header-actions > :global(.lang-switch) {
      display: none;
    }
  }

  @media (min-width: 560px) {
    .header-cta {
      display: inline-flex;
    }
  }

  @media (min-width: 1080px) {
    .header-row2 {
      display: none;
    }
    .nav-desktop {
      display: block;
    }
    .nav-mobile {
      display: none;
    }
    .brand {
      margin-right: 1.25rem;
    }
    .nav-desktop {
      margin-right: auto;
    }
    .header-actions {
      gap: 0.75rem;
    }
  }
</style>
