---
import { Image } from 'astro:assets';
import logoMark from '../assets/brand/logo-mark.png';
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
import { site, solutionsNav, mainNav } from '../config/site';
import { homeOf, localize, normalizePath, t } from '../config/i18n';
import type { Lang } from '../config/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'vi' } = Astro.props;
const s = t(lang);

const path = normalizePath(Astro.url.pathname);
const home = homeOf[lang];
const isCurrent = (href: string) => path === href || (href !== home && path.startsWith(href));

const solutions = solutionsNav.map((item) => ({ href: localize(item.href, lang), label: item.label[lang] }));
const main = mainNav.map((item) => ({ href: localize(item.href, lang), label: item.label[lang] }));
const contactHref = localize('/lien-he/', lang);
const inSolutions = solutions.some((item) => isCurrent(item.href));
---

<header class="site-header">
  <div class="container header-inner">
    <a href={home} class="brand" aria-label={`${site.name}, ${s.home}`}>
      <Image src={logoMark} alt="" width={52} densities={[1, 2]} loading="eager" class="brand-mark" />
      <span class="brand-name">ADS-Nolimit</span>
    </a>

    <nav class="nav-desktop" aria-label={s.mainNav}>
      <ul class="nav-list">
        <li>
          <details class="dd" data-dismissable>
            <summary class:list={['nav-link', { 'is-current': inSolutions }]}>
              {s.solutions} <Icon name="chevron" class="dd-chevron" />
            </summary>
            <ul class="dd-panel">
              {
                solutions.map((item) => (
                  <li>
                    <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
        </li>
        {
          main.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['nav-link', { 'is-current': isCurrent(item.href) }]}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <LangSwitch lang={lang} />
      <a href={contactHref} class="btn btn-primary btn-sm header-cta">{s.headerCta}</a>

      <details class="nav-mobile" data-dismissable>
        <summary class="menu-toggle" aria-label={s.openMenu}>
          <Icon name="menu" />
          <span>{s.menu}</span>
        </summary>
        <nav class="mobile-panel" aria-label={s.mobileNav}>
          <p class="mobile-group">{s.solutions}</p>
          <ul>
            {
              solutions.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="mobile-group">{s.company}</p>
          <ul>
            {
              main.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a href={contactHref} aria-current={isCurrent(contactHref) ? 'page' : undefined}>{s.contact}</a>
            </li>
          </ul>
          <p class="mobile-group">{s.language}</p>
          <LangSwitch lang={lang} size="lg" />
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Đóng menu/dropdown khi bấm ra ngoài hoặc nhấn Esc. Không có JS menu vẫn dùng được.
  const menus = document.querySelectorAll<HTMLDetailsElement>('details[data-dismissable]');
  document.addEventListener('click', (event) => {
    menus.forEach((menu) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    menus.forEach((menu) => {
      if (menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(7 10 26 / 0.82);
    backdrop-filter: saturate(140%) blur(16px);
    -webkit-backdrop-filter: saturate(140%) blur(16px);
    border-bottom: 1px solid rgb(255 255 255 / 0.06);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text);
    margin-right: auto;
    flex: none;
  }

  .brand-mark {
    width: 44px;
    height: auto;
  }

  .brand-name {
    font-weight: 800;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }

  .nav-desktop {
    display: none;
  }

  .nav-list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 40px;
    padding: 0.4rem 0.75rem;
    border-radius: var(--r-sm);
    color: var(--text-2);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;
    list-style: none;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }
  .nav-link::-webkit-details-marker {
    display: none;
  }
  .nav-link:hover {
    color: var(--text);
    background: rgb(255 255 255 / 0.05);
  }
  .nav-link.is-current {
    color: var(--text);
  }
  .nav-link.is-current::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 2px;
    height: 2px;
    border-radius: 2px;
    background: var(--green);
  }

  .dd {
    position: relative;
  }
  .dd > summary {
    list-style: none;
  }
  .dd-chevron {
    width: 1rem;
    height: 1rem;
    transition: transform 0.15s ease;
  }
  .dd[open] .dd-chevron {
    transform: rotate(180deg);
  }
  .dd-panel {
    position: absolute;
    top: calc(100% + 12px);
    left: -0.5rem;
    min-width: 18.5rem;
    list-style: none;
    padding: 0.4rem;
    background: var(--surface-2);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-lg);
  }
  .dd-panel a {
    display: block;
    padding: 0.6rem 0.75rem;
    border-radius: var(--r-sm);
    color: var(--text);
    text-decoration: none;
    font-size: 0.9375rem;
  }
  .dd-panel a:hover,
  .dd-panel a[aria-current='page'] {
    background: rgb(255 255 255 / 0.06);
  }
  .dd-panel a[aria-current='page'] {
    box-shadow: inset 2px 0 0 var(--green);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .header-cta {
    display: none;
  }

  .nav-mobile {
    position: static;
  }
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0 0.8rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-sm);
    color: var(--text);
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;
    list-style: none;
  }
  .menu-toggle::-webkit-details-marker {
    display: none;
  }
  .menu-toggle svg {
    width: 1.2rem;
    height: 1.2rem;
  }
  .nav-mobile[open] .menu-toggle {
    border-color: var(--green);
  }

  .mobile-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    max-height: calc(100vh - var(--header-h) - var(--bar-h));
    max-height: calc(100dvh - var(--header-h) - var(--bar-h) - env(safe-area-inset-bottom, 0px));
    overflow-y: auto;
    padding: 0.25rem var(--gutter) 1.5rem;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
  }
  .mobile-panel ul {
    list-style: none;
  }
  .mobile-panel ul a {
    display: block;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
  }
  .mobile-panel ul a[aria-current='page'] {
    color: var(--green-ink);
  }
  .mobile-group {
    margin: 1.25rem 0 0.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-3);
  }
  .mobile-panel :global(.lang-switch) {
    margin-top: 0.5rem;
  }

  /* Điện thoại rất hẹp (≤ 379px): nút Menu chỉ còn icon, tên thương hiệu nhỏ lại. */
  @media (max-width: 379.98px) {
    .header-inner {
      gap: 0.4rem;
    }
    .brand-mark {
      width: 38px;
    }
    .brand-name {
      font-size: 1rem;
    }
    .menu-toggle {
      padding: 0 0.7rem;
    }
    .menu-toggle span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }

  @media (min-width: 560px) {
    .header-cta {
      display: inline-flex;
    }
  }

  @media (min-width: 1080px) {
    .nav-desktop {
      display: block;
    }
    .nav-mobile {
      display: none;
    }
    .brand {
      margin-right: 1.25rem;
    }
    .nav-desktop {
      margin-right: auto;
    }
    .header-actions {
      gap: 0.75rem;
    }
  }
</style>
