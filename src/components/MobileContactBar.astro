---
/**
 * Thanh liên hệ nổi trên điện thoại.
 * Tiếng Việt: Zalo · Gọi · Messenger. Tiếng Anh: Telegram · Zalo · Email
 * (khách nước ngoài thường dùng Telegram/email hơn gọi số Việt Nam).
 */
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';
import { links } from '../config/site';
import { t } from '../config/i18n';
import type { Lang } from '../config/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'vi' } = Astro.props;
const s = t(lang);

const items: { href: string; icon: IconName; label: string; main?: boolean; external?: boolean }[] =
  lang === 'en'
    ? [
        { href: links.telegram, icon: 'telegram', label: 'Telegram', main: true, external: true },
        { href: links.zalo, icon: 'zalo', label: 'Zalo', external: true },
        { href: links.email, icon: 'mail', label: 'Email' },
      ]
    : [
        { href: links.zalo, icon: 'zalo', label: 'Zalo', main: true, external: true },
        { href: links.hotline, icon: 'phone', label: s.call },
        { href: links.messenger, icon: 'messenger', label: 'Messenger', external: true },
      ];
---

<nav class="contact-bar" aria-label={s.quickContact}>
  {
    items.map((item) => (
      <a href={item.href} class:list={{ 'cb-main': item.main }} rel={item.external ? 'noopener' : undefined}>
        <Icon name={item.icon} />
        <span>{item.label}</span>
      </a>
    ))
  }
</nav>

<style>
  .contact-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    padding: 8px 12px calc(8px + env(safe-area-inset-bottom, 0px));
    background: rgb(var(--scrim) / 0.92);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    border-top: 1px solid rgb(var(--ov) / 0.07);
  }

  .contact-bar a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-width: 0;
    min-height: 48px;
    padding-inline: 4px;
    border-radius: var(--r-sm);
    border: 1px solid var(--line-strong);
    background: rgb(var(--ov) / 0.03);
    color: var(--text);
    font-weight: 700;
    font-size: 0.875rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .contact-bar svg {
    width: 1.15rem;
    height: 1.15rem;
    flex: none;
  }

  .contact-bar .cb-main {
    background: var(--green);
    border-color: var(--green);
    color: var(--on-green);
  }

  @media (min-width: 960px) {
    .contact-bar {
      display: none;
    }
  }
</style>
