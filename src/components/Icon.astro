---
/**
 * Bộ icon nét tự vẽ (không dùng logo thương hiệu của nền tảng).
 * Nét vẽ nằm ở src/components/icon-paths.ts (dùng chung với script trang tài khoản).
 */
import { iconPaths } from './icon-paths';
import type { IconName } from './icon-paths';
export type { IconName } from './icon-paths';

interface Props {
  name: IconName;
  class?: string;
  label?: string;
}

const { name, class: className, label } = Astro.props;

---

<svg
  class={className}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={iconPaths[name]}
></svg>
