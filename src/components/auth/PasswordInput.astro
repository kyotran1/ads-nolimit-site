---
/**
 * Ô mật khẩu có nút Hiện/Ẩn (nút chỉ hiện khi có JavaScript; xử lý ở src/lib/auth/client.ts).
 * Slot "extra": nội dung đặt cạnh nhãn, ví dụ link "Quên mật khẩu?".
 */
interface Props {
  id: string;
  name?: string;
  label: string;
  autocomplete: 'current-password' | 'new-password';
  hint?: string;
  minlength?: number;
  showLabel: string;
}
const { id, name = id, label, autocomplete, hint, minlength, showLabel } = Astro.props;
const describedBy = [hint ? `${id}-hint` : '', `${id}-error`].filter(Boolean).join(' ');
---

<div class="field">
  <div class="field-label-row">
    <label for={id}>{label}</label>
    <slot name="extra" />
  </div>
  <div class="pw-wrap">
    <input
      id={id}
      name={name}
      type="password"
      autocomplete={autocomplete}
      autocapitalize="off"
      spellcheck="false"
      required
      minlength={minlength}
      aria-describedby={describedBy}
    />
    <button type="button" class="pw-toggle" data-toggle-password aria-controls={id} aria-pressed="false" aria-label={showLabel} hidden>
      <svg class="pw-eye" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
        ><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z"></path><circle cx="12" cy="12" r="3"></circle></svg
      >
      <svg class="pw-eye-off" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
        ><path d="M3.5 3.5l17 17"></path><path d="M10.6 5.6A9.6 9.6 0 0 1 12 5.5c6 0 9.5 6.5 9.5 6.5a16.4 16.4 0 0 1-2.9 3.7M6.6 6.7C3.9 8.4 2.5 12 2.5 12S6 18.5 12 18.5c1.7 0 3.2-.5 4.5-1.2"></path><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"></path></svg
      >
    </button>
  </div>
  {hint && <p class="field-hint" id={`${id}-hint`}>{hint}</p>}
  <p class="field-error" id={`${id}-error`}></p>
</div>
