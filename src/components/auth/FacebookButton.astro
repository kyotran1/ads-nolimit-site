---
/**
 * Nút "Tiếp tục với Facebook" theo hướng dẫn thương hiệu của Meta: logo chữ "f" giữ nguyên màu #1877F2 (không đổi màu),
 * nền trắng, viền và chữ như nút Google. Chỉ vẽ khi cờ authProviders.facebook bật (trang gọi kiểm trước).
 * Không dùng Facebook JS SDK: đăng nhập chạy bằng Firebase Auth (src/lib/auth/facebook-flow.ts).
 */
interface Props {
  id: string;
  label: string;
}
const { id, label } = Astro.props;
---

<button type="button" class="btn-facebook" id={id}>
  <svg class="fb-mark" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <path
      fill="#1877F2"
      d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
    ></path>
  </svg>
  <span>{label}</span>
</button>
