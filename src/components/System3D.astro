---
/**
 * Mô hình 3D "xưởng" của ADS-Nolimit: một khách hàng đi qua 6 trạm
 * (Quảng cáo → Tin nhắn → AI Agent → Google Sheet → Báo nhân viên → Báo cáo sáng).
 *
 * - Vẽ bằng CSS 3D (transform-style: preserve-3d), không thư viện, không ảnh → nhẹ, nét.
 * - Kéo (chuột) hoặc vuốt ngang (điện thoại) để xoay; nút góc nhìn; "Chạy thử 1 khách"
 *   chạy lần lượt 6 bước, mỗi bước sáng trạm tương ứng + chú thích.
 * - Tự chạy thử một lần khi cuộn tới; tạm dừng mọi chuyển động khi ra khỏi màn hình.
 * - Giảm chuyển động (prefers-reduced-motion): không tự xoay, không chấm chạy; vẫn bấm xem từng bước.
 * - Không JS: hiện mô hình tĩnh + danh sách 6 bước (đủ thông tin).
 * - Phần 3D chỉ để minh họa (aria-hidden); nội dung thật nằm ở danh sách 6 bước bên dưới.
 */
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';
import type { Lang } from '../config/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'vi' } = Astro.props;

const copy = {
  vi: {
    label: 'Mô hình 3D: một khách hàng đi qua hệ thống ADS-Nolimit',
    chip: 'Mô hình 3D',
    hintDrag: 'Kéo để xoay',
    hintSwipe: 'Vuốt ngang để xoay',
    views: { overview: 'Toàn cảnh', top: 'Nhìn từ trên', side: 'Bên hông' },
    run: 'Chạy thử 1 khách',
    running: 'Đang chạy…',
    again: 'Chạy lại',
    swayPause: 'Tạm dừng xoay',
    swayPlay: 'Tiếp tục xoay',
    stepsLabel: 'Sáu bước, bấm để xem trên mô hình',
    note: 'Mô hình minh họa luồng công việc; công cụ và kênh cụ thể tùy từng doanh nghiệp.',
    idle: 'Bấm “Chạy thử 1 khách” hoặc chọn một bước bên dưới.',
    steps: [
      { name: 'Quảng cáo', time: '20:15', text: 'Quảng cáo Facebook, Google, TikTok đưa đúng người có nhu cầu tới trang.' },
      { name: 'Tin nhắn', time: '22:41', text: 'Khách nhắn hỏi giá qua Messenger, Zalo OA hoặc khung chat trên website.' },
      { name: 'AI Agent', time: '22:41', text: 'AI Agent trả lời trong vài giây theo bảng giá và tài liệu của cửa hàng, xin số điện thoại.' },
      { name: 'Google Sheet', time: '22:42', text: 'Tên, số điện thoại, nhu cầu tự lưu vào bảng tính. Không khách nào bị thất lạc.' },
      { name: 'Báo nhân viên', time: '22:42', text: 'Lễ tân hoặc nhân viên nhận thông báo qua Zalo, Telegram; sáng mai gọi lại chốt lịch.' },
      { name: 'Báo cáo sáng', time: '07:00', text: 'Báo cáo quảng cáo tự động gửi về; ngân sách dồn sang nhóm quảng cáo tốt hơn.' },
    ],
  },
  en: {
    label: '3D model: one customer moving through the ADS-Nolimit system',
    chip: '3D model',
    hintDrag: 'Drag to rotate',
    hintSwipe: 'Swipe sideways to rotate',
    views: { overview: 'Overview', top: 'Top view', side: 'Side view' },
    run: 'Run one customer',
    running: 'Running…',
    again: 'Run again',
    swayPause: 'Pause rotation',
    swayPlay: 'Resume rotation',
    stepsLabel: 'Six steps, select one to see it on the model',
    note: 'An illustration of the workflow; the exact tools and channels depend on each business.',
    idle: 'Press “Run one customer” or pick a step below.',
    steps: [
      { name: 'Ads', time: '20:15', text: 'Facebook, Google and TikTok ads bring people who need what you sell.' },
      { name: 'Messages', time: '22:41', text: 'A customer asks for a price on Messenger, Zalo OA or your website chat.' },
      { name: 'AI agent', time: '22:41', text: 'The AI agent replies within seconds from your price list and documents, and asks for a phone number.' },
      { name: 'Google Sheets', time: '22:42', text: 'Name, phone and request are saved to a spreadsheet. No lead gets lost.' },
      { name: 'Staff alert', time: '22:42', text: 'Reception or sales gets a Zalo or Telegram alert and calls back in the morning.' },
      { name: 'Morning report', time: '07:00', text: 'An automatic ad report arrives; budget moves to the ad sets that work.' },
    ],
  },
}[lang];

/** Trạm trên sàn 600×600 (đơn vị px của mô hình). */
interface Station {
  x: number;
  y: number;
  w: number;
  d: number;
  h: number;
  tone: string;
  icon: IconName;
}
const stations: Station[] = [
  { x: 70, y: 80, w: 120, d: 90, h: 40, tone: '#8592ff', icon: 'chart' },
  { x: 390, y: 70, w: 120, d: 100, h: 40, tone: '#a58cff', icon: 'chat' },
  { x: 240, y: 240, w: 120, d: 120, h: 64, tone: '#2ee89a', icon: 'spark' },
  { x: 420, y: 330, w: 110, d: 120, h: 34, tone: '#2ee89a', icon: 'sheet' },
  { x: 400, y: 470, w: 110, d: 80, h: 48, tone: '#eed65a', icon: 'bell' },
  { x: 80, y: 390, w: 130, d: 110, h: 56, tone: '#3fd0c2', icon: 'chart' },
];
const center = (s: Station) => ({ cx: s.x + s.w / 2, cy: s.y + s.d / 2 });

/** Cột biểu đồ nổi trên trạm Quảng cáo (màu ba nền tảng, tự vẽ). */
const bars = [
  { x: 92, y: 108, h: 26, tone: '#6f7dff' },
  { x: 122, y: 108, h: 42, tone: '#3fd0c2' },
  { x: 152, y: 108, h: 60, tone: '#2ee89a' },
];

/** Đường đi trên sàn: 6 đoạn nối 6 trạm thành vòng khép kín. */
const segs = [
  'M130,125 C230,60 350,60 450,120',
  'M450,120 C440,200 360,230 300,300',
  'M300,300 C360,330 420,350 475,390',
  'M475,390 C520,430 510,470 455,510',
  'M455,510 C360,560 220,540 145,445',
  'M145,445 C60,360 60,220 130,125',
];
const loop = segs.map((d, i) => (i === 0 ? d : d.replace(/^M[\d.,]+\s*/, ''))).join(' ');

const boxStyle = (b: { x: number; y: number; w: number; d: number; h: number; z?: number; tone: string }) =>
  `--x:${b.x}px;--y:${b.y}px;--w:${b.w}px;--d:${b.d}px;--h:${b.h}px;--z:${b.z ?? 0}px;--tone:${b.tone}`;
---

<figure class="s3d" data-s3d data-label-running={copy.running} data-label-again={copy.again} data-label-run={copy.run} data-label-sway-pause={copy.swayPause} data-label-sway-play={copy.swayPlay}>
  <div class="s3d-stage" data-stage>
    <div class="s3d-chips" aria-hidden="true">
      <span class="s3d-chip"><Icon name="spark" />{copy.chip}</span>
      <span class="s3d-chip s3d-chip--hint">
        <span class="hint-drag">{copy.hintDrag}</span>
        <span class="hint-swipe">{copy.hintSwipe}</span>
      </span>
    </div>

    <div class="s3d-world" aria-hidden="true" data-world>
      <!-- Sàn -->
      <div class="box box--floor" style={boxStyle({ x: 0, y: 0, w: 600, d: 600, h: 18, z: -18, tone: '#343e7c' })}>
        <div class="f f-top floor">
          <span class="floor-ring floor-ring--a"></span>
          <span class="floor-ring floor-ring--b"></span>
          <svg class="floor-svg" viewBox="0 0 600 600" width="600" height="600" data-svg>
            <defs>
              <linearGradient id="s3d-track" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#a58cff"></stop>
                <stop offset="0.5" stop-color="#3fd0c2"></stop>
                <stop offset="1" stop-color="#2ee89a"></stop>
              </linearGradient>
              <path id="s3d-loop" d={loop}></path>
            </defs>
            <use href="#s3d-loop" class="track-base"></use>
            <use href="#s3d-loop" class="track-flow"></use>
            {segs.map((d, i) => <path class="seg" d={d} data-seg={i} />)}
            {
              [0, -4, -8].map((begin) => (
                <circle class="packet" r="5">
                  <animateMotion dur="12s" repeatCount="indefinite" begin={`${begin}s`}>
                    <mpath href="#s3d-loop" />
                  </animateMotion>
                </circle>
              ))
            }
            <circle class="runner" r="10" cx="130" cy="125" data-runner></circle>
          </svg>
        </div>
        <div class="f f-front"></div>
        <div class="f f-back"></div>
        <div class="f f-left"></div>
        <div class="f f-right"></div>
      </div>

      <!-- 6 trạm -->
      {
        stations.map((s, i) => (
          <div class="box station" style={boxStyle(s)} data-station={i}>
            <div class="f f-top">
              <span class="top-icon">
                <Icon name={s.icon} />
              </span>
              <span class="top-num">{i + 1}</span>
            </div>
            <div class="f f-front" />
            <div class="f f-back" />
            <div class="f f-left" />
            <div class="f f-right" />
          </div>
        ))
      }

      <!-- Cột biểu đồ trên trạm Quảng cáo -->
      {
        bars.map((b) => (
          <div class="box bar" style={boxStyle({ x: b.x, y: b.y, w: 18, d: 18, h: b.h, z: 40, tone: b.tone })}>
            <div class="f f-top" />
            <div class="f f-front" />
            <div class="f f-back" />
            <div class="f f-left" />
            <div class="f f-right" />
          </div>
        ))
      }

      <!-- Lõi AI phát sáng nổi trên trạm AI Agent -->
      <div class="anchor" style="--cx:300px;--cy:300px;--cz:118px">
        <span class="orb"></span>
      </div>

      <!-- Nhãn tên trạm (luôn quay mặt về người xem) -->
      {
        stations.map((s, i) => {
          const { cx, cy } = center(s);
          return (
            <div class="anchor" style={`--cx:${cx}px;--cy:${cy}px;--cz:${s.h + (i === 2 ? 92 : i === 0 ? 72 : 22)}px`} data-label={i}>
              <span class="s3d-label">
                <b>{i + 1}</b>
                {copy.steps[i].name}
              </span>
            </div>
          );
        })
      }
    </div>

    <div class="s3d-controls">
      <div class="seg-views" role="group">
        <button type="button" class="ctl" data-view="overview" aria-pressed="true">{copy.views.overview}</button>
        <button type="button" class="ctl" data-view="top" aria-pressed="false">{copy.views.top}</button>
        <button type="button" class="ctl" data-view="side" aria-pressed="false">{copy.views.side}</button>
      </div>
      <button type="button" class="ctl ctl--run" data-run>
        <Icon name="play" />
        <span data-run-text>{copy.run}</span>
      </button>
      <button type="button" class="ctl ctl--icon" data-sway aria-label={copy.swayPause}>
        <Icon name="pause" class="i-pause" />
        <Icon name="play" class="i-play" />
      </button>
    </div>
  </div>

  <div class="s3d-caption" aria-live="polite" data-caption>
    <span class="cap-time" data-cap-time></span>
    <strong class="cap-title" data-cap-title></strong>
    <span class="cap-text" data-cap-text>{copy.idle}</span>
  </div>

  <ol class="s3d-steps" aria-label={copy.stepsLabel}>
    {
      copy.steps.map((st, i) => (
        <li>
          <button type="button" class="step" data-step={i} aria-pressed="false" data-glow style={`--tone:${stations[i].tone}`}>
            <span class="step-num">{i + 1}</span>
            <span class="step-body">
              <span class="step-name">
                {st.name}
                <span class="step-time">{st.time}</span>
              </span>
              <span class="step-text">{st.text}</span>
            </span>
          </button>
        </li>
      ))
    }
  </ol>
  <figcaption class="s3d-note">{copy.note}</figcaption>
</figure>

<script>
  // Điều khiển mô hình 3D. Không thư viện.
  interface View {
    pitch: number;
    yaw: number;
  }
  const VIEWS: Record<string, View> = {
    overview: { pitch: 58, yaw: -38 },
    top: { pitch: 14, yaw: -10 },
    side: { pitch: 76, yaw: -78 },
  };
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wait = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));

  function setup(root: HTMLElement) {
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const world = root.querySelector<HTMLElement>('[data-world]')!;
    const svg = root.querySelector<SVGSVGElement>('[data-svg]')!;
    const runner = root.querySelector<SVGCircleElement>('[data-runner]')!;
    const segs = Array.from(root.querySelectorAll<SVGPathElement>('path[data-seg]'));
    const stations = Array.from(root.querySelectorAll<HTMLElement>('[data-station]'));
    const labels = Array.from(root.querySelectorAll<HTMLElement>('[data-label]'));
    const stepBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('button[data-step]'));
    const viewBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('button[data-view]'));
    const runBtn = root.querySelector<HTMLButtonElement>('[data-run]')!;
    const runText = root.querySelector<HTMLElement>('[data-run-text]')!;
    const swayBtn = root.querySelector<HTMLButtonElement>('[data-sway]')!;
    const capTime = root.querySelector<HTMLElement>('[data-cap-time]')!;
    const capTitle = root.querySelector<HTMLElement>('[data-cap-title]')!;
    const capText = root.querySelector<HTMLElement>('[data-cap-text]')!;
    const steps = stepBtns.map((b) => ({
      name: b.querySelector('.step-name')?.childNodes[0]?.textContent?.trim() ?? '',
      time: b.querySelector('.step-time')?.textContent ?? '',
      text: b.querySelector('.step-text')?.textContent ?? '',
    }));

    // ---- Camera ----
    const cam = { pitch: VIEWS.overview.pitch, yaw: VIEWS.overview.yaw };
    let target: View | null = null;
    let baseYaw = VIEWS.overview.yaw;
    let swayOn = !reduce;
    let interacted = 0; // thời điểm khách kéo/bấm gần nhất
    let inView = false;
    let raf = 0;
    let t0 = performance.now();

    const apply = () => {
      world.style.setProperty('--pitch', `${cam.pitch.toFixed(2)}deg`);
      world.style.setProperty('--yaw', `${cam.yaw.toFixed(2)}deg`);
    };
    const fit = () => {
      const w = stage.clientWidth;
      const h = stage.clientHeight;
      const zoom = Math.max(0.36, Math.min(1.05, Math.min(w / 860, h / 600)));
      world.style.setProperty('--zoom', zoom.toFixed(3));
      world.style.setProperty('--ls', Math.min(2.1, Math.max(1, 0.82 / zoom)).toFixed(3));
    };

    const frame = (now: number) => {
      raf = requestAnimationFrame(frame);
      if (target) {
        cam.pitch += (target.pitch - cam.pitch) * 0.1;
        cam.yaw += (target.yaw - cam.yaw) * 0.1;
        if (Math.abs(target.pitch - cam.pitch) < 0.05 && Math.abs(target.yaw - cam.yaw) < 0.05) {
          cam.pitch = target.pitch;
          cam.yaw = target.yaw;
          baseYaw = cam.yaw;
          t0 = now;
          target = null;
        }
        apply();
      } else if (swayOn && !dragging && now - interacted > 7000) {
        // lắc nhẹ quanh góc hiện tại cho mô hình "sống"
        cam.yaw = baseYaw + 9 * Math.sin((now - t0) / 2600);
        apply();
      }
    };
    const start = () => {
      if (!raf && inView) raf = requestAnimationFrame(frame);
      if (!reduce) svg.unpauseAnimations();
    };
    const stop = () => {
      cancelAnimationFrame(raf);
      raf = 0;
      svg.pauseAnimations();
    };

    const setView = (name: string) => {
      target = { ...VIEWS[name] };
      interacted = 0;
      viewBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === name)));
      start();
    };
    viewBtns.forEach((b) => b.addEventListener('click', () => setView(b.dataset.view!)));

    // ---- Kéo để xoay ----
    let dragging = false;
    let lx = 0;
    let ly = 0;
    stage.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement).closest('button')) return;
      dragging = true;
      lx = e.clientX;
      ly = e.clientY;
      target = null;
      stage.classList.add('is-dragging');
      stage.setPointerCapture(e.pointerId);
    });
    stage.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - lx;
      const dy = e.clientY - ly;
      lx = e.clientX;
      ly = e.clientY;
      cam.yaw += dx * 0.35;
      cam.pitch = Math.max(8, Math.min(80, cam.pitch - dy * 0.25));
      baseYaw = cam.yaw;
      interacted = performance.now();
      viewBtns.forEach((b) => b.setAttribute('aria-pressed', 'false'));
      apply();
    });
    const endDrag = () => {
      if (!dragging) return;
      dragging = false;
      t0 = performance.now();
      stage.classList.remove('is-dragging');
    };
    stage.addEventListener('pointerup', endDrag);
    stage.addEventListener('pointercancel', endDrag);

    // ---- Bật/tắt lắc nhẹ ----
    const updateSway = () => {
      root.classList.toggle('is-still', !swayOn);
      swayBtn.setAttribute('aria-label', (swayOn ? root.dataset.labelSwayPause : root.dataset.labelSwayPlay) ?? '');
      if (swayOn) svg.unpauseAnimations();
      else svg.pauseAnimations();
    };
    swayBtn.addEventListener('click', () => {
      swayOn = !swayOn;
      if (swayOn) {
        baseYaw = cam.yaw;
        t0 = performance.now();
        interacted = 0;
      }
      updateSway();
    });

    // ---- Làm sáng một bước ----
    const focus = (i: number | null) => {
      stations.forEach((s, k) => s.classList.toggle('is-active', k === i));
      labels.forEach((l, k) => l.classList.toggle('is-active', k === i));
      stepBtns.forEach((b, k) => b.setAttribute('aria-pressed', String(k === i)));
      root.classList.toggle('has-focus', i !== null);
      if (i === null) return;
      capTime.textContent = steps[i].time;
      capTitle.textContent = `${i + 1}. ${steps[i].name}`;
      capText.textContent = steps[i].text;
      const p = segs[(i + 5) % 6].getPointAtLength(segs[(i + 5) % 6].getTotalLength());
      runner.setAttribute('cx', String(p.x));
      runner.setAttribute('cy', String(p.y));
      root.classList.add('show-runner');
    };
    stepBtns.forEach((b) =>
      b.addEventListener('click', () => {
        if (running) return;
        focus(Number(b.dataset.step));
      }),
    );

    // ---- Chạy thử 1 khách ----
    let running = false;
    const move = (seg: SVGPathElement, ms: number) =>
      new Promise<void>((resolve) => {
        if (reduce) return resolve();
        const len = seg.getTotalLength();
        const t = performance.now();
        const tick = (now: number) => {
          const k = Math.min(1, (now - t) / ms);
          const e = k < 0.5 ? 2 * k * k : 1 - (-2 * k + 2) ** 2 / 2;
          const p = seg.getPointAtLength(len * e);
          runner.setAttribute('cx', String(p.x));
          runner.setAttribute('cy', String(p.y));
          if (k < 1) requestAnimationFrame(tick);
          else resolve();
        };
        requestAnimationFrame(tick);
      });

    const run = async () => {
      if (running) return;
      running = true;
      root.classList.add('is-running');
      runBtn.disabled = true;
      runText.textContent = root.dataset.labelRunning ?? '';
      for (let i = 0; i < 6; i++) {
        if (i > 0) await move(segs[i - 1], 1100);
        focus(i);
        await wait(reduce ? 2200 : 1700);
      }
      await move(segs[5], 1100);
      running = false;
      root.classList.remove('is-running');
      runBtn.disabled = false;
      runText.textContent = root.dataset.labelAgain ?? '';
    };
    runBtn.addEventListener('click', run);

    // ---- Khi nào chạy ----
    let autoRan = false;
    new IntersectionObserver(
      (entries) => {
        const e = entries[entries.length - 1];
        inView = e.isIntersecting;
        if (inView) {
          start();
          if (!autoRan && e.intersectionRatio >= 0.45 && !reduce) {
            autoRan = true;
            setTimeout(run, 600);
          }
        } else stop();
      },
      { threshold: [0, 0.45] },
    ).observe(stage);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : inView && start()));
    new ResizeObserver(fit).observe(stage);

    root.classList.add('is-live');
    fit();
    apply();
    updateSway();
    if (reduce) svg.pauseAnimations();
  }

  document.querySelectorAll<HTMLElement>('[data-s3d]').forEach(setup);
</script>

<style>
  .s3d {
    position: relative;
    margin: 0;
  }

  /* ---------- Sân khấu ---------- */
  .s3d-stage {
    position: relative;
    overflow: hidden;
    height: clamp(26rem, 46vw, 38rem);
    border-radius: var(--r-xl);
    border: 1px solid var(--line-strong);
    background:
      radial-gradient(60% 55% at 50% 52%, rgb(24 0 240 / 0.22), transparent 70%),
      radial-gradient(40% 40% at 78% 20%, rgb(0 216 120 / 0.12), transparent 70%),
      radial-gradient(45% 45% at 15% 85%, rgb(72 0 168 / 0.22), transparent 70%),
      #060a1f;
    box-shadow:
      var(--shadow-glow),
      inset 0 1px 0 rgb(255 255 255 / 0.05);
    perspective: 1600px;
    perspective-origin: 50% 38%;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  .s3d-stage.is-dragging {
    cursor: grabbing;
  }

  .s3d-world {
    --pitch: 58deg;
    --yaw: -38deg;
    --zoom: 0.9;
    --ls: 1;
    position: absolute;
