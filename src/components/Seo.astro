---
import { site, contact, links, intlPhone } from '../config/site';
import { pairFor } from '../config/i18n';
import type { Lang } from '../config/i18n';

interface Props {
  title: string;
  description: string;
  /** Ảnh chia sẻ riêng cho trang (đường dẫn trong public/) */
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  lang?: Lang;
  publishedTime?: string;
}

const {
  title,
  description,
  image = site.ogImage,
  type = 'website',
  noindex = false,
  lang = 'vi',
  publishedTime,
} = Astro.props;

// Bản ngôn ngữ còn lại lấy từ bảng đối chiếu trong src/config/i18n.ts
const alternate = noindex ? undefined : pairFor(Astro.url.pathname);

const canonical = new URL(Astro.url.pathname, site.url).href;
const imageUrl = new URL(image, site.url).href;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  alternateName: ['ADS NOLIMIT', 'ADS-Nolimit Agency'],
  url: `${site.url}/`,
  logo: `${site.url}/logo.png`,
  email: contact.email,
  sameAs: [links.facebook, links.telegram],
  founder: { '@type': 'Person', '@id': `${site.url}/tran-van-nhat/#person`, name: 'Trần Văn Nhất', url: `${site.url}/tran-van-nhat/` },
  contactPoint: [
    {
      '@type': 'ContactPoint',
      telephone: intlPhone(contact.hotline),
      contactType: 'customer service',
      areaServed: 'VN',
      availableLanguage: ['Vietnamese', 'English'],
    },
    {
      '@type': 'ContactPoint',
      telephone: intlPhone(contact.zaloPhone),
      contactType: 'sales',
      areaServed: 'VN',
      availableLanguage: ['Vietnamese', 'English'],
    },
  ],
};

// Tên trang web hiện trên Google (Google chỉ đọc ở trang chủ tên miền "/"): https://developers.google.com/search/docs/appearance/site-names
const isHome = Astro.url.pathname === '/';
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  alternateName: ['ADS NOLIMIT', 'ADS-Nolimit Agency', 'ads-nolimit.agency'],
  url: `${site.url}/`,
  inLanguage: ['vi', 'en'],
};
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

{
  alternate && (
    <>
      <link rel="alternate" hreflang="vi" href={new URL(alternate.vi, site.url).href} />
      <link rel="alternate" hreflang="en" href={new URL(alternate.en, site.url).href} />
      <link rel="alternate" hreflang="x-default" href={new URL(alternate.vi, site.url).href} />
    </>
  )
}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={lang === 'en' ? 'en_US' : site.locale} />
{alternate && <meta property="og:locale:alternate" content={lang === 'en' ? site.locale : 'en_US'} />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${site.name} — ${lang === 'en' ? site.taglineEn : site.tagline}`} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<script is:inline type="application/ld+json" set:html={JSON.stringify(organization)}></script>
{isHome && <script is:inline type="application/ld+json" set:html={JSON.stringify(website)}></script>}
