---
import type { Plan } from '../data/pricing';

interface Props {
  plan: Plan;
  /** Hiện link sang trang dịch vụ */
  showLink?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { plan, showLink = true, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<article class="plan" id={plan.id}>
  <Heading class="plan-name">{plan.name}</Heading>
  <p class="plan-summary">{plan.summary}</p>

  <dl class="plan-prices">
    {
      plan.prices.map((p) => (
        <div class="price-row">
          <dt>{p.label}</dt>
          <dd>
            <span class="price-value">{p.value}</span>{p.unit && <span class="price-unit">{p.unit}</span>}
          </dd>
        </div>
      ))
    }
  </dl>

  {plan.limit && <p class="plan-limit">{plan.limit}</p>}

  <ul class="checklist plan-features">
    {plan.features.map((f) => <li>{f}</li>)}
  </ul>

  {
    showLink && !plan.href.startsWith('/bang-gia/') && (
      <a class="plan-link" href={plan.href}>
        Xem chi tiết<span class="visually-hidden"> {plan.name}</span>
      </a>
    )
  }
</article>

<style>
  .plan {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    background: var(--bg-raise);
  }

  .plan-name {
    font-size: var(--step-2);
    line-height: 1.3;
  }

  .plan-summary {
    color: var(--text-2);
  }

  .plan-prices {
    margin: 0;
    display: grid;
    gap: 0.35rem;
    padding: 0.9rem 1rem;
    border-radius: var(--r-md);
    background: var(--bg);
    border: 1px solid var(--line);
  }

  .price-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .price-row dt {
    color: var(--text-2);
    font-size: 0.9375rem;
  }

  .price-row dd {
    margin: 0;
    text-align: right;
  }

  .price-value {
    font-weight: 800;
    font-size: 1.1875rem;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .price-unit {
    color: var(--text-2);
    font-size: 0.9375rem;
  }

  .plan-limit {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--sun);
  }

  .plan-features {
    font-size: 0.9688rem;
  }

  .plan-link {
    margin-top: auto;
    padding-top: 0.5rem;
    font-weight: 600;
  }
</style>
