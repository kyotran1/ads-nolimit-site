---
/**
 * Thẻ một gói giá. Dữ liệu từ src/data/pricing.ts (đã chuyển ngữ qua getPlan/getPlans).
 * Giá chính (gói có số tiền) hiện lớn; các dòng giá còn lại hiện gọn bên dưới.
 */
import Icon from './Icon.astro';
import type { Plan } from '../data/pricing';
import { getPilotOffer } from '../data/pricing';
import { t } from '../config/i18n';
import type { Lang } from '../config/i18n';

interface Props {
  plan: Plan;
  lang?: Lang;
  /** Hiện link sang trang dịch vụ */
  showLink?: boolean;
  headingLevel?: 'h2' | 'h3';
  /** Nút hành động cuối thẻ */
  cta?: { href: string; label: string; external?: boolean };
  /** Dòng nhỏ phía trên tên gói (ví dụ tên nhóm dịch vụ) */
  kicker?: string;
}

const { plan, lang = 'vi', showLink = true, headingLevel = 'h3', cta, kicker } = Astro.props;
const Heading = headingLevel;
const pilot = getPilotOffer(lang);
const hasPilot = plan.pilot && pilot.active;

// Giá chính: dòng đầu tiên có số tiền (ví dụ "Cài đặt", "Triển khai"), nếu không thì dòng đầu.
const leadIndex = Math.max(
  0,
  plan.prices.findIndex((p) => /\d/.test(p.value) && !/^\d+ (ngày|days)$/.test(p.value)),
);
const leadPrice = plan.prices[leadIndex];
const otherPrices = plan.prices.filter((_, i) => i !== leadIndex);
const detailsLink = showLink && !/(^|\/)(bang-gia|pricing)\//.test(plan.href.split('#')[0]);
---

<article class:list={['plan', { 'plan--pilot': hasPilot }]} id={plan.id} data-glow data-tilt>
  <div class="plan-head">
    {
      hasPilot && (
        <p class="tag tag--sun plan-pilot">
          <Icon name="spark" />
          {pilot.title}: {pilot.short}
        </p>
      )
    }
    {kicker && <p class="plan-kicker">{kicker}</p>}
    <Heading class="plan-name">{plan.name}</Heading>
    <p class="plan-summary">{plan.summary}</p>
  </div>

  <div class="plan-price">
    <p class="lead-label">{leadPrice.label}</p>
    <p class="lead-value">
      <span class="price-value">{leadPrice.value}</span>{leadPrice.unit && <span class="price-unit">{leadPrice.unit}</span>}
    </p>
    {
      otherPrices.length > 0 && (
        <dl class="plan-prices">
          {otherPrices.map((p) => (
            <div class="price-row">
              <dt>{p.label}</dt>
              <dd>
                <strong>{p.value}</strong>{p.unit && <span class="price-unit">{p.unit}</span>}
              </dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>

  {plan.limit && <p class="plan-limit">{plan.limit}</p>}

  <ul class="checklist plan-features">
    {plan.features.map((f) => <li>{f}</li>)}
  </ul>

  {
    (cta || detailsLink) && (
      <div class="plan-foot">
        {cta && (
          <a class="btn btn-secondary plan-cta" href={cta.href} rel={cta.external ? 'noopener' : undefined}>
            {cta.label}
          </a>
        )}
        {detailsLink && (
          <a class="text-link plan-link" href={plan.href}>
            {t(lang).details}
            <span class="visually-hidden"> {plan.name}</span>
            <Icon name="arrow" />
          </a>
        )}
      </div>
    )
  }
</article>

<style>
  .plan {
    position: relative;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    height: 100%;
    padding: clamp(1.35rem, 1rem + 1.2vw, 2rem);
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    background: var(--card-bg);
  }

  .plan--pilot {
    border-color: rgb(238 214 90 / 0.4);
    background:
      radial-gradient(90% 60% at 100% 0%, rgb(238 214 90 / 0.08), transparent 70%),
      var(--card-bg);
  }

  .plan-head {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
  }

  .plan-pilot {
    margin-bottom: 0.25rem;
  }
  .plan-pilot :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
  }

  .plan-kicker {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--green-ink);
  }

  .plan-name {
    font-size: var(--step-2);
    line-height: 1.25;
  }

  .plan-summary {
    color: var(--text-2);
  }

  .plan-price {
    padding: 1rem 1.1rem 1.05rem;
    border-radius: var(--r-md);
    background: rgb(7 10 26 / 0.65);
    border: 1px solid var(--line);
  }

  .lead-label {
    font-size: 0.875rem;
    color: var(--text-3);
  }

  .lead-value {
    margin-top: 0.1rem;
    line-height: 1.2;
  }

  .price-value {
    font-size: clamp(1.35rem, 1.05rem + 1.1vw, 1.875rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .price-unit {
    color: var(--text-2);
    font-size: 0.9375rem;
    white-space: nowrap;
  }
  @media (min-width: 420px) {
    .price-value {
      white-space: nowrap;
    }
  }

  .plan-prices {
    display: grid;
    gap: 0.35rem;
    margin: 0.85rem 0 0;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--line-strong);
  }

  .price-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1rem;
    flex-wrap: wrap;
  }
  .price-row dt {
    color: var(--text-2);
    font-size: 0.9375rem;
  }
  .price-row dd {
    margin: 0;
    text-align: right;
  }
  .price-row strong {
    font-variant-numeric: tabular-nums;
  }

  .plan-limit {
    margin-top: -0.35rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--teal-ink);
  }

  .plan-features {
    font-size: 0.96875rem;
  }

  .plan-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: auto;
    padding-top: 0.25rem;
  }

  .plan-link :global(svg) {
    width: 1rem;
    height: 1rem;
  }
</style>
