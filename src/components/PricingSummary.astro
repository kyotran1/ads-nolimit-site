---
/** Bảng giá rút gọn cho trang chủ. Dữ liệu từ src/data/pricing.ts */
import { plans, pilotOffer, priceNote } from '../data/pricing';

const rows = plans.filter((p) => p.showOnHome);
---

<div class="summary">
  <ul class="rows">
    {
      rows.map((plan) => (
        <li class="row">
          <a class="row-name" href={plan.href.startsWith('/bang-gia/') ? `/bang-gia/#${plan.id}` : plan.href}>
            {plan.name}
          </a>
          <span class="row-prices">
            {plan.prices.map((p) => (
              <span class="row-price">
                {p.label !== 'Giá' && <span class="row-label">{p.label} </span>}<strong>{p.value}</strong>{p.unit && <span class="row-unit">{p.unit}</span>}
              </span>
            ))}
          </span>
        </li>
      ))
    }
  </ul>

  {
    pilotOffer.active && (
      <p class="pilot">
        <strong>{pilotOffer.title}:</strong> {pilotOffer.text}
      </p>
    )
  }
  <p class="note">{priceNote}</p>
  <a class="btn" href="/bang-gia/">Xem bảng giá đầy đủ</a>
</div>

<style>
  .rows {
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .row {
    display: grid;
    gap: 0.4rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 820px) {
    .row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      gap: 2rem;
      align-items: baseline;
    }
  }

  .row-name {
    font-weight: 700;
    font-size: var(--step-1);
    color: var(--text);
    text-decoration: none;
  }
  .row-name:hover {
    text-decoration: underline;
  }

  .row-prices {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }

  .row-price {
    white-space: nowrap;
  }

  .row-label,
  .row-unit {
    color: var(--text-2);
    font-size: 0.9375rem;
  }

  .row-price strong {
    font-variant-numeric: tabular-nums;
  }


  .summary .btn {
    margin-top: 1.25rem;
  }
</style>
