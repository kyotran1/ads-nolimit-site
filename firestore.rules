rules_version = '2';

// ==========================================================================
// LUẬT BẢO MẬT FIRESTORE — dự án "ADS-Nolimit Web" (tài khoản khách hàng, V4).
//
// Nguyên tắc: mặc định CẤM tất cả, chỉ mở đúng những gì liệt kê dưới đây.
//
//   users/{uid}          Hồ sơ khách (+ avatar: ảnh đại diện data URL)
//   customerServices/{uid} Dịch vụ khách đang dùng + quyền truy cập mục (chỉ quản trị viên ghi). (khách tự đọc/sửa của mình; quản trị viên đọc được).
//   wallets/{uid}        Số dư (VNĐ, số nguyên). Khách CHỈ đọc; khách chỉ làm số dư GIẢM
//                        trong một lần ghi mua hàng hợp lệ (đơn + giao dịch + ví cùng lúc).
//                        Mọi lần cộng tiền do quản trị viên làm, luôn kèm một dòng sổ giao dịch.
//   transactions/{id}    Sổ giao dịch (nạp, thanh toán, hoàn tiền, điều chỉnh). Không ai sửa/xóa.
//                        id: "topup_<mã nạp>", "refund_<mã đơn>", mã đơn (thanh toán), tự sinh (điều chỉnh).
//   topups/{mã nạp}      Lệnh nạp tiền chuyển khoản. Khách tạo (chờ chuyển khoản) và tự hủy;
//                        chỉ quản trị viên duyệt / từ chối.
//   orders/{id}          Đơn hàng trả bằng số dư. Giá phải đúng bảng giá products/ (hoặc courses/).
//   products/{id}        Bảng giá bán bằng số dư (quản trị viên "Đồng bộ bảng giá" từ src/data/catalog.ts).
//   courses/{id}         Khóa học; courses/{id}/lessons/{id} chỉ đọc được khi có courseAccess.
//   courseAccess/{uid_courseId}  Quyền học (mua bằng số dư, khóa miễn phí, hoặc quản trị viên cấp).
//   guides/{id}          Hướng dẫn sử dụng (khách đã đăng nhập đọc bài đã đăng).
//   keys/{key}           Key bản quyền ADS-NOLIMIT AI Office (quản trị viên cấp, khách chỉ đọc).
//   keyRequests/{id}     Yêu cầu đổi máy của khách.
//   settings/payment     Thông tin nhận chuyển khoản (khách đã đăng nhập đọc, quản trị viên ghi).
//   settings/adTopup     Mức nạp ngân sách TKQC, tối thiểu/tối đa, % phí (khách đọc, quản trị viên ghi).
//   adTopups/{mã}        Lệnh nạp ngân sách vào TKQC (khách tạo/hủy; quản trị viên duyệt/từ chối;
//                        Apps Script bot 3 ghi vào trang tính rồi đánh dấu written).
//   requests/{id}        Yêu cầu tư vấn dịch vụ (như V3; quản trị viên đổi trạng thái).
//   admins/{uid}         Danh sách quản trị viên: CHỈ tạo trong Firebase Console, website không ghi được.
//
// Thêm gói mới vào src/data/pricing.ts: thêm id gói vào planIds() bên dưới (yêu cầu tư vấn),
// và nếu bán bằng số dư thì khai báo trong src/data/catalog.ts rồi bấm "Đồng bộ bảng giá" ở /quan-tri/.
// Test: cd firebase && npm ci && npm test (chạy trên Firebase Emulator, không chạm dự án thật).
// ==========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Hàm dùng chung ----------

    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function myEmail() {
      return request.auth.token.email;
    }

    // Dữ liệu này là của người đang đăng nhập (dùng cho đọc một tài liệu hoặc truy vấn where uid == mình).
    function ownsResource() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    // Trường không bắt buộc: không có, hoặc là chuỗi dài tối đa `max` ký tự.
    function optString(data, key, max) {
      return !(key in data) || (data[key] is string && data[key].size() <= max);
    }

    // Trường bắt buộc: chuỗi dài từ `min` tới `max` ký tự.
    function reqString(data, key, min, max) {
      return key in data && data[key] is string && data[key].size() >= min && data[key].size() <= max;
    }

    // Id an toàn để ghép vào đường dẫn (không có "/").
    function safeId(id) {
      return id is string && id.matches('^[A-Za-z0-9_-]{1,64}$');
    }

    function walletPath(uid) {
      return /databases/$(database)/documents/wallets/$(uid);
    }
    function txPath(id) {
      return /databases/$(database)/documents/transactions/$(id);
    }
    function orderPath(id) {
      return /databases/$(database)/documents/orders/$(id);
    }
    function topupPath(id) {
      return /databases/$(database)/documents/topups/$(id);
    }
    function productPath(id) {
      return /databases/$(database)/documents/products/$(id);
    }
    function coursePath(id) {
      return /databases/$(database)/documents/courses/$(id);
    }
    function accessPath(id) {
      return /databases/$(database)/documents/courseAccess/$(id);
    }
    function keyPath(id) {
      return /databases/$(database)/documents/keys/$(id);
    }

    // ======================================================================
    // admins/{uid} — chỉ tạo/xóa trong Firebase Console
    // ======================================================================
    match /admins/{uid} {
      allow get: if isMe(uid);
      allow list, write: if false;
    }

    // ======================================================================
    // users/{uid} — hồ sơ khách
    // ======================================================================

    function validProfile(d) {
      return d.keys().hasOnly(['displayName', 'email', 'phone', 'company', 'industry', 'aiOfficeNews', 'avatar', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['createdAt', 'updatedAt'])
        && optString(d, 'displayName', 120)
        // ảnh đại diện: data URL ảnh đã thu nhỏ 128px (≤ 32 000 ký tự); '' = xóa ảnh
        && (!('avatar' in d) || (d.avatar is string && d.avatar.size() <= 32000 && (d.avatar == '' || d.avatar.matches('^data:image/(webp|jpeg|png);base64,[A-Za-z0-9+/=]+$'))))
        // email (để chủ tìm khách) phải đúng email đăng nhập
        && (!('email' in d) || d.email == myEmail())
        && optString(d, 'phone', 20)
        && (!('phone' in d) || d.phone.matches('[0-9+() .-]*'))
        && optString(d, 'company', 120)
        && optString(d, 'industry', 120)
        && (!('aiOfficeNews' in d) || d.aiOfficeNews is bool)
        && d.createdAt is timestamp
        && d.updatedAt == request.time;
    }

    // Chỉ xóa hồ sơ (bước đầu của "Xóa tài khoản") khi số dư bằng 0.
    function walletEmpty(uid) {
      return !exists(walletPath(uid)) || get(walletPath(uid)).data.balance == 0;
    }

    match /users/{uid} {
      allow get: if isMe(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isMe(uid)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isMe(uid)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isMe(uid) && walletEmpty(uid);
    }

    // ======================================================================
    // customerServices/{uid} — dịch vụ khách đang dùng (chủ gán tay) + quyền truy cập các mục.
    // CHỈ quản trị viên ghi; khách đọc của mình. Hình dạng từng phần tử của `services`
    // (id / status / since) không kiểm được bằng rules (không lặp mảng) → web quản trị kiểm khi ghi,
    // parseCustomerServices() bỏ phần tử sai khi đọc.
    // ======================================================================

    function validAccess(a) {
      return a is map
        && a.keys().hasOnly(['ads', 'courses', 'keys', 'guides'])
        && (!('ads' in a) || a.ads is bool)
        && (!('courses' in a) || a.courses is bool)
        && (!('keys' in a) || a.keys is bool)
        && (!('guides' in a) || a.guides is bool);
    }

    function validCustomerServices(d) {
      return d.keys().hasOnly(['services', 'access', 'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['services', 'access', 'updatedAt', 'updatedBy'])
        && d.services is list
        && d.services.size() <= 30
        && validAccess(d.access)
        && d.updatedAt == request.time
        && d.updatedBy == request.auth.uid;
    }

    match /customerServices/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create, update: if isAdmin() && validCustomerServices(request.resource.data);
      allow delete: if isAdmin();
    }

    // ======================================================================
    // wallets/{uid} — số dư
    // ======================================================================

    function walletShape(uid, w) {
      return w.keys().hasOnly(['uid', 'balance', 'updatedAt', 'lastTx'])
        && w.uid == uid
        && w.balance is int
        && w.balance >= 0
        && w.updatedAt == request.time
        && safeId(w.lastTx);
    }

    // Khách trả tiền: số dư GIẢM đúng bằng tổng của một đơn hàng MỚI tạo trong cùng lần ghi.
    // (Luật của orders/ kiểm tra giá; luật của transactions/ kiểm tra dòng sổ.)
    function customerPays(uid) {
      return isMe(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'updatedAt', 'lastTx'])
        && walletShape(uid, request.resource.data)
        && request.resource.data.balance < resource.data.balance
        && !exists(orderPath(request.resource.data.lastTx))
        && paysForOrder(uid, getAfter(orderPath(request.resource.data.lastTx)).data);
    }

    function paysForOrder(uid, order) {
      return order.uid == uid
        && order.total == resource.data.balance - request.resource.data.balance;
    }

    // Quản trị viên cộng/trừ tiền: luôn kèm một dòng sổ MỚI (lastTx) có số tiền = chênh lệch số dư.
    function adminMovesWallet(uid, before) {
      return isAdmin()
        && walletShape(uid, request.resource.data)
        && !exists(txPath(request.resource.data.lastTx))
        && ledgerMatches(uid, getAfter(txPath(request.resource.data.lastTx)).data, before);
    }

    function ledgerMatches(uid, tx, before) {
      return tx.uid == uid && tx.amount == request.resource.data.balance - before;
    }

    match /wallets/{uid} {
      allow get: if isMe(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if adminMovesWallet(uid, 0);
      allow update: if customerPays(uid) || adminMovesWallet(uid, resource.data.balance);
      allow delete: if false;
    }

    // ======================================================================
    // transactions/{id} — sổ giao dịch (bất biến)
    // ======================================================================

    function txShape(d) {
      return d.keys().hasOnly(['uid', 'type', 'amount', 'balanceAfter', 'refType', 'refId', 'note', 'createdAt', 'by'])
        && d.keys().hasAll(['uid', 'type', 'amount', 'balanceAfter', 'createdAt'])
        && d.uid is string
        && d.amount is int
        && d.amount != 0
        && d.balanceAfter is int
        && d.balanceAfter >= 0
        && optString(d, 'note', 300)
        && (!('refId' in d) || safeId(d.refId))
        && d.createdAt == request.time;
    }

    // Dòng "thanh toán" khách tự ghi khi mua: id = mã đơn, số tiền = −tổng đơn, số dư sau = số dư mới của ví.
    function customerPurchaseTx(txId) {
      return signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type == 'purchase'
        && txShape(request.resource.data)
        && !('by' in request.resource.data)
        && request.resource.data.refType == 'order'
        && request.resource.data.refId == txId
        && purchaseMatches(txId, request.resource.data, getAfter(orderPath(txId)).data, getAfter(walletPath(request.auth.uid)).data);
    }

    function purchaseMatches(txId, d, order, wallet) {
      return order.uid == d.uid
        && d.amount == -order.total
        && wallet.lastTx == txId
        && wallet.balance == d.balanceAfter;
    }

    // Dòng nạp / hoàn tiền / điều chỉnh do quản trị viên ghi, khớp với ví sau khi ghi.
    function adminTx(txId) {
      return isAdmin()
        && txShape(request.resource.data)
        && request.resource.data.type in ['topup', 'refund', 'adjust']
        && request.resource.data.by == request.auth.uid
        && safeId(request.resource.data.uid)
        && adminTxWallet(txId, request.resource.data, getAfter(walletPath(request.resource.data.uid)).data)
        && adminTxRef(txId, request.resource.data);
    }

    function walletBefore(uid) {
      return exists(walletPath(uid)) ? get(walletPath(uid)).data.balance : 0;
    }

    function adminTxWallet(txId, d, wallet) {
      return wallet.lastTx == txId
        && wallet.balance == d.balanceAfter
        && d.balanceAfter == walletBefore(d.uid) + d.amount;
    }

    function adminTxRef(txId, d) {
      return (d.type == 'topup'
          && d.refType == 'topup'
          && safeId(d.refId)
          && txId == 'topup_' + d.refId
          && topupCredited(d, getAfter(topupPath(d.refId)).data))
        || (d.type == 'refund'
          && d.refType == 'order'
          && safeId(d.refId)
          && txId == 'refund_' + d.refId
          && orderRefunded(d, getAfter(orderPath(d.refId)).data))
        || (d.type == 'adjust'
          && !('refType' in d)
          && !('refId' in d)
          && reqString(d, 'note', 3, 300));
    }

    function topupCredited(d, topup) {
      return topup.status == 'approved' && topup.uid == d.uid && topup.amount == d.amount;
    }

    function orderRefunded(d, order) {
      return order.status == 'refunded' && order.uid == d.uid && order.total == d.amount;
    }

    match /transactions/{txId} {
      allow read: if ownsResource() || isAdmin();
      allow create: if safeId(txId) && (customerPurchaseTx(txId) || adminTx(txId));
      allow update, delete: if false;
    }

    // ======================================================================
    // topups/{code} — lệnh nạp tiền (chuyển khoản VietQR, chủ duyệt tay)
    // ======================================================================

    function newTopup(code) {
      return signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'amount', 'code', 'status', 'lang', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'email', 'amount', 'code', 'status', 'lang', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == myEmail()
        && optString(request.resource.data, 'name', 120)
        && request.resource.data.amount is int
        && request.resource.data.amount >= 100000
        && request.resource.data.amount <= 500000000
        && request.resource.data.amount % 1000 == 0
        // mã chuyển khoản = id tài liệu → không thể trùng
        && code.matches('^ADSN[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.code == code
        && request.resource.data.status == 'pending'
        && request.resource.data.lang in ['vi', 'en']
        && request.resource.data.createdAt == request.time;
    }

    function customerCancelsTopup() {
      return ownsResource()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt']);
    }

    // Duyệt = cùng một transaction: lệnh nạp → approved + dòng sổ "topup_<mã>" + ví cộng tiền.
    // Lệnh khách đã hủy vẫn duyệt được (khách hủy nhầm nhưng đã chuyển tiền). Mỗi lệnh chỉ duyệt một lần.
    function adminApprovesTopup(code) {
      return isAdmin()
        && resource.data.status in ['pending', 'cancelled']
        && request.resource.data.status == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy', 'txId'])
        && request.resource.data.decidedAt == request.time
        && request.resource.data.decidedBy == request.auth.uid
        && request.resource.data.txId == 'topup_' + code
        && !exists(txPath('topup_' + code))
        && existsAfter(txPath('topup_' + code));
    }

    function adminRejectsTopup() {
      return isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'rejected'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy', 'reason'])
        && request.resource.data.decidedAt == request.time
        && request.resource.data.decidedBy == request.auth.uid
        && reqString(request.resource.data, 'reason', 1, 300);
    }

    match /topups/{code} {
      allow read: if ownsResource() || isAdmin();
      allow create: if newTopup(code);
      allow update: if customerCancelsTopup() || adminApprovesTopup(code) || adminRejectsTopup();
      allow delete: if false;
    }

    // ======================================================================
    // products/{id} — bảng giá bán bằng số dư
    // ======================================================================

    function validProduct(pid, d) {
      return d.keys().hasOnly(['id', 'planId', 'type', 'pricing', 'price', 'priceUsd', 'maxQty', 'minAmount', 'maxAmount', 'name', 'unit', 'active', 'sort', 'updatedAt'])
        && d.id == pid
        && safeId(pid)
        && d.type in ['service', 'ad_budget', 'key']
        && d.active is bool
        && d.name is map
        && reqString(d.name, 'vi', 1, 200)
        && reqString(d.name, 'en', 1, 200)
        && ((d.pricing == 'fixed'
            && d.price is int && d.price > 0
            && d.maxQty is int && d.maxQty >= 1 && d.maxQty <= 100)
          || (d.pricing == 'variable'
            && d.minAmount is int && d.minAmount > 0
            && d.maxAmount is int && d.maxAmount >= d.minAmount))
        && d.updatedAt == request.time;
    }

    match /products/{pid} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && validProduct(pid, request.resource.data);
      allow delete: if isAdmin();
    }

    // ======================================================================
    // orders/{id} — đơn hàng trả bằng số dư
    // ======================================================================

    function orderShape(d) {
      return d.keys().hasOnly(['uid', 'email', 'type', 'productId', 'name', 'qty', 'unitPrice', 'total', 'status', 'lang', 'note', 'adAccountId', 'adAccountName', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['uid', 'email', 'type', 'productId', 'name', 'qty', 'unitPrice', 'total', 'status', 'lang', 'createdAt', 'updatedAt'])
        && safeId(d.productId)
        && reqString(d, 'name', 1, 200)
        && d.qty is int
        && d.unitPrice is int
        && d.total is int
        && d.total > 0
        && optString(d, 'note', 1000)
        && optString(d, 'adAccountId', 64)
        && optString(d, 'adAccountName', 120)
        && d.lang in ['vi', 'en'];
    }

    // Giá theo bảng products/{id}: giá cố định × số lượng, hoặc số tiền khách nhập (ngân sách quảng cáo).
    function productPriceOk(d, p) {
      return p.active == true
        && p.type == d.type
        && ((p.pricing == 'fixed'
            && d.unitPrice == p.price
            && d.qty >= 1
            && d.qty <= p.maxQty
            && d.total == p.price * d.qty)
          || (p.pricing == 'variable'
            && d.qty == 1
            && d.unitPrice == d.total
            && d.total >= p.minAmount
            && d.total <= p.maxAmount
            && d.total % 1000 == 0))
        && (d.type != 'ad_budget' || reqString(d, 'adAccountId', 3, 64));
    }

    // Khóa học: giá theo courses/{id}; mỗi khóa chỉ mua một lần (quyền học được tạo cùng lúc).
    function coursePriceOk(d, c) {
      return c.published == true
        && c.price is int
        && c.price > 0
        && d.qty == 1
        && d.unitPrice == c.price
        && d.total == c.price
        && !exists(accessPath(d.uid + '_' + d.productId))
        && existsAfter(accessPath(d.uid + '_' + d.productId));
    }

    function priceOk(d) {
      return d.type == 'course'
        ? coursePriceOk(d, get(coursePath(d.productId)).data)
        : (d.type in ['service', 'ad_budget', 'key'] && productPriceOk(d, get(productPath(d.productId)).data));
    }

    // Đơn mới chỉ hợp lệ khi CÙNG LẦN GHI có: ví trừ đúng tổng (lastTx = mã đơn) và dòng sổ thanh toán.
    function customerOrder(oid) {
      return signedIn()
        && safeId(oid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == myEmail()
        && orderShape(request.resource.data)
        && request.resource.data.status == 'paid'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && priceOk(request.resource.data)
        && walletPaid(oid, request.resource.data, getAfter(walletPath(request.auth.uid)).data)
        && existsAfter(txPath(oid));
    }

    function walletPaid(oid, d, after) {
      return after.lastTx == oid
        && after.balance == get(walletPath(d.uid)).data.balance - d.total;
    }

    function adminOrderStatus() {
      return isAdmin()
        && resource.data.status in ['paid', 'processing', 'done', 'cancelled']
        && request.resource.data.status in ['paid', 'processing', 'done', 'cancelled']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'adminNote'])
        && request.resource.data.updatedAt == request.time
        && optString(request.resource.data, 'adminNote', 500);
    }

    // Hoàn tiền = cùng một transaction: đơn → refunded + dòng sổ "refund_<mã đơn>" + ví cộng lại tổng đơn.
    function adminRefund(oid) {
      return isAdmin()
        && resource.data.status in ['paid', 'processing', 'done', 'cancelled']
        && request.resource.data.status == 'refunded'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'refundedAt', 'adminNote'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.refundedAt == request.time
        && optString(request.resource.data, 'adminNote', 500)
        && !exists(txPath('refund_' + oid))
        && existsAfter(txPath('refund_' + oid));
    }

    match /orders/{oid} {
      allow read: if ownsResource() || isAdmin();
      allow create: if customerOrder(oid);
      allow update: if adminOrderStatus() || adminRefund(oid);
      allow delete: if false;
    }

    // ======================================================================
    // courses/{id}, courses/{id}/lessons/{id}, courseAccess/{uid_courseId}
    // ======================================================================

    function validCourse(d) {
      return d.keys().hasOnly(['title', 'titleEn', 'description', 'descriptionEn', 'price', 'priceUsd', 'cover', 'published', 'sort', 'outline', 'createdAt', 'updatedAt'])
        && reqString(d, 'title', 1, 160)
        && optString(d, 'titleEn', 160)
        && optString(d, 'description', 2000)
        && optString(d, 'descriptionEn', 2000)
        && d.price is int && d.price >= 0 && d.price <= 500000000
        && (!('priceUsd' in d) || (d.priceUsd is number && d.priceUsd >= 0))
        && optString(d, 'cover', 20)
        && d.published is bool
        && (!('sort' in d) || d.sort is int)
        && (!('outline' in d) || (d.outline is list && d.outline.size() <= 200))
        && d.updatedAt == request.time;
    }

    function validLesson(d) {
      return d.keys().hasOnly(['title', 'titleEn', 'videoUrl', 'duration', 'sort', 'updatedAt'])
        && reqString(d, 'title', 1, 160)
        && optString(d, 'titleEn', 160)
        && (!('videoUrl' in d) || (d.videoUrl is string && d.videoUrl.size() <= 500 && (d.videoUrl == '' || d.videoUrl.matches('^https://.+'))))
        && optString(d, 'duration', 12)
        && (!('sort' in d) || d.sort is int)
        && d.updatedAt == request.time;
    }

    function hasCourseAccess(cid) {
      return signedIn() && exists(accessPath(request.auth.uid + '_' + cid));
    }

    match /courses/{cid} {
      allow read: if (signedIn() && resource.data.published == true) || isAdmin();
      allow create, update: if isAdmin() && safeId(cid) && validCourse(request.resource.data);
      allow delete: if isAdmin();

      match /lessons/{lid} {
        allow read: if hasCourseAccess(cid) || isAdmin();
        allow create, update: if isAdmin() && safeId(lid) && validLesson(request.resource.data);
        allow delete: if isAdmin();
      }
    }

    function accessShape(aid, d) {
      return d.keys().hasOnly(['uid', 'courseId', 'source', 'orderId', 'createdAt', 'by'])
        && d.keys().hasAll(['uid', 'courseId', 'source', 'createdAt'])
        && safeId(d.uid)
        && safeId(d.courseId)
        && aid == d.uid + '_' + d.courseId
        && d.createdAt == request.time;
    }

    function customerAccess(aid) {
      return signedIn()
        && request.resource.data.uid == request.auth.uid
        && accessShape(aid, request.resource.data)
        && !('by' in request.resource.data)
        && ((request.resource.data.source == 'purchase'
            && safeId(request.resource.data.orderId)
            && !exists(orderPath(request.resource.data.orderId))
            && boughtCourse(request.resource.data, getAfter(orderPath(request.resource.data.orderId)).data))
          || (request.resource.data.source == 'free'
            && !('orderId' in request.resource.data)
            && freeCourse(get(coursePath(request.resource.data.courseId)).data)));
    }

    function boughtCourse(d, order) {
      return order.uid == d.uid && order.type == 'course' && order.productId == d.courseId;
    }

    function freeCourse(c) {
      return c.published == true && c.price == 0;
    }

    function adminGrant(aid) {
      return isAdmin()
        && accessShape(aid, request.resource.data)
        && request.resource.data.source == 'admin'
        && request.resource.data.by == request.auth.uid
        && !('orderId' in request.resource.data);
    }

    match /courseAccess/{aid} {
      allow read: if ownsResource() || isAdmin();
      allow create: if customerAccess(aid) || adminGrant(aid);
      allow delete: if isAdmin();
      allow update: if false;
    }

    // ======================================================================
    // guides/{id} — hướng dẫn sử dụng
    // ======================================================================

    function validGuide(d) {
      return d.keys().hasOnly(['title', 'titleEn', 'category', 'categoryEn', 'body', 'bodyEn', 'videoUrl', 'published', 'sort', 'createdAt', 'updatedAt'])
        && reqString(d, 'title', 1, 160)
        && optString(d, 'titleEn', 160)
        && reqString(d, 'category', 1, 60)
        && optString(d, 'categoryEn', 60)
        && optString(d, 'body', 20000)
        && optString(d, 'bodyEn', 20000)
        && (!('videoUrl' in d) || (d.videoUrl is string && d.videoUrl.size() <= 500 && (d.videoUrl == '' || d.videoUrl.matches('^https://.+'))))
        && d.published is bool
        && (!('sort' in d) || d.sort is int)
        && d.updatedAt == request.time;
    }

    match /guides/{gid} {
      allow read: if (signedIn() && resource.data.published == true) || isAdmin();
      allow create, update: if isAdmin() && safeId(gid) && validGuide(request.resource.data);
      allow delete: if isAdmin();
    }

    // ======================================================================
    // keys/{key} — key ADS-NOLIMIT AI Office; keyRequests/{id} — yêu cầu đổi máy
    // ======================================================================
    //
    // machines: danh sách { id, name, activatedAt } (máy đã kích hoạt), tối đa maxMachines.
    // Khi phần mềm ra mắt, có thể mở thêm luật cho chính chủ key thêm một máy, ví dụ:
    //   allow update: if ownsResource() && resource.data.status == 'active'
    //     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['machines', 'updatedAt'])
    //     && request.resource.data.machines.size() == resource.data.machines.size() + 1
    //     && request.resource.data.machines.size() <= resource.data.maxMachines
    //     && request.resource.data.machines.hasAll(resource.data.machines) && ...
    // (nên dùng máy chủ riêng / Cloud Functions để chống giả mạo mã máy).

    function keyIdOk(kid) {
      return kid.matches('^AINO-[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}$');
    }

    function validNewKey(kid, d) {
      return keyIdOk(kid)
        && d.keys().hasOnly(['uid', 'email', 'key', 'plan', 'maxMachines', 'machines', 'status', 'note', 'createdAt', 'updatedAt', 'issuedBy'])
        && safeId(d.uid)
        && reqString(d, 'email', 3, 200)
        && d.key == kid
        && reqString(d, 'plan', 1, 60)
        && d.maxMachines is int && d.maxMachines >= 1 && d.maxMachines <= 50
        && d.machines is list && d.machines.size() == 0
        && d.status == 'active'
        && optString(d, 'note', 300)
        && d.createdAt == request.time
        && d.updatedAt == request.time
        && d.issuedBy == request.auth.uid;
    }

    function validKeyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan', 'maxMachines', 'machines', 'status', 'note', 'updatedAt'])
        && reqString(request.resource.data, 'plan', 1, 60)
        && request.resource.data.maxMachines is int
        && request.resource.data.maxMachines >= 1
        && request.resource.data.maxMachines <= 50
        && request.resource.data.machines is list
        && request.resource.data.machines.size() <= request.resource.data.maxMachines
        && request.resource.data.status in ['active', 'revoked']
        && optString(request.resource.data, 'note', 300)
        && request.resource.data.updatedAt == request.time;
    }

    match /keys/{kid} {
      allow read: if ownsResource() || isAdmin();
      allow create: if isAdmin() && validNewKey(kid, request.resource.data);
      allow update: if isAdmin() && validKeyUpdate();
      allow delete: if false;
    }

    function validKeyRequest(d) {
      return d.keys().hasOnly(['uid', 'email', 'keyId', 'type', 'note', 'status', 'lang', 'createdAt'])
        && d.keys().hasAll(['uid', 'email', 'keyId', 'type', 'status', 'lang', 'createdAt'])
        && d.uid == request.auth.uid
        && d.email == myEmail()
        && d.keyId is string
        && keyIdOk(d.keyId)
        && d.type == 'reset_machines'
        && optString(d, 'note', 500)
        && d.status == 'new'
        && d.lang in ['vi', 'en']
        && d.createdAt == request.time
        && get(keyPath(d.keyId)).data.uid == request.auth.uid;
    }

    match /keyRequests/{rid} {
      allow read: if ownsResource() || isAdmin();
      allow create: if signedIn() && validKeyRequest(request.resource.data);
      allow update: if isAdmin()
        && resource.data.status == 'new'
        && request.resource.data.status in ['done', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'adminNote'])
        && request.resource.data.decidedAt == request.time
        && optString(request.resource.data, 'adminNote', 300);
      allow delete: if false;
    }

    // ======================================================================
    // settings/payment — thông tin nhận chuyển khoản (chỉ chủ điền ở /quan-tri/)
    // ======================================================================

    function validPayment(d) {
      return d.keys().hasOnly(['bankBin', 'bankName', 'accountNumber', 'accountName', 'note', 'updatedAt', 'updatedBy'])
        && d.bankBin is string && d.bankBin.matches('^[0-9]{6}$')
        && reqString(d, 'bankName', 1, 80)
        && d.accountNumber is string && d.accountNumber.matches('^[0-9]{6,19}$')
        && d.accountName is string && d.accountName.matches('^[A-Z0-9 .-]{2,60}$')
        && optString(d, 'note', 300)
        && d.updatedAt == request.time
        && d.updatedBy == request.auth.uid;
    }

    // settings/adTopup — mức nạp ngân sách TKQC (số tiền chuyển GỒM phí), tối thiểu/tối đa, % phí.
    function validAdTopupSettings(d) {
      return d.keys().hasOnly(['presets', 'min', 'max', 'feePercent', 'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['presets', 'min', 'max', 'feePercent', 'updatedAt', 'updatedBy'])
        && d.min is int && d.min >= 100000 && d.min % 1000 == 0
        && d.max is int && d.max >= d.min && d.max <= 1000000000 && d.max % 1000 == 0
        && d.feePercent is int && d.feePercent >= 0 && d.feePercent <= 50
        && d.presets is list && d.presets.size() >= 1 && d.presets.size() <= 8
        && d.updatedAt == request.time
        && d.updatedBy == request.auth.uid;
    }

    match /settings/{name} {
      allow get: if (signedIn() && name in ['payment', 'adTopup']) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && ((name == 'payment' && validPayment(request.resource.data))
          || (name == 'adTopup' && validAdTopupSettings(request.resource.data)));
      allow delete: if isAdmin();
    }

    // ======================================================================
    // requests/{id} — yêu cầu tư vấn dịch vụ
    // ======================================================================

    function planIds() {
      return ['ai-starter', 'ai-sales', 'ads', 'agency-account', 'automation', 'web', 'training', 'other'];
    }

    function validNewRequest(d) {
      return d.keys().hasOnly(['uid', 'planId', 'note', 'contact', 'lang', 'status', 'createdAt'])
        && d.keys().hasAll(['uid', 'planId', 'note', 'lang', 'status', 'createdAt'])
        && d.uid == request.auth.uid
        && d.planId in planIds()
        && d.note is string && d.note.size() <= 1000
        && optString(d, 'contact', 120)
        && d.lang in ['vi', 'en']
        && d.status == 'new'
        && d.createdAt == request.time;
    }

    match /requests/{requestId} {
      // Khách đọc yêu cầu của mình (truy vấn where('uid', '==', <uid của mình>)); quản trị viên đọc tất cả.
      allow read: if ownsResource() || isAdmin();
      allow create: if signedIn() && validNewRequest(request.resource.data);
      // Khách chỉ được hủy yêu cầu còn 'new'; quản trị viên đổi trạng thái.
      allow update: if (ownsResource()
          && resource.data.status == 'new'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        || (isAdmin()
          && request.resource.data.status in ['new', 'contacted', 'in_progress', 'done', 'cancelled']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'adminNote'])
          && request.resource.data.updatedAt == request.time
          && optString(request.resource.data, 'adminNote', 500));
      allow delete: if false;
    }

    // ======================================================================
    // adAccounts/{actId} — TKQC của khách (quản trị gắn TKQC ↔ khách).
    // Số liệu (latest, lastAlertDay) do Apps Script của chủ ghi qua Firestore REST bằng quyền Google
    // của chủ (không đi qua rules). Trình duyệt chỉ đọc; quản trị chỉ sửa phần cấu hình.
    // ======================================================================

    function adConfigKeys() {
      return ['uid', 'customerEmail', 'accountName', 'label', 'service', 'tabPattern', 'lowVnd', 'lowDays', 'emailAlerts', 'active', 'updatedAt', 'updatedBy', 'viewerUids', 'viewerEmails', 'memberUids'];
    }

    // Người xem thêm: mình có trong memberUids của tài liệu (TKQC hoặc báo cáo). Tài liệu cũ chưa có
    // memberUids → không khớp (chủ vẫn đọc qua ownsResource). Dùng riêng cho adAccounts/adReports/adTopups;
    // KHÔNG đổi ownsResource() vì nhiều bộ sưu tập khác dùng.
    function isAdMember() {
      return signedIn() && 'memberUids' in resource.data && request.auth.uid in resource.data.memberUids;
    }

    // 3 khóa người xem: hoặc không có khóa nào (tài liệu cũ), hoặc đủ cả 3 và nhất quán:
    // memberUids = [uid, ...viewerUids], ≤ 10 người xem, không trùng, không chứa uid chính, viewerEmails cùng độ dài.
    function validAdMembers(d) {
      return !d.keys().hasAny(['viewerUids', 'viewerEmails', 'memberUids'])
        || (d.keys().hasAll(['viewerUids', 'viewerEmails', 'memberUids'])
          && d.viewerUids is list && d.viewerEmails is list && d.memberUids is list
          && d.viewerUids.size() <= 10
          && d.viewerEmails.size() == d.viewerUids.size()
          && d.memberUids.size() == d.viewerUids.size() + 1
          && d.memberUids[0] == d.uid
          && d.memberUids.hasAll(d.viewerUids)
          && d.viewerUids.toSet().size() == d.viewerUids.size()
          && !(d.uid in d.viewerUids));
    }

    function validAdConfig(actId, d) {
      return actId.matches('^act_[0-9]{5,20}$')
        && safeId(d.uid)
        && reqString(d, 'customerEmail', 3, 200)
        && reqString(d, 'accountName', 1, 120)
        && optString(d, 'label', 120)
        && d['service'] in ['ads', 'agency-account', 'ad-budget']
        && reqString(d, 'tabPattern', 2, 120)
        && d.lowVnd is int && d.lowVnd >= 0 && d.lowVnd <= 1000000000
        && d.lowDays is int && d.lowDays >= 0 && d.lowDays <= 60
        && d.emailAlerts is bool
        && d.active is bool
        && d.updatedAt == request.time
        && d.updatedBy == request.auth.uid
        && validAdMembers(d);
    }

    match /adAccounts/{actId} {
      allow read: if ownsResource() || isAdmin() || isAdMember();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(adConfigKeys())
        && validAdConfig(actId, request.resource.data);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(adConfigKeys())
        && validAdConfig(actId, request.resource.data);
      allow delete: if isAdmin();
    }

    // adReports/{actId}_{YYYY-MM} — báo cáo tháng, chỉ Apps Script ghi.
    match /adReports/{rid} {
      allow read: if ownsResource() || isAdmin() || isAdMember();
      allow write: if false;
    }

    // ======================================================================
    // adTopups/{code} — lệnh nạp ngân sách vào TKQC (khách tạo trong báo cáo quảng cáo, chủ duyệt tay).
    // code = nội dung chuyển khoản "ADSB" + 6 ký tự. amount = tiền khách chuyển (gồm phí);
    // budget = ngân sách vào TKQC = amount × 100 / (100 + feePercent). Duyệt xong Apps Script bot 3
    // cộng budget vào cột nạp của trang tính đúng ngày `day`, rồi ghi written/writtenAt/sheetTab/sheetRow
    // qua Firestore REST bằng quyền Google của chủ (không qua rules; trình duyệt không ghi được các trường đó).
    // ======================================================================

    function adTopupCfg() {
      return exists(/databases/$(database)/documents/settings/adTopup)
        ? get(/databases/$(database)/documents/settings/adTopup).data
        : {'min': 11000000, 'max': 110000000, 'feePercent': 10};
    }

    function adDay(v) {
      return v is string && v.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    function newAdTopup(code) {
      let d = request.resource.data;
      let acc = get(/databases/$(database)/documents/adAccounts/$(d.actId));
      let cfg = adTopupCfg();
      let k = 100 + cfg.feePercent;
      return signedIn()
        && d.keys().hasOnly(['uid', 'email', 'name', 'actId', 'accountLabel', 'amount', 'budget', 'feePercent', 'day', 'code', 'status', 'lang', 'createdAt'])
        && d.keys().hasAll(['uid', 'email', 'actId', 'accountLabel', 'amount', 'budget', 'feePercent', 'day', 'code', 'status', 'lang', 'createdAt'])
        && d.uid == request.auth.uid
        && d.email == myEmail()
        && optString(d, 'name', 120)
        && d.actId is string && d.actId.matches('^act_[0-9]{5,20}$')
        && (acc.data.uid == request.auth.uid
          || ('memberUids' in acc.data && request.auth.uid in acc.data.memberUids))
        && acc.data.active == true
        && reqString(d, 'accountLabel', 1, 160)
        && d.amount is int && d.amount % 1000 == 0
        && d.amount >= cfg.min && d.amount <= cfg.max
        && d.feePercent == cfg.feePercent
        && d.budget is int && d.budget > 0
        && d.budget * k >= d.amount * 100 - k
        && d.budget * k <= d.amount * 100 + k
        && adDay(d.day)
        && code.matches('^ADSB[A-HJ-NP-Z2-9]{6}$')
        && d.code == code
        && d.status == 'pending'
        && d.lang in ['vi', 'en']
        && d.createdAt == request.time;
    }

    function customerCancelsAdTopup() {
      return ownsResource()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt']);
    }

    // Duyệt (đã nhận tiền): chỉ một lần; được sửa ngày ghi vào trang tính (khách chuyển muộn).
    function adminApprovesAdTopup() {
      return isAdmin()
        && resource.data.status in ['pending', 'cancelled']
        && !('written' in resource.data)
        && request.resource.data.status == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy', 'day'])
        && adDay(request.resource.data.day)
        && request.resource.data.decidedAt == request.time
        && request.resource.data.decidedBy == request.auth.uid;
    }

    function adminRejectsAdTopup() {
      return isAdmin()
        && resource.data.status in ['pending', 'cancelled']
        && request.resource.data.status == 'rejected'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy', 'reason'])
        && request.resource.data.decidedAt == request.time
        && request.resource.data.decidedBy == request.auth.uid
        && reqString(request.resource.data, 'reason', 1, 300);
    }

    match /adTopups/{code} {
      allow read: if ownsResource() || isAdmin();
      allow create: if newAdTopup(code);
      allow update: if customerCancelsAdTopup() || adminApprovesAdTopup() || adminRejectsAdTopup();
      allow delete: if false;
    }

    // Mọi đường dẫn khác: cấm.
  }
}
